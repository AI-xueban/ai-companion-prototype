:host{display:block}.attachment-list{margin-top:14rpx}.attachment-row{display:flex;align-items:center;gap:10rpx;padding:13rpx 0;border-bottom:1rpx solid #edf2f6}.attachment-row:last-child{border-bottom:0}.attachment-main{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0;min-height:86rpx}.attachment-thumbnail,.attachment-icon{flex:none;width:76rpx;height:76rpx;border-radius:12rpx}.attachment-icon{display:flex;align-items:center;justify-content:center;background:#eaf3fc;color:#4b83b8;font-size:22rpx;font-weight:600}.attachment-icon.video{background:#f0ebfa;color:#8972b6;font-size:42rpx}.attachment-info{flex:1;min-width:0}.attachment-name{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#35516b;font-size:24rpx;font-weight:500}.attachment-meta{margin-top:7rpx;color:#93a3b1;font-size:20rpx}.attachment-remove{display:flex;align-items:center;justify-content:center;width:66rpx;min-height:80rpx;color:#9aaab7;font-size:36rpx}.attachment-arrow{color:#9aaab7;font-size:30rpx}
.attachment-icon.audio{background:#edf6ef;color:#43866a;font-size:42rpx}.attachment-audio-mask{position:fixed;inset:0;z-index:300;display:flex;align-items:flex-end;background:#1b33477a}.attachment-audio-sheet{box-sizing:border-box;width:100%;padding:32rpx 28rpx 60rpx;border-radius:36rpx 36rpx 0 0;background:#fff}.attachment-audio-title{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-bottom:30rpx;color:#35516b;font-size:29rpx;font-weight:600}.attachment-audio-title text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.attachment-audio-title text:last-child{font-size:44rpx;color:#8498a9}.attachment-audio-sheet audio{width:100%}
.attachment-icon{background:#eef2f6;color:#61758c}.attachment-icon.pdf{background:#fff0eb;color:#d85d50}.attachment-icon.word{background:#fff0e8;color:#ed795b}.attachment-icon.sheet{background:#eaf7f0;color:#329170}.attachment-icon.slides{background:#fff4e7;color:#d78a46}.attachment-icon.text{background:#ecf5fc;color:#5686aa}.attachment-icon.video{background:#f1edfb;color:#8066b7}.attachment-icon.audio{background:#e9f8f4;color:#3f9a8a}
.attachment-icon-mark{display:flex;align-items:center;justify-content:center;width:45rpx;height:54rpx;border-radius:5rpx 10rpx 5rpx 5rpx;background:#61758c;color:#fff;font-size:18rpx;font-weight:800;line-height:1}
.attachment-icon.pdf .attachment-icon-mark{background:#d85d50}.attachment-icon.word .attachment-icon-mark{background:#ed795b}.attachment-icon.sheet .attachment-icon-mark{background:#329170}.attachment-icon.slides .attachment-icon-mark{background:#d78a46}.attachment-icon.text .attachment-icon-mark{background:#5686aa}.attachment-icon.video .attachment-icon-mark{background:#8066b7}.attachment-icon.audio .attachment-icon-mark{background:#3f9a8a}
.attachment-icon.video .attachment-icon-mark,.attachment-icon.audio .attachment-icon-mark{width:52rpx;height:44rpx;border-radius:10rpx;font-size:28rpx}
