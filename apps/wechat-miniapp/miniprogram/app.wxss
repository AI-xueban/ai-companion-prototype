page {
  background: #f7f7f7;
  color: #191919;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0;
}

.page-head {
  padding: 56rpx 32rpx 40rpx;
  background: #ffffff;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.35;
}

.page-desc {
  margin-top: 12rpx;
  color: #888888;
  font-size: 28rpx;
  line-height: 1.65;
}

.section-label {
  padding: 40rpx 32rpx 16rpx;
  color: #888888;
  font-size: 24rpx;
}

.cell-list {
  background: #ffffff;
}

.cell {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #ededed;
}

.cell:last-child { border-bottom: 0; }
.cell-main { flex: 1; min-width: 0; }
.cell-title { color: #191919; font-size: 30rpx; }
.cell-desc { margin-top: 6rpx; color: #888888; font-size: 24rpx; }
.cell-extra { margin-left: 20rpx; color: #888888; font-size: 26rpx; }
.cell-arrow { margin-left: 16rpx; color: #c7c7c7; font-size: 34rpx; }

.form-input {
  flex: 1;
  height: 104rpx;
  padding: 0;
  text-align: right;
  color: #191919;
  font-size: 30rpx;
}

.form-input-placeholder { color: #c7c7c7; }

.form-error {
  padding: 12rpx 32rpx 0;
  background: #ffffff;
  color: #fa5151;
  font-size: 24rpx;
}

.page-note {
  padding: 20rpx 32rpx 0;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.6;
}

.page-actions {
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.primary-button {
  height: 96rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 96rpx;
}

.secondary-button {
  height: 96rpx;
  margin: 24rpx 0 0;
  border-radius: 8rpx;
  background: #f2f2f2;
  color: #191919;
  font-size: 34rpx;
  line-height: 96rpx;
}

.result {
  padding: 104rpx 56rpx 56rpx;
  background: #ffffff;
  text-align: center;
}

.result-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 32rpx;
  border-radius: 56rpx;
  background: #e8f8ee;
  color: #07c160;
  font-size: 64rpx;
  line-height: 112rpx;
}

.result-title { font-size: 40rpx; font-weight: 500; }
.result-desc { margin-top: 20rpx; color: #888888; font-size: 28rpx; line-height: 1.7; }
}
