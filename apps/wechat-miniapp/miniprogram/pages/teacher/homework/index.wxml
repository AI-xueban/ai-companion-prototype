<page-navigation title="{{previewOpen ? '核对发布内容' : mode === 'question' ? '单题批改结果' : mode === 'detail' ? selectedTask.title : mode === 'students' ? studentListTitle : mode === 'student' ? selectedStudentName : mode === 'compose' ? '发布任务' : mode === 'success' ? '发布成功' : '作业'}}" back="{{mode !== 'list' || previewOpen}}" home="{{mode !== 'list' || previewOpen}}" home-label="回到作业首页" bind:back="navigateBack" bind:home="returnToHomeworkHome" />
<view class="hw-page">
  <block wx:if="{{!previewOpen}}">
  <view wx:if="{{mode === 'list'}}" class="hw-head"><view class="hw-eyebrow">{{readOnly ? scopeLabel : scope.view === 'homeroom' ? '班主任' : '任课老师'}} · 演示数据{{readOnly ? ' · 只读' : ''}}</view></view>

  <view wx:if="{{mode === 'list'}}">
    <scroll-view wx:if="{{readOnly}}" scroll-x="true"><view class="hw-chip-row"><view class="hw-chip {{scope.classId === 'all' ? 'active' : ''}}" data-id="all" bindtap="changeScopeClass">全部班级</view><view wx:for="{{scopeClasses}}" wx:key="id" class="hw-chip {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeScopeClass">{{item.name}}</view></view></scroll-view>
    <view wx:if="{{readOnly}}" class="hw-stat-grid"><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.taskCount}}</view><view>已截止作业</view></view><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.completed}} / {{scopeSummary.target}}</view><view>整份完成</view></view><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.checkinCompleted}} / {{scopeSummary.checkinTarget}}</view><view>打卡完成</view></view></view><view wx:if="{{readOnly}}" class="hw-muted">进行中 {{scopeSummary.ongoing}} 期；作业与打卡分别统计。</view>
    <button wx:if="{{!readOnly}}" class="hw-primary hw-publish-entry" bindtap="startCompose">{{hasDraft ? '草稿 · 继续编辑' : '＋ 发布作业或打卡'}}</button><view wx:if="{{!readOnly && hasDraft}}" class="hw-muted">发布内容已自动保存在草稿中，尚未发送给学生。</view>
<view class="hw-list-tools"><view class="hw-list-title">任务列表 <text>{{listTaskCount}}</text></view><view class="hw-list-filter {{listSubject !== 'all' ? 'active' : ''}}" data-kind="subject" bindtap="openTaskFilter"><text>{{listSubject === 'all' ? '学科' : listSubject}}</text><text>⌄</text></view><view class="hw-list-filter {{listClassId !== 'all' ? 'active' : ''}}" data-kind="class" bindtap="openTaskFilter"><text>{{listClassLabel}}</text><text>⌄</text></view><view class="hw-list-filter {{listStatusLabel !== '状态' ? 'active' : ''}}" data-kind="status" bindtap="openTaskFilter"><text>{{listStatusLabel}}</text><text>⌄</text></view></view><view wx:if="{{!taskGroups.length}}" class="hw-muted">没有符合筛选条件的任务。<view class="hw-link" bindtap="resetTaskFilters">重置筛选</view></view>
    <block wx:for="{{taskGroups}}" wx:key="id"><view wx:if="{{item.sectionLabel}}" class="hw-section">{{item.sectionLabel}}</view><view class="hw-card {{item.isSeries ? 'hw-series-card' : ''}}">
      <view wx:if="{{item.isSeries}}" data-id="{{item.id}}" bindtap="openSeries">
      <view class="hw-list-task-title">{{item.title}}</view><view class="hw-list-task-tags"><view class="hw-badge">{{item.kindLabel}} · 连续 {{item.phaseCount}} 期</view></view>
      <view class="hw-muted">{{item.classLabel}} · {{item.ongoing ? '进行中' : '已截止'}} · 每日一交</view>
      <view wx:if="{{item.ongoing}}" class="hw-series-next">{{item.nextLabel}}</view>
      <view class="hw-card-bottom"><view>完成 {{item.completed}} / {{item.target}} 人次</view><view class="hw-rate">查看每日进度 ›</view></view>
      </view>
      <view wx:if="{{!item.isSeries}}" data-id="{{item.id}}" bindtap="openDetail"><view class="hw-list-task-title">{{item.title}}</view><view class="hw-list-task-tags"><text class="hw-list-subject">{{item.subject}}</text><view class="hw-badge">{{item.kindLabel}} · {{item.statusLabel}}</view></view><view class="hw-muted">{{item.classLabel}}</view><view wx:if="{{item.timeLabel}}" class="hw-task-times"><view>{{item.timeLabel}}</view></view><view wx:if="{{item.attentionLabel}}" class="hw-muted">{{item.attentionLabel}}</view><view class="hw-card-bottom hw-submission-summary"><view>{{item.listProgressLabel}} {{item.completed}}/{{item.target}}<text wx:if="{{item.submissionRemainder}}"> · {{item.submissionRemainder}}</text></view><view class="hw-rate">查看 ›</view></view></view>
    </view></block>
  </view>

  <view wx:elif="{{mode === 'compose'}}" class="hw-compose">
    <view class="hw-compose-toolbar"><view class="hw-stepper hw-stepper-compact"><view class="{{composeStep === 0 ? 'active' : 'done'}}">① {{draft.kind === 'checkin' ? '填写打卡' : '填写作业'}}</view><text>—</text><view class="{{composeStep === 1 ? 'active' : ''}}">② 选择班级和学生</view></view><view wx:if="{{composeStep === 0}}" class="hw-kind-toolbar"><view class="{{draft.kind === 'homework' ? 'active' : ''}}" data-kind="homework" bindtap="changeKind">作业</view><view class="{{draft.kind === 'checkin' ? 'active' : ''}}" data-kind="checkin" bindtap="changeKind">打卡</view></view></view>
    <view wx:if="{{composeStep === 0}}">
      <view class="hw-card hw-compose-card">
        <view class="hw-auto-title-row"><view class="hw-auto-title">{{draft.title}}</view><picker wx:if="{{subjectOptions.length > 1}}" mode="selector" range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="changeSubject"><view class="hw-subject-select">{{draft.subject}}⌄</view></picker></view>
        <view wx:if="{{!subjectOptions.length}}" class="hw-error">暂无可发布学科，请联系学校管理员核对任教关系。</view>
        <view wx:if="{{draft.kind === 'checkin'}}" class="hw-compact-field"><view class="hw-label">连续打卡天数（1—30 天）</view><input class="hw-input" type="number" value="{{draft.cycleCount}}" bindinput="changeCycleCount" /></view>
        <view class="hw-description-head"><view class="hw-label hw-field-label">任务描述</view><view class="hw-demo-fill" bindtap="fillDemoPaste">填入演示内容</view></view><textarea class="hw-textarea hw-paste-area" auto-height="{{true}}" maxlength="-1" placeholder="粘贴作业要求，编号自动分条" value="{{draft.description}}" bindinput="changeDescription" bindblur="recognizeDescription" />

        <view class="hw-attachment-heading"><view class="hw-label">附件<text>（选填）</text></view><view class="hw-attachment-add" bindtap="chooseMaterialAttachment">{{attachmentSaving ? '正在添加…' : '＋ 添加附件'}}</view></view>
        <task-attachments items="{{draft.attachments}}" removable="{{true}}" bind:remove="removeMaterialAttachment" />
      </view>
      <view class="hw-card hw-compose-card">
        <view class="hw-setting-head"><view class="hw-card-title">提交方式</view><view class="hw-mode-switch"><view class="{{settingMode === 'uniform' ? 'active' : ''}}" data-mode="uniform" bindtap="changeSettingMode">统一设置</view><view class="{{settingMode === 'individual' ? 'active' : ''}}" data-mode="individual" bindtap="changeSettingMode">单独设置</view></view></view>
        <view wx:if="{{recognitionStale}}" class="hw-muted">内容已修改，请核对识别结果。</view><view wx:if="{{recognitionStale && settingMode === 'individual' && (recognizedCount > 0 || draftItems.length > 1)}}" class="hw-link hw-recheck" bindtap="applyRecognition">确认重新识别</view>
        <view wx:elif="{{recognizedCount}}" class="hw-muted">已识别 {{recognizedCount}} 条要求，可逐条设置。</view><view wx:else class="hw-muted">未识别出编号时，按整段内容设置。</view>
        <view wx:if="{{settingMode === 'uniform'}}" class="hw-type-choices"><view class="hw-type-option {{uniformType === 'file' ? 'active' : ''}}" data-type="file" bindtap="selectUniformType">文件</view><view class="hw-type-option {{uniformType === 'photo' ? 'active' : ''}}" data-type="photo" bindtap="selectUniformType">图片</view><view class="hw-type-option {{uniformType === 'video' ? 'active' : ''}}" data-type="video" bindtap="selectUniformType">视频</view><view class="hw-type-option {{uniformType === 'none' ? 'active' : ''}}" data-type="none" bindtap="selectUniformType">线下完成</view></view>
        <view wx:else><view class="hw-requirement-title"><view class="hw-label">完成要求 · {{draftItems.length}} 项</view></view><view wx:for="{{draftItems}}" wx:key="id" class="hw-requirement"><view class="hw-requirement-row" data-index="{{index}}" bindtap="toggleItemOptions"><view class="hw-requirement-number">{{index + 1}}</view><view class="hw-requirement-name">{{item.title || '未填写要求'}}</view><view class="hw-requirement-selected">{{item.submitLabel}} {{expandedItemIndex === index ? '⌃' : '›'}}</view></view><view wx:if="{{expandedItemIndex === index}}"><textarea class="hw-textarea hw-item-textarea" value="{{item.title}}" data-index="{{index}}" bindinput="changeItemTitle" /><view class="hw-type-choices hw-item-types"><view class="hw-type-option {{item.submitType === 'file' ? 'active' : ''}}" data-type="file" data-index="{{index}}" bindtap="selectItemType">文件</view><view class="hw-type-option {{item.submitType === 'photo' ? 'active' : ''}}" data-type="photo" data-index="{{index}}" bindtap="selectItemType">图片</view><view class="hw-type-option {{item.submitType === 'video' ? 'active' : ''}}" data-type="video" data-index="{{index}}" bindtap="selectItemType">视频</view><view class="hw-type-option {{item.submitType === 'none' ? 'active' : ''}}" data-type="none" data-index="{{index}}" bindtap="selectItemType">线下完成</view></view><view wx:if="{{draftItems.length > 1}}" class="hw-link hw-remove-item" data-index="{{index}}" bindtap="removeItem">移除本条</view></view></view><view class="hw-add" bindtap="addItem">＋ 手动添加一项</view></view>
      </view>
      <view class="hw-card hw-compose-card"><view class="hw-card-title">截止时间</view><view class="hw-date-summary" data-target="deadline" bindtap="openDatePicker"><view>首次截止</view><view>{{deadlineDisplay}}</view><text>›</text></view><view class="hw-date-summary" data-target="submitDeadline" bindtap="openDatePicker"><view>允许补交至</view><view>{{submitDeadlineDisplay}}</view><text>›</text></view><view class="hw-muted">补交截止默认比首次截止晚 7 天，可修改。</view></view>
    </view>
    <view wx:else><view class="hw-card hw-compose-card"><view class="hw-card-title">选择任教班级<text class="hw-student-class">可多选</text></view><view wx:for="{{classes}}" wx:key="id" class="hw-class-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleClass"><view>{{item.name}}</view><view>{{item.selected ? '✓' : '○'}}</view></view></view><view class="hw-card hw-compose-card"><view class="hw-card-title">发送范围</view><view class="hw-target-option {{draft.targetMode === 'all' ? 'active' : ''}}" data-mode="all" bindtap="changeTargetMode">{{draft.targetMode === 'all' ? '◉' : '○'}} 所选班级全体</view><view class="hw-target-option {{draft.targetMode === 'selected' ? 'active' : ''}}" data-mode="selected" bindtap="changeTargetMode">{{draft.targetMode === 'selected' ? '◉' : '○'}} 跨班指定学生</view><view wx:if="{{draft.targetMode === 'selected'}}"><view class="hw-recipient-summary"><view>已选 {{recipientSelectedClassCount}} 个班 · {{draft.targetStudentIds.length}} 名学生</view><view class="hw-muted">切换下方班级可继续选人，其他班级的选择会保留。</view></view><scroll-view scroll-x enhanced class="hw-recipient-tabs"><view class="hw-recipient-tab-row"><view wx:for="{{recipientTabs}}" wx:key="id" class="hw-recipient-tab {{recipientClassId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectRecipientClass"><view>{{item.name}}</view><text>已选 {{item.selectedCount}}/{{item.total}}</text></view></view></scroll-view><view wx:for="{{studentGroups}}" wx:for-item="group" wx:key="id" class="hw-recipient-roster"><view class="hw-student-group-heading"><text>{{group.name}}</text><view class="hw-recipient-class-actions"><text data-selected="true" bindtap="selectRecipientClassAll">全选本班</text><text data-selected="false" bindtap="selectRecipientClassAll">清空本班</text></view></view><input class="hw-input" placeholder="搜索本班姓名或学号" value="{{studentSearch}}" bindinput="changeStudentSearch" /><view class="hw-muted">本班已选 {{group.selectedCount}}/{{group.total}} 人；全选与清空作用于整个班级。</view><scroll-view scroll-y class="hw-student-scroll"><view wx:for="{{group.students}}" wx:key="id" class="hw-student-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleStudent"><view>{{item.name}}<text class="hw-student-class">{{item.id}}</text></view><view>{{item.selected ? '✓' : '○'}}</view></view><view wx:if="{{!group.students.length}}" class="hw-muted">本班没有匹配的学生，已选名单保留。</view></scroll-view></view><view class="hw-target-count">预计接收 {{draft.targetStudentIds.length}} 名学生<view class="hw-muted">未选学生的班级不会收到本任务。</view></view></view><view wx:else class="hw-target-count">预计接收 {{previewTargetCount}} 名学生</view></view></view>
    <view wx:if="{{composeError}}" class="hw-error">{{composeError}}</view><button class="hw-primary hw-bottom" bindtap="nextCompose">{{composeStep === 1 ? '核对发布内容' : '下一步：选择班级和学生'}}</button>
    <view wx:if="{{datePickerOpen}}" class="hw-date-mask" bindtap="closeDatePicker"><view class="hw-date-sheet" catchtap="stopDatePickerTap"><view class="hw-date-sheet-head"><view bindtap="closeDatePicker">取消</view><view>设置{{datePickerTarget === 'deadline' ? '首次截止' : '允许补交至'}}时间</view><view class="hw-link" bindtap="confirmDatePicker">确定</view></view><view class="hw-calendar-month"><view data-delta="-1" bindtap="shiftDateMonth">‹</view><view>{{calendarTitle}}</view><view data-delta="1" bindtap="shiftDateMonth">›</view></view><view class="hw-calendar-week"><view wx:for="{{weekdays}}" wx:key="*this">{{item}}</view></view><view class="hw-calendar-grid"><view wx:for="{{calendarDays}}" wx:key="key" class="{{item.selected ? 'active' : ''}} {{item.empty ? 'empty' : ''}}" data-day="{{item.day}}" bindtap="chooseDateDay">{{item.day}}</view></view><view class="hw-picker-time"><view>时间</view><picker mode="selector" range="{{hourOptions}}" value="{{pickerHourIndex}}" bindchange="changePickerHour"><view class="hw-picker-time-cell">{{pickerHour}}　⌄</view></picker><text>:</text><picker mode="selector" range="{{minuteOptions}}" value="{{pickerMinuteIndex}}" bindchange="changePickerMinute"><view class="hw-picker-time-cell">{{pickerMinute}}　⌄</view></picker></view></view></view>
  </view>

  <view wx:elif="{{mode === 'success'}}" class="hw-success"><view class="hw-success-icon">✓</view><view class="hw-muted">{{publishedTitle}} 已发布给 {{publishedTargetCount}} 名学生</view><view class="hw-card hw-success-receipt"><view class="hw-status-row"><view>接收班级</view><view>{{publishedClasses}}</view></view><view class="hw-status-row"><view>完成项目</view><view>{{publishedItemCount}} 项</view></view><view class="hw-status-row"><view>原截止</view><view>{{publishedDeadline}}</view></view><view class="hw-status-row"><view>补交截止</view><view>{{publishedSubmitDeadline}}</view></view><view class="hw-status-row"><view>家长端通知</view><view class="hw-rate">已进入发送队列</view></view></view><view class="hw-muted">接收名单已按发布时冻结，返回列表后可查看任务统计。</view><button class="hw-primary hw-bottom" bindtap="returnToHomeworkHome">查看已发布任务</button></view>

  <view wx:elif="{{mode === 'detail'}}"><view wx:if="{{detailClassOptions.length > 2}}" class="hw-detail-classes"><view class="hw-muted">查看班级 · 共 {{detailClassOptions.length - 1}} 个班</view><scroll-view scroll-x enhanced class="hw-detail-class-scroll"><view class="hw-detail-class-options"><view wx:for="{{detailClassOptions}}" wx:key="id" class="hw-detail-class-option {{detailClassId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectDetailClass"><view>{{item.name}}</view><text>已交 {{item.completed}}/{{item.target}} 人</text></view></view></scroll-view></view>
    <view class="hw-card"><view class="hw-card-top"><view class="hw-card-title">AI 批改统计</view><view class="hw-muted">已交 {{summary.completed}}/{{summary.target}} 人</view></view><view class="hw-grade-overview"><view><view>{{summary.ratePending ? '待复核' : summary.correctness === null ? '—' : summary.correctness + '%'}}</view><text>有效题次正确率</text></view><view><view>{{summary.review}}</view><text>待复核题次</text></view><view><view>{{summary.graded}}</view><text>有效判定题次</text></view></view><view class="hw-muted">{{summary.ratePending ? '答案核对或复核尚未完成；不自动重算正确率，旧判定仅作记录。' : '统计含人工纠正，已完成结果自动同步。'}}</view></view>
    <view wx:if="{{answerRows.length}}" class="hw-card hw-answer-workflow"><view class="hw-card-title">教师参考答案</view><view class="hw-muted">老师提供，按本作业题目关联；修改不影响学生判定和统计。</view>
      <view wx:for="{{answerRows}}" wx:key="questionId" class="hw-answer-row"><view class="hw-card-top" data-id="{{item.questionId}}" bindtap="toggleAnswer"><view>{{item.label}}</view><view class="hw-link">{{item.source === 'custom' ? item.answer : item.teacherAnswer || '未提供（选填）'}} ⌄</view></view><view wx:if="{{item.open}}"><view class="hw-muted">{{item.stem}}</view><view class="hw-answer-candidates"><view><view>{{item.demoTeacherReference ? '演示预填的教师答案' : '老师提供的答案'}}：{{item.teacherAnswer || '未提供'}}</view><view class="hw-muted">{{item.teacherExplanation}}</view><button wx:if="{{canReview && item.teacherAnswer}}" data-id="{{item.questionId}}" data-source="teacher" bindtap="approveAnswer">采用教师答案</button></view><view><view>AI 参考答案：{{item.aiAnswer}}</view><view class="hw-muted">{{item.aiExplanation}}</view></view></view><view wx:if="{{canReview}}"><view class="hw-label">修改答案与解析</view><textarea value="{{item.customAnswer}}" data-index="{{index}}" data-field="customAnswer" bindinput="setCustomAnswer" placeholder="答案" /><textarea value="{{item.customExplanation}}" data-index="{{index}}" data-field="customExplanation" bindinput="setCustomAnswer" placeholder="解析" /><view class="hw-muted">保存后不自动改判、不自动更新正确率。</view><button class="hw-secondary" data-id="{{item.questionId}}" data-source="custom" bindtap="approveAnswer">保存参考答案</button></view></view></view><view wx:if="{{answerError}}" class="hw-muted">{{answerError}}</view></view>
    <view class="hw-section">逐题结果 · 点题目直接复核</view><view wx:if="{{!summary.questionRows.length}}" class="hw-card hw-muted">当前任务暂无图片批改结果。</view><view wx:for="{{summary.questionRows}}" wx:key="id" class="hw-card"><view data-id="{{item.id}}" bindtap="openGradeQuestion"><view class="hw-card-top"><view class="hw-card-title">{{item.label}}</view><view class="hw-link">查看 ›</view></view><view class="hw-muted">{{item.ratePending ? '正确率待复核' : item.wrongRate === null ? '暂无有效判定' : '错误率 ' + item.wrongRate + '%'}} · 有效判定 {{item.graded}} 人</view></view><view wx:if="{{item.review}}" class="hw-card-top hw-review-inline"><view>待复核 {{item.review}} 人</view><button wx:if="{{canReview}}" class="hw-link" data-id="{{item.id}}" bindtap="confirmReview">开始复核 ›</button></view></view>
    <view wx:if="{{summary.grading.total}}" class="hw-grade-status"><view>{{summary.grading.title}}</view><view class="hw-muted">已完成结果自动同步，待处理题目单独保留。</view></view>
    <view class="hw-card"><view class="hw-card-top" bindtap="toggleTaskDescription"><view>作业要求与提交进度</view><view>{{descriptionOpen ? '−' : '＋'}}</view></view><view wx:if="{{descriptionOpen}}"><view class="hw-muted">{{selectedTask.description}}</view><task-attachments items="{{selectedTask.attachments}}" /><view class="hw-muted">截止 {{selectedTask.deadline}} · 补交至 {{selectedTask.submitDeadline}}</view><view class="hw-muted">接收对象 {{detailClassLabel}} · {{summary.target}} 人</view><button class="hw-secondary" data-filter="all" bindtap="openStudentList">查看提交名单</button></view></view>
  </view>

  <view wx:elif="{{mode === 'question'}}"><view wx:if="{{detailClassOptions.length > 2}}" class="hw-detail-classes"><view class="hw-muted">查看班级 · 共 {{detailClassOptions.length - 1}} 个班</view><scroll-view scroll-x enhanced class="hw-detail-class-scroll"><view class="hw-detail-class-options"><view wx:for="{{detailClassOptions}}" wx:key="id" class="hw-detail-class-option {{detailClassId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectDetailClass"><view>{{item.name}}</view><text>已交 {{item.completed}}/{{item.target}} 人</text></view></view></scroll-view></view><view class="hw-card"><view class="hw-card-title">{{selectedGradeQuestion.label}}</view><view wx:if="{{questionPhoto}}"><view class="hw-card-top"><view class="hw-card-title">题目原图{{questionPhoto.region ? '截取' : ''}}</view><view class="hw-link" data-path="{{questionPhoto.path}}" bindtap="previewOriginal">查看整页 ›</view></view><view class="hw-muted">来自 {{questionPhoto.source}}</view><view wx:if="{{questionPhoto.region}}" class="hw-question-photo-crop" style="height:{{questionPhotoHeight}}rpx" data-path="{{questionPhoto.path}}" bindtap="previewOriginal"><image src="{{questionPhoto.path}}" mode="scaleToFill" style="{{questionPhoto.style}}" data-path="{{questionPhoto.path}}" bindload="loadQuestionPhoto" /></view><image wx:else class="hw-material-image" src="{{questionPhoto.path}}" mode="widthFix" data-path="{{questionPhoto.path}}" bindtap="previewOriginal" /><view wx:if="{{!questionPhoto.region}}" class="hw-muted">题目区域尚未定位，暂展示整页原图。</view></view><view wx:elif="{{!readOnly}}" class="hw-muted">题目原照片暂不可用，先查看识别文字。</view><view class="hw-question-recognition" bindtap="toggleQuestionText">识别文字（供参考） {{questionTextOpen ? '⌃' : '⌄'}}</view><view wx:if="{{questionTextOpen}}" class="hw-grade-stem">{{selectedGradeQuestion.stem || '题目内容暂未识别，请查看原照片。'}}</view><view class="hw-grade-wrong">错误 {{gradeQuestionStats.wrong}} 人 · 错误率 {{gradeQuestionStats.ratePending ? '待复核' : gradeQuestionStats.wrongRate === null ? '—' : gradeQuestionStats.wrongRate + '%'}}</view><view class="hw-muted">答对 {{gradeQuestionStats.correct}} 人 · 有效批改 {{gradeQuestionStats.graded}} 人</view><view class="hw-muted">待批改 {{gradeQuestionStats.pending}} · 待复核 {{gradeQuestionStats.review}} · 识别不清 {{gradeQuestionStats.unreadable}} · 无答案 {{gradeQuestionStats.noAnswer}}</view><view wx:if="{{!gradeQuestionSections.length}}" class="hw-muted">暂无有效批改结果，请稍后查看。</view><view wx:for="{{gradeQuestionSections}}" wx:key="title" class="hw-grade-explanation"><view class="hw-card-top" data-index="{{index}}" bindtap="toggleGradeSection"><view>{{item.title}}</view><view>{{item.open ? '−' : '＋'}}</view></view><view wx:if="{{item.open}}" class="hw-muted">{{item.text}}</view></view></view><view wx:if="{{gradeQuestionStats.review && canReview}}" class="hw-card"><view>待教师复核 {{gradeQuestionStats.review}} 人</view><view class="hw-muted">对照学生原图与 AI 结果，再作判定。保存后自动同步家长。</view><button class="hw-primary" data-id="{{gradeQuestionId}}" bindtap="confirmReview">开始复核</button></view><view class="hw-section">学生作答 · 点击查看整份作业</view><view class="hw-grade-filters"><view class="{{gradeFilter === 'wrong' ? 'active' : ''}}" data-filter="wrong" bindtap="filterGradeStudents">答错</view><view class="{{gradeFilter === 'correct' ? 'active' : ''}}" data-filter="correct" bindtap="filterGradeStudents">答对</view><view class="{{gradeFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bindtap="filterGradeStudents">待处理</view><view class="{{gradeFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="filterGradeStudents">全部</view></view><view wx:for="{{gradeStudents}}" wx:key="id" class="hw-card" data-id="{{item.id}}" bindtap="openWholeGrade"><view class="hw-card-top"><view>{{item.name}}</view><view>{{item.result}} ›</view></view><view class="hw-muted">查看该学生整份作业原图与结果</view><button wx:if="{{canReview}}" class="hw-secondary" data-id="{{gradeQuestionId}}" data-student="{{item.id}}" catchtap="confirmReview">对照原图纠正</button></view><view wx:if="{{!gradeStudents.length}}" class="hw-card hw-muted">该状态暂无学生。</view></view>
  <view wx:elif="{{mode === 'students'}}">
    <view class="hw-intro">{{selectedTask.title}} · {{studentRows.length}} 人。{{readOnly ? '点击学生查看提交状态和逐题结果；原始媒体不在此页面展示。' : '点击学生查看每项提交、原件和提交时间。'}}</view>
    <view wx:if="{{!studentRows.length}}" class="hw-card hw-muted">该范围暂无学生。</view>
    <view wx:for="{{studentRows}}" wx:key="id" class="hw-card hw-tappable" data-id="{{item.id}}" bindtap="openStudent">
      <view class="hw-card-top"><view class="hw-card-title">{{item.name}}</view><view class="hw-badge">{{item.statusLabel}}</view></view>
      <view class="hw-muted">{{item.className}} · 做错 {{item.wrongCount}} 题</view>
      <view class="hw-card-bottom"><view>已交 {{item.progress}} · {{item.latestSubmittedAt}}</view><view class="hw-rate">查看 ›</view></view>
    </view>
  </view>

  <view wx:elif="{{mode === 'student'}}">
    <view class="hw-card"><view class="hw-muted">{{selectedStudentMeta}}</view></view>
    <view class="hw-section">{{readOnly ? '逐项提交与结果' : '逐项提交原件'}}</view>
    <view wx:if="{{readOnly}}" class="hw-intro">学校管理工作台仅展示提交状态和逐题结果，不展示原始图片、视频和录音。</view>
    <button class="hw-primary" data-id="{{selectedStudentId}}" bindtap="openWholeGrade">查看整份批改结果 ›</button>
    <view wx:for="{{studentItems}}" wx:key="id" class="hw-card">
      <view class="hw-card-top"><view class="hw-card-title">{{index + 1}}. {{item.title}}</view><view class="hw-badge">{{item.submitLabel}}</view></view>
      <view wx:if="{{!item.submitted}}" class="hw-muted">{{readOnly ? '未提交 · 无提交时间' : '未提交 · 无原件和提交时间'}}</view>
      <view wx:else>
        <view class="hw-muted">提交时间：{{item.submittedAt}} · 第 {{item.version}} 版 · {{item.late ? '补交' : '按时提交'}}</view><view class="hw-muted">操作账号：{{item.operatorLabel}}</view><view wx:if="{{!readOnly}}" class="hw-muted">文件：{{item.mediaLabel}}</view>
        <view wx:if="{{!readOnly && item.isMock}}" class="hw-muted">演示数据 · 图片为模拟样张</view>
        <image wx:if="{{!readOnly && item.isPhoto && item.mediaPath}}" class="hw-original-image" src="{{item.mediaPath}}" mode="widthFix" data-path="{{item.mediaPath}}" bindtap="previewOriginal" />
        <video wx:if="{{!readOnly && item.isVideo && item.mediaPath}}" class="hw-original-video" src="{{item.mediaPath}}" controls />
        <view wx:if="{{!readOnly && item.isVideo && !item.mediaPath}}" class="hw-video-placeholder">演示视频记录：暂无真实视频文件。家长选择视频提交后可在此播放。</view>
        <view wx:for="{{item.questions}}" wx:for-item="question" wx:key="id" class="hw-question-row"><view>{{question.label}} · {{question.result}}</view><view>学生作答 {{question.studentAnswer}} · 正确答案 {{question.answer}}</view><view wx:if="{{question.reviewCount}}">教师改判 {{question.reviewCount}} 次</view><view wx:for="{{question.reviewHistory}}" wx:for-item="history" wx:key="at" class="hw-audit-row"><view>{{history.at}} · {{history.result}}</view><view>操作教师：{{history.reviewer}}</view><view>原因：{{history.reason}}</view></view></view>
      </view>
    </view>
  </view>

  <view wx:if="{{mode === 'list'}}" class="hw-business-nav"><view bindtap="openLearning">学情</view><view class="active">作业</view></view>
  </block><view wx:if="{{previewOpen}}" class="hw-review-page"><view class="hw-review-content"><view class="hw-review-section"><view class="hw-label">{{draft.title}} · {{draft.kind === 'checkin' ? '打卡' : '作业'}}</view><view class="hw-muted">{{draft.description}}</view><task-attachments items="{{draft.attachments}}" /><view class="hw-muted">首次截止 {{draft.deadline}}</view><view class="hw-muted">允许补交至 {{draft.submitDeadline}}</view><view wx:if="{{draft.kind === 'checkin'}}" class="hw-muted">共 {{draft.cycleCount}} 期，每天一期</view></view><view class="hw-review-section"><view class="hw-label">完成项目 · {{previewItems.length}} 项</view><view wx:for="{{previewItems}}" wx:key="id" class="hw-review-item"><view>{{index + 1}}. {{item.title}}</view><view class="hw-muted">{{item.instruction}} · {{item.type}}</view></view></view><view class="hw-review-section"><view class="hw-label">接收对象 · {{previewTargetCount}} 人</view><view class="hw-muted">{{previewClasses}} · {{previewStudents}}</view></view><view class="hw-muted">家长仅能查看自己孩子的提交内容。</view><view class="hw-review-actions"><button class="hw-primary" disabled="{{publishing}}" bindtap="confirmPublish">{{publishing ? '发布中…' : '确认发布'}}</button></view></view></view>
</view>

<view wx:if="{{taskFilterSheet}}" class="hw-filter-mask" bindtap="closeTaskFilter"><view class="hw-filter-sheet" catchtap="stopDatePickerTap"><view class="hw-filter-heading"><view>{{taskFilterTitle}}</view><view bindtap="closeTaskFilter">×</view></view><block wx:if="{{taskFilterSheet === 'status'}}"><view class="hw-muted">支持多选；同组任一匹配，跨组同时满足。未选的分组不限。</view><view class="hw-filter-all {{taskStatusAll ? 'active' : ''}}" bindtap="toggleAllTaskStatuses">{{taskStatusAll ? '☑' : '□'}} 全选</view><view wx:for="{{taskStatusGroups}}" wx:key="id" wx:for-item="group"><view class="hw-filter-label">{{group.label}}</view><view class="hw-filter-grid"><view wx:for="{{group.options}}" wx:key="id" class="{{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleTaskStatus">{{item.selected ? '✓ ' : ''}}{{item.label}}</view></view></view><view wx:if="{{taskFilterError}}" class="hw-error">{{taskFilterError}}</view><view class="hw-filter-footer"><button bindtap="resetTaskStatusDraft">重置为全部</button><button class="hw-primary" bindtap="confirmTaskStatuses">确定</button></view></block><block wx:else><view wx:for="{{taskFilterOptions}}" wx:key="id" class="hw-filter-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTaskFilter"><text>{{item.label}}</text><text>{{item.selected ? '✓' : ''}}</text></view></block></view></view>

<view wx:if="{{reviewDraft}}" class="hw-compare-mask"><view class="hw-compare-sheet"><view class="hw-compare-heading"><view><view class="hw-card-title">对照原图复核</view><view class="hw-muted">{{reviewDraft.studentName}} · {{reviewDraft.className}} · 第 {{reviewDraft.version}} 版</view></view><view bindtap="closeReview">×</view></view><scroll-view scroll-y class="hw-compare-scroll"><view class="hw-card-title">{{reviewDraft.label}}</view><view wx:if="{{reviewDraft.path}}"><view wx:if="{{reviewDraft.region}}" class="hw-question-photo-crop" style="height:{{reviewPhotoHeight}}rpx" data-path="{{reviewDraft.path}}" bindtap="previewOriginal"><image src="{{reviewDraft.path}}" style="{{reviewDraft.style}}" mode="scaleToFill" data-path="{{reviewDraft.path}}" bindload="loadReviewPhoto" /></view><image wx:else class="hw-material-image" src="{{reviewDraft.path}}" mode="widthFix" data-path="{{reviewDraft.path}}" bindtap="previewOriginal" /></view><view wx:else class="hw-muted">原图暂不可用，请保留待复核后稍后处理。</view><view wx:if="{{reviewDraft.mock}}" class="hw-muted">共用作业样张 · 仅用于演示</view><view class="hw-compare-ai"><view class="hw-card-title">本次 AI 批改结果</view><view>AI 原始判定：{{reviewDraft.aiCorrect === null ? '原判未留存' : reviewDraft.aiCorrect ? '正确' : '错误'}}</view><view class="hw-muted">AI 参考答案：{{reviewDraft.aiAnswer}}</view><view class="hw-review-current">教师参考答案：{{reviewDraft.referenceAnswer}}</view><view class="hw-muted">本次 AI 解析：{{reviewDraft.explanation}}</view></view><view class="hw-label">复核说明</view><textarea value="{{reviewDraft.reason}}" bindinput="setReviewReason" placeholder="例如：已核对原图，作答正确" /><view wx:if="{{reviewDraft.error}}" class="hw-error">{{reviewDraft.error}}</view></scroll-view><view class="hw-compare-footer"><view class="hw-compare-decisions"><button class="{{reviewDraft.correct === 'true' ? 'active' : ''}}" data-value="true" bindtap="setReviewDecision">✓ 判对</button><button class="{{reviewDraft.correct === 'false' ? 'active' : ''}}" data-value="false" bindtap="setReviewDecision">× 判错</button><button bindtap="holdReview">暂缓本题</button></view><view class="hw-review-save"><button class="hw-secondary" bindtap="saveReview">保存返回</button><button class="hw-primary" data-next="true" bindtap="saveReview">保存并下一位</button></view><view class="hw-muted">保存即更新统计与家长结果。</view></view></view></view>
