<view class="hw-page">
  <view class="hw-head"><view><view class="hw-eyebrow">{{scopeLabel}} · 演示数据{{readOnly ? ' · 只读' : ''}}</view><view wx:if="{{mode !== 'list' && mode !== 'compose'}}" class="hw-title">{{mode === 'detail' ? '作业统计' : mode === 'students' ? studentListTitle : selectedStudentName}}</view></view><view wx:if="{{mode === 'student'}}" class="hw-back" bindtap="backToStudents">返回名单</view><view wx:elif="{{mode === 'students'}}" class="hw-back" bindtap="backToStats">返回统计</view><view wx:elif="{{mode !== 'list'}}" class="hw-back" bindtap="backToList">{{fromSeries ? '返回每日进度' : '返回列表'}}</view></view>

  <view wx:if="{{mode === 'list'}}">
    <scroll-view wx:if="{{readOnly}}" scroll-x="true"><view class="hw-chip-row"><view class="hw-chip {{scope.classId === 'all' ? 'active' : ''}}" data-id="all" bindtap="changeScopeClass">全部班级</view><view wx:for="{{scopeClasses}}" wx:key="id" class="hw-chip {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeScopeClass">{{item.name}}</view></view></scroll-view>
    <view wx:if="{{readOnly}}" class="hw-stat-grid"><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.taskCount}}</view><view>已截止作业</view></view><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.completed}} / {{scopeSummary.target}}</view><view>整份完成</view></view><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.checkinCompleted}} / {{scopeSummary.checkinTarget}}</view><view>打卡完成</view></view></view><view wx:if="{{readOnly}}" class="hw-muted">进行中 {{scopeSummary.ongoing}} 期；作业与打卡分别统计。</view>
    <button wx:if="{{!readOnly}}" class="hw-primary" bindtap="startCompose">＋ 发布作业或打卡</button>
    <view class="hw-section">{{readOnly ? '范围内任务 · 点击查看' : '已发布任务'}}</view>
    <view wx:for="{{taskGroups}}" wx:key="id" class="hw-card {{item.isSeries ? 'hw-series-card' : ''}}">
      <view wx:if="{{item.isSeries}}" data-id="{{item.id}}" bindtap="openSeries">
      <view class="hw-card-top"><view class="hw-card-title">{{item.title}}</view><view class="hw-badge">连续 {{item.phaseCount}} 期</view></view>
      <view class="hw-muted">{{item.classLabel}} · {{item.dateRange}} · 每日一交</view>
      <view class="hw-series-next">{{item.nextLabel}}</view>
      <view class="hw-card-bottom"><view>完成 {{item.completed}} / {{item.target}} 人次</view><view class="hw-rate">查看每日进度 ›</view></view>
      </view>
      <view wx:if="{{!item.isSeries}}" data-id="{{item.id}}" bindtap="openDetail"><view class="hw-card-top"><view class="hw-card-title">{{item.title}}</view><view class="hw-badge">{{item.kindLabel}}</view></view><view class="hw-muted">{{item.classLabel}} · 截止 {{item.deadline}} · {{item.ongoing ? '进行中' : '已截止'}}</view><view class="hw-card-bottom"><view>完成 {{item.completed}} / {{item.target}}</view><view class="hw-rate">{{item.completionRate}}% ›</view></view></view>
    </view>
  </view>

  <view wx:elif="{{mode === 'compose'}}">
    <view class="hw-stepper"><view class="{{composeStep === 0 ? 'active' : ''}}">1 填写内容与设置</view><view class="{{composeStep === 1 ? 'active' : ''}}">2 布置对象</view></view>
    <view wx:if="{{composeStep === 0}}">
    <view class="hw-section">这次要布置什么？</view>
    <view class="hw-card">
      <view class="hw-kind-row"><view class="hw-kind {{draft.kind === 'homework' ? 'active' : ''}}" data-kind="homework" bindtap="changeKind">作业</view><view class="hw-kind {{draft.kind === 'checkin' ? 'active' : ''}}" data-kind="checkin" bindtap="changeKind">打卡</view></view>
      <view class="hw-label hw-field-label">学科</view><picker mode="selector" range="{{subjectOptions}}" bindchange="changeSubject"><view class="hw-date-cell">{{draft.subject}}　⌄</view></picker>
      <view wx:if="{{draft.kind === 'checkin'}}"><view class="hw-label hw-field-label">连续打卡天数（1—30 天）</view><input class="hw-input" type="number" value="{{draft.cycleCount}}" bindinput="changeCycleCount" /><view class="hw-muted">从首次截止日开始，每天生成一期，逐期统计。</view></view>
      <view class="hw-label">名称</view><input class="hw-input" placeholder="例如：数学周末练习" value="{{draft.title}}" bindinput="changeTitle" />
      <view class="hw-description-head"><view class="hw-label hw-field-label">任务描述</view><view class="hw-demo-fill" bindtap="fillDemoPaste">填入示例 · 看识别效果</view></view><textarea class="hw-textarea hw-paste-area" placeholder="直接粘贴整段作业要求，支持 1.、1、① 等编号" value="{{draft.description}}" bindinput="changeDescription" bindblur="recognizeDescription" />
      <view class="hw-material-row"><view class="hw-muted">题目或说明图片（选填）</view><view class="hw-link" bindtap="chooseMaterialPhoto">{{draft.materialPhoto ? '更换图片' : '添加图片'}}</view></view>
      <view wx:if="{{draft.materialPhoto}}" class="hw-material-preview"><image src="{{draft.materialPhoto}}" mode="aspectFill" bindtap="previewMaterialPhoto" /><view class="hw-link" bindtap="removeMaterialPhoto">移除</view></view>
      <view class="hw-muted">整段复制粘贴即可，编号会自动拆分为提交条目。</view><view wx:if="{{demoPasteActive}}" class="hw-demo-result">演示已填入：完整原文已保留，系统自动识别 4 条要求；下面可逐条选择提交方式。</view>
      <view class="hw-label hw-field-label">提交方式</view>
      <view class="hw-kind-row"><view class="hw-kind {{settingMode === 'uniform' ? 'active' : ''}}" data-mode="uniform" bindtap="changeSettingMode">统一设置</view><view class="hw-kind {{settingMode === 'individual' ? 'active' : ''}}" data-mode="individual" bindtap="changeSettingMode">按条设置</view></view>
      <view wx:if="{{recognitionStale}}" class="hw-muted">内容有改动。逐条设置时请确认重新识别，避免覆盖原有设置。</view><view wx:if="{{recognitionStale && settingMode === 'individual' && (recognizedCount > 0 || draftItems.length > 1)}}" class="hw-link hw-recheck" bindtap="applyRecognition">确认重新识别</view>
      <view wx:if="{{recognizedCount}}" class="hw-muted">已自动识别 {{recognizedCount}} 条作业</view>
      <view wx:else class="hw-muted">未发现连续编号时，按整段内容作为一项。</view>
      <view wx:if="{{settingMode === 'uniform'}}" class="hw-uniform-block"><view class="hw-label">所有要求</view><view class="hw-type-choices"><view class="hw-type-option {{uniformType === 'photo' ? 'active' : ''}}" data-type="photo" bindtap="selectUniformType">图片</view><view class="hw-type-option {{uniformType === 'video' ? 'active' : ''}}" data-type="video" bindtap="selectUniformType">视频</view><view class="hw-type-option {{uniformType === 'audio' ? 'active' : ''}}" data-type="audio" bindtap="selectUniformType">录音</view><view class="hw-type-option {{uniformType === 'none' ? 'active' : ''}}" data-type="none" bindtap="selectUniformType">无需线上提交</view></view></view>
      <view wx:else><view wx:for="{{draftItems}}" wx:key="id" class="hw-recognized-item"><view class="hw-card-top"><view class="hw-card-title">第 {{index + 1}} 条</view><view wx:if="{{draftItems.length > 1}}" class="hw-link" data-index="{{index}}" bindtap="removeItem">移除</view></view><textarea class="hw-textarea hw-item-textarea" value="{{item.title}}" data-index="{{index}}" bindinput="changeItemTitle" /><view class="hw-type-choices"><view class="hw-type-option {{item.submitType === 'photo' ? 'active' : ''}}" data-type="photo" data-index="{{index}}" bindtap="selectItemType">图片</view><view class="hw-type-option {{item.submitType === 'video' ? 'active' : ''}}" data-type="video" data-index="{{index}}" bindtap="selectItemType">视频</view><view class="hw-type-option {{item.submitType === 'audio' ? 'active' : ''}}" data-type="audio" data-index="{{index}}" bindtap="selectItemType">录音</view><view class="hw-type-option {{item.submitType === 'none' ? 'active' : ''}}" data-type="none" data-index="{{index}}" bindtap="selectItemType">无需线上提交</view></view></view><view class="hw-add" bindtap="addItem">＋ 手动添加一项</view></view>
      <view class="hw-label hw-field-label">原截止时间</view><view class="hw-date-row"><picker mode="date" value="{{deadlineDate}}" bindchange="changeDeadlineDate"><view class="hw-date-cell">{{deadlineDate}}　⌄</view></picker><picker mode="time" value="{{deadlineTime}}" bindchange="changeDeadlineTime"><view class="hw-date-cell">{{deadlineTime}}　⌄</view></picker></view>
      <view class="hw-label hw-field-label">允许补交至</view><view class="hw-date-row"><picker mode="date" value="{{submitDeadlineDate}}" bindchange="changeSubmitDeadlineDate"><view class="hw-date-cell">{{submitDeadlineDate}}　⌄</view></picker><picker mode="time" value="{{submitDeadlineTime}}" bindchange="changeSubmitDeadlineTime"><view class="hw-date-cell">{{submitDeadlineTime}}　⌄</view></picker></view><view class="hw-muted">默认原截止后 7 天；补交期结束后任务只读。布置说明和照片至少填写一项。</view>
    </view>
    </view>
    <view wx:else>
    <view class="hw-section">布置给谁？</view>
    <view class="hw-card"><view class="hw-label">选择一个或多个任教班级</view><view class="hw-chip-row"><view wx:for="{{classes}}" wx:key="id" class="hw-chip {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleClass">{{item.name}}</view></view><view class="hw-kind-row"><view class="hw-kind {{draft.targetMode === 'all' ? 'active' : ''}}" data-mode="all" bindtap="changeTargetMode">所选班级全体</view><view class="hw-kind {{draft.targetMode === 'selected' ? 'active' : ''}}" data-mode="selected" bindtap="changeTargetMode">指定学生</view></view><view wx:if="{{draft.targetMode === 'selected'}}"><view class="hw-muted">已选 {{draft.targetStudentIds.length}} 人，可搜索姓名或学号。</view><input class="hw-input" placeholder="搜索学生" value="{{studentSearch}}" bindinput="changeStudentSearch" /><scroll-view scroll-y="true" class="hw-student-scroll"><view wx:for="{{studentOptions}}" wx:key="id" class="hw-student-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleStudent"><view>{{item.name}}<text class="hw-student-class">{{item.className}}</text></view><view>{{item.selected ? '✓' : '○'}}</view></view></scroll-view></view><view wx:else class="hw-muted">将发给所选班级的全体学生。</view></view>
    <view class="hw-muted">家长仅能查看自己孩子的提交内容。</view>
    </view>
    <view wx:if="{{composeError}}" class="hw-error">{{composeError}}</view><view wx:if="{{composeStep === 1}}" class="hw-link hw-compose-back" bindtap="backCompose">‹ 返回填写</view>
    <button class="hw-primary hw-bottom" bindtap="nextCompose">{{composeStep === 1 ? '核对并发布' : '下一步：布置对象'}}</button>
  </view>

  <view wx:elif="{{mode === 'success'}}" class="hw-success"><view class="hw-success-back" bindtap="returnToHomeworkHome">‹ 返回作业首页</view><view class="hw-success-icon">✓</view><view class="hw-success-title">发布成功</view><view class="hw-muted">{{publishedTitle}} 已发布给 {{publishedTargetCount}} 名学生</view><view class="hw-card hw-success-receipt"><view class="hw-status-row"><view>接收班级</view><view>{{publishedClasses}}</view></view><view class="hw-status-row"><view>完成项目</view><view>{{publishedItemCount}} 项</view></view><view class="hw-status-row"><view>原截止</view><view>{{publishedDeadline}}</view></view><view class="hw-status-row"><view>补交截止</view><view>{{publishedSubmitDeadline}}</view></view><view class="hw-status-row"><view>家长端通知</view><view class="hw-rate">已进入发送队列</view></view></view><view class="hw-muted">接收名单已按发布时冻结，返回列表后可查看任务统计。</view><button class="hw-primary hw-bottom" bindtap="returnToHomeworkHome">查看已发布任务</button></view>

  <view wx:elif="{{mode === 'detail'}}">
    <view class="hw-card"><view class="hw-card-top"><view class="hw-card-title">{{selectedTask.title}}</view><view class="hw-badge">{{selectedTask.kind === 'checkin' ? '打卡' : '作业'}}</view></view><view class="hw-muted">原截止 {{selectedTask.deadline}} · 补交至 {{selectedTask.submitDeadline}}</view><view class="hw-muted">{{selectedTask.description}}</view><image wx:if="{{selectedTask.materialPhoto}}" class="hw-material-image" src="{{selectedTask.materialPhoto}}" mode="widthFix" /><view class="hw-muted">家长仅能查看自己孩子的提交内容。</view></view>
    <view class="hw-stat-grid"><view class="hw-stat"><view class="hw-stat-num">{{summary.completionRate}}%</view><view>整份完成率</view><view class="hw-muted">{{summary.completed}} / {{summary.target}}</view></view><view class="hw-stat"><view class="hw-stat-num">{{summary.graded}}</view><view>有效批改题次</view><view class="hw-muted">待复核 {{summary.review}}</view></view><view class="hw-stat"><view class="hw-stat-num">{{summary.graded ? summary.correctness + '%' : '—'}}</view><view>有效题次正确率</view><view class="hw-muted">{{summary.correct}} / {{summary.graded}}</view></view></view>
    <view class="hw-section">提交状态 · 点击查看学生</view><view class="hw-card"><view class="hw-status-row hw-tappable" data-filter="completed" bindtap="openStudentList"><view>已完成</view><view>{{summary.completed}} 人 ›</view></view><view class="hw-status-row hw-tappable" data-filter="partial" bindtap="openStudentList"><view>部分提交</view><view>{{summary.partial}} 人 ›</view></view><view class="hw-status-row hw-tappable" data-filter="missing" bindtap="openStudentList"><view>未提交</view><view>{{summary.missing}} 人 ›</view></view><view class="hw-status-row hw-tappable" data-filter="wrong" bindtap="openStudentList"><view>做错学生</view><view>{{wrongCount}} 人 ›</view></view></view>
    <view class="hw-section">逐题结果 · 外接批改模拟</view><view wx:if="{{!summary.questionRows.length}}" class="hw-card hw-muted">当前任务没有可判分图片题，仍可统计完成情况。</view><view wx:for="{{summary.questionRows}}" wx:key="id" class="hw-card"><view class="hw-card-top"><view class="hw-card-title">{{item.label}}</view><view class="hw-rate">{{item.graded ? item.rate + '%' : '待批改'}}</view></view><view class="hw-muted">正确答案：{{item.answer}}</view><view class="hw-muted">有效批改 {{item.graded}} 人 · 答对 {{item.correct}} 人 · 待复核 {{item.review}} 题次</view><view class="hw-link hw-review" data-filter="questionWrong" data-question="{{item.id}}" bindtap="openStudentList">查看本题做错学生 ›</view><view wx:if="{{item.review && canReview}}"><view class="hw-link hw-review" data-id="{{item.id}}" data-correct="true" bindtap="confirmReview">模拟改判：正确 ›</view><view class="hw-link hw-review" data-id="{{item.id}}" data-correct="false" bindtap="confirmReview">模拟改判：错误 ›</view></view></view><view class="hw-footnote">识别不清 {{summary.unreadable}}、无答案 {{summary.noAnswer}}、待复核 {{summary.review}} 题次不计入正式正确率。原型只模拟后端批改返回。</view>
  </view>

  <view wx:elif="{{mode === 'students'}}">
    <view class="hw-intro">{{selectedTask.title}} · {{studentRows.length}} 人。{{readOnly ? '点击学生查看提交状态和逐题结果；原始媒体不在此页面展示。' : '点击学生查看每项提交、原件和提交时间。'}}</view>
    <view wx:if="{{!studentRows.length}}" class="hw-card hw-muted">该范围暂无学生。</view>
    <view wx:for="{{studentRows}}" wx:key="id" class="hw-card hw-tappable" data-id="{{item.id}}" bindtap="openStudent">
      <view class="hw-card-top"><view class="hw-card-title">{{item.name}}</view><view class="hw-badge">{{item.statusLabel}}</view></view>
      <view class="hw-muted">{{item.className}} · 做错 {{item.wrongCount}} 题</view>
      <view class="hw-card-bottom"><view>已交 {{item.progress}} · {{item.latestSubmittedAt}}</view><view class="hw-rate">查看 ›</view></view>
    </view>
  </view>

  <view wx:elif="{{mode === 'student'}}">
    <view class="hw-card"><view class="hw-card-title">{{selectedStudentName}}</view><view class="hw-muted">{{selectedStudentMeta}}</view></view>
    <view class="hw-section">{{readOnly ? '逐项提交与结果' : '逐项提交原件'}}</view>
    <view wx:if="{{readOnly}}" class="hw-intro">学校管理工作台仅展示提交状态和逐题结果，不展示原始图片、视频和录音。</view>
    <view wx:for="{{studentItems}}" wx:key="id" class="hw-card">
      <view class="hw-card-top"><view class="hw-card-title">{{index + 1}}. {{item.title}}</view><view class="hw-badge">{{item.submitLabel}}</view></view>
      <view wx:if="{{!item.submitted}}" class="hw-muted">{{readOnly ? '未提交 · 无提交时间' : '未提交 · 无原件和提交时间'}}</view>
      <view wx:else>
        <view class="hw-muted">提交时间：{{item.submittedAt}} · 第 {{item.version}} 版 · {{item.late ? '补交' : '按时提交'}}</view><view class="hw-muted">操作账号：{{item.operatorLabel}}</view><view wx:if="{{!readOnly}}" class="hw-muted">文件：{{item.mediaLabel}}</view>
        <view wx:if="{{!readOnly && item.isMock}}" class="hw-muted">演示数据 · 图片为模拟样张</view>
        <image wx:if="{{!readOnly && item.isPhoto && item.mediaPath}}" class="hw-original-image" src="{{item.mediaPath}}" mode="widthFix" data-path="{{item.mediaPath}}" bindtap="previewOriginal" />
        <video wx:if="{{!readOnly && item.isVideo && item.mediaPath}}" class="hw-original-video" src="{{item.mediaPath}}" controls />
        <view wx:if="{{!readOnly && item.isVideo && !item.mediaPath}}" class="hw-video-placeholder">演示视频记录：暂无真实视频文件。家长选择视频提交后可在此播放。</view>
        <view wx:for="{{item.questions}}" wx:for-item="question" wx:key="id" class="hw-question-row"><view>{{question.label}} · {{question.result}}</view><view>学生作答 {{question.studentAnswer}} · 正确答案 {{question.answer}}</view><view wx:if="{{question.reviewCount}}">教师改判 {{question.reviewCount}} 次</view><view wx:for="{{question.reviewHistory}}" wx:for-item="history" wx:key="at" class="hw-audit-row"><view>{{history.at}} · {{history.result}}</view><view>操作教师：{{history.reviewer}}</view><view>原因：{{history.reason}}</view></view></view>
      </view>
    </view>
  </view>

  <view wx:if="{{mode === 'list'}}" class="hw-business-nav"><view bindtap="openLearning">学情</view><view class="active">作业</view></view>
  <view wx:if="{{previewOpen}}" class="hw-mask"><scroll-view scroll-y="true" class="hw-dialog"><view class="hw-card-title">核对发布内容</view><view class="hw-review-section"><view class="hw-label">{{draft.title}} · {{draft.kind === 'checkin' ? '打卡' : '作业'}}</view><view class="hw-muted">{{draft.description}}</view><image wx:if="{{draft.materialPhoto}}" class="hw-material-image" src="{{draft.materialPhoto}}" mode="widthFix" /><view class="hw-muted">首次截止 {{draft.deadline}}</view><view class="hw-muted">允许补交至 {{draft.submitDeadline}}</view><view wx:if="{{draft.kind === 'checkin'}}" class="hw-muted">共 {{draft.cycleCount}} 期，每天一期</view></view><view class="hw-review-section"><view class="hw-label">完成项目 · {{previewItems.length}} 项</view><view wx:for="{{previewItems}}" wx:key="id" class="hw-review-item"><view>{{index + 1}}. {{item.title}}</view><view class="hw-muted">{{item.instruction}} · {{item.type}}</view></view></view><view class="hw-review-section"><view class="hw-label">接收对象 · {{previewTargetCount}} 人</view><view class="hw-muted">{{previewClasses}} · {{previewStudents}}</view></view><view class="hw-muted">家长仅能查看自己孩子的提交内容。</view><view class="hw-kind-row"><button class="hw-secondary" disabled="{{publishing}}" bindtap="closePreview">返回修改</button><button class="hw-primary" disabled="{{publishing}}" bindtap="confirmPublish">{{publishing ? '发布中…' : '确认发布'}}</button></view></scroll-view></view>
</view>
