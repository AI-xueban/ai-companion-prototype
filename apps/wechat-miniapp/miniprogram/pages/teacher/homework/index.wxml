<view wx:if="{{familyPreview}}" class="hw-filter-mask"><scroll-view scroll-y class="hw-filter-sheet"><button bindtap="closeFamilyPreview">关闭预览</button><view class="hw-card-title">{{draft.title}}</view><view class="hw-muted">仅预览，不会发送或提交</view><view class="hw-card-title">老师的要求</view><view style="white-space:pre-wrap">{{draft.description}}</view><task-attachments items="{{draft.attachments}}" /><view wx:for="{{previewItems}}" wx:key="id" class="hw-card"><view>{{index+1}}. {{item.title}}</view><view>{{item.instruction}}</view><view>{{item.type}}</view></view><view>正常截止 {{draft.deadline}}</view><view>补交截止 {{draft.submitDeadline}}</view></scroll-view></view>
<view wx:if="{{managementOpen}}" class="hw-filter-mask"><scroll-view scroll-y class="hw-filter-sheet"><view class="hw-card-title">管理任务</view><button bindtap="closeManagement">取消</button><block wx:if="{{!managementAction}}"><block wx:if="{{!selectedTask.withdrawnAt && !selectedTask.stoppedAt}}"><button data-action="withdraw" bindtap="chooseManagement">撤回任务</button><button data-action="extend" bindtap="chooseManagement">延长截止</button><button data-action="reopen" bindtap="chooseManagement">重新开放补交</button><button data-action="correct" bindtap="chooseManagement">更正文字说明</button><button wx:if="{{selectedTask.kind === 'checkin'}}" data-action="stop" bindtap="chooseManagement">终止连续打卡</button></block><button data-action="copy" bindtap="chooseManagement">再发一份</button></block><block wx:else><view wx:if="{{managementAction === 'extend' || managementAction === 'reopen'}}"><view>正常截止</view><picker mode="date" value="{{managementDeadlineDate}}" data-field="deadline" data-part="date" bindchange="changeManagementTime"><view class="hw-input">{{managementDeadlineDate}}</view></picker><picker mode="time" value="{{managementDeadlineTime}}" data-field="deadline" data-part="time" bindchange="changeManagementTime"><view class="hw-input">{{managementDeadlineTime}}</view></picker><view>补交截止</view><picker mode="date" value="{{managementEndDate}}" data-field="submitDeadline" data-part="date" bindchange="changeManagementTime"><view class="hw-input">{{managementEndDate}}</view></picker><picker mode="time" value="{{managementEndTime}}" data-field="submitDeadline" data-part="time" bindchange="changeManagementTime"><view class="hw-input">{{managementEndTime}}</view></picker></view><view wx:if="{{managementAction === 'correct'}}"><view>老师的要求</view><textarea value="{{managementInput.description}}" data-field="description" bindinput="changeManagement" /><view wx:for="{{managementInput.itemTexts}}" wx:key="id"><input value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="changeManagementItem" /><textarea value="{{item.instruction}}" data-index="{{index}}" data-field="instruction" bindinput="changeManagementItem" /></view></view><view wx:if="{{managementAction === 'stop'}}">从第几期起终止<input type="number" value="{{managementInput.fromCycle}}" data-field="fromCycle" bindinput="changeManagement" /></view><view>变更原因（必填）</view><textarea value="{{managementInput.reason}}" data-field="reason" bindinput="changeManagement" /><view class="hw-error">{{managementError}}</view><button class="hw-primary" bindtap="saveManagement">核对并执行变更</button></block></scroll-view></view>

<view wx:if="{{draftMenuId}}" class="hw-draft-mask hw-draft-menu-mask" bindtap="closeDraftOverlay"><view class="hw-draft-menu" catchtap="stopDatePickerTap"><view>{{draftMenuTitle}}</view><button class="hw-draft-danger" bindtap="requestDraftDeletion">删除草稿</button><button bindtap="closeDraftOverlay">取消</button></view></view>
<view wx:if="{{draftDeleteOpen}}" class="hw-draft-mask"><view class="hw-draft-dialog" role="dialog" aria-label="删除这份草稿"><view class="hw-draft-dialog-content"><view class="hw-draft-dialog-title">删除这份草稿？</view><view class="hw-draft-object">{{draftDeleteTitle}}</view><view>删除后无法恢复，已发布任务不受影响。</view><view wx:if="{{draftDeleteError}}" class="hw-draft-error">{{draftDeleteError}}</view></view><view class="hw-draft-dialog-actions"><button bindtap="closeDraftOverlay">取消</button><button bindtap="confirmDraftDeletion">删除草稿</button></view></view></view>

<view wx:if="{{studentPhotoOpen}}" class="hw-student-gallery"><view class="hw-student-gallery-heading"><text>{{studentPhotoPages[studentPhotoIndex].title}}</text><button wx:if="{{studentPhotoPages[studentPhotoIndex].gradedPath}}" bindtap="toggleStudentPhotoView">{{studentPhotoPages[studentPhotoIndex].showOriginal ? '查看批改图' : '查看原图'}}</button><button bindtap="closeStudentPhoto">关闭 ×</button></view><swiper current="{{studentPhotoGroupIndex}}" bindchange="changeStudentPhoto" circular="{{false}}" class="hw-student-gallery-swiper"><swiper-item wx:for="{{studentPhotoGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="studentId"><swiper vertical current="{{group.current}}" data-group="{{groupIndex}}" catchchange="changeStudentMedia" circular="{{false}}" class="hw-student-media-swiper"><swiper-item wx:for="{{group.media}}" wx:for-item="media" wx:for-index="mediaIndex" wx:key="index"><video wx:if="{{media.type === 'video'}}" id="hw-gallery-video-{{groupIndex}}-{{mediaIndex}}" src="{{media.path}}" controls enable-progress-gesture="{{false}}" object-fit="contain" /><image wx:elif="{{media.path}}" src="{{media.path}}" mode="aspectFit" data-group="{{groupIndex}}" data-media="{{mediaIndex}}" binderror="studentPreviewError" bindtap="zoomStudentPhoto" /><view wx:if="{{media.imageError}}" class="hw-image-error" role="status">{{media.imageError}}</view></swiper-item></swiper></swiper-item></swiper><view class="hw-student-gallery-hint">左右切换学生 · 上下查看内容</view><view class="hw-student-gallery-count">学生 {{studentPhotoGroupIndex+1}}/{{studentPhotoGroups.length}} · 内容 {{studentPhotoGroups[studentPhotoGroupIndex].current+1}}/{{studentPhotoGroups[studentPhotoGroupIndex].media.length}}<button wx:if="{{studentPhotoPages[studentPhotoIndex].type === 'photo'}}" bindtap="zoomStudentPhoto">放大查看</button></view></view>
