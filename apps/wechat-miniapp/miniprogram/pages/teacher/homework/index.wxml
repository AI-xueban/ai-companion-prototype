<page-navigation title-size="{{18}}" action-size="{{44}}" title="{{previewOpen ? '核对发布内容' : mode === 'drafts' ? '我的草稿' : mode === 'question' ? '单题批改结果' : mode === 'detail' ? selectedTask.title : mode === 'students' ? studentListTitle : mode === 'student' ? selectedStudentName : mode === 'compose' ? '发布任务' : mode === 'success' ? '发布成功' : '作业'}}" back="{{mode !== 'list' || previewOpen}}" home="{{mode !== 'list' || previewOpen}}" home-label="回到作业首页" bind:back="navigateBack" bind:home="returnToHomeworkHome" />
<view class="hw-page">
  <block wx:if="{{!previewOpen}}">
  <view wx:if="{{mode === 'list'}}" class="hw-home-utility"><button class="hw-current-role" bindtap="toggleHomeworkRole">{{readOnly ? '学校管理员' : scope.view === 'homeroom' ? '班主任' : '任课老师'}}⌄</button><button wx:if="{{!readOnly}}" class="hw-my-drafts" bindtap="openTeacherDrafts"><view class="hw-draft-entry-icon"></view>我的草稿<text class="hw-draft-count">{{draftRows.length}}</text><text>›</text></button></view>

  <view wx:if="{{mode === 'list'}}">
    <scroll-view wx:if="{{readOnly}}" scroll-x="true"><view class="hw-chip-row"><view class="hw-chip {{scope.classId === 'all' ? 'active' : ''}}" data-id="all" bindtap="changeScopeClass">全部班级</view><view wx:for="{{scopeClasses}}" wx:key="id" class="hw-chip {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeScopeClass">{{item.name}}</view></view></scroll-view>
    <view wx:if="{{readOnly}}" class="hw-stat-grid"><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.taskCount}}</view><view>已截止作业</view></view><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.completed}} / {{scopeSummary.target}}</view><view>整份完成</view></view><view class="hw-stat"><view class="hw-stat-num">{{scopeSummary.checkinCompleted}} / {{scopeSummary.checkinTarget}}</view><view>打卡完成</view></view></view><view wx:if="{{readOnly}}" class="hw-muted">进行中 {{scopeSummary.ongoing}} 期；作业与打卡分别统计。</view>
    <button wx:if="{{!readOnly}}" class="hw-primary hw-publish-entry" bindtap="newTeacherDraft">＋ 发布作业或打卡</button><view wx:if="{{draftFeedback}}" class="hw-draft-feedback">{{draftFeedback}}</view>
<view class="hw-list-tools"><view class="hw-list-title">任务列表 <text>{{listTaskCount}}</text></view><view class="hw-list-filters"><view class="hw-list-filter {{listSubject !== 'all' ? 'active' : ''}}" data-kind="subject" bindtap="openTaskFilter"><text>{{listSubject === 'all' ? '学科' : listSubject}}</text><text class="hw-filter-chevron"></text></view><view class="hw-list-filter {{listClassId !== 'all' ? 'active' : ''}}" data-kind="class" bindtap="openTaskFilter"><text>{{listClassLabel}}</text><text class="hw-filter-chevron"></text></view><view class="hw-list-filter {{listStatusLabel !== '状态' ? 'active' : ''}}" data-kind="status" bindtap="openTaskFilter"><text>{{listStatusLabel}}</text><text class="hw-filter-chevron"></text></view></view></view><view wx:if="{{!taskGroups.length}}" class="hw-muted">没有符合筛选条件的任务。<view class="hw-link" bindtap="resetTaskFilters">重置筛选</view></view>
    <block wx:for="{{taskGroups}}" wx:key="id"><view wx:if="{{item.sectionLabel}}" class="hw-section">{{item.sectionLabel}}</view><view class="hw-card {{item.isSeries ? 'hw-series-card' : ''}}">
      <view wx:if="{{item.isSeries}}" data-id="{{item.id}}" bindtap="openSeries">
      <view class="hw-list-task-title">{{item.title}}</view><view class="hw-list-task-tags"><view class="hw-badge">{{item.kindLabel}} · 连续 {{item.phaseCount}} 期</view></view>
      <view class="hw-muted">{{item.classLabel}} · {{item.ongoing ? '进行中' : '已截止'}} · 每日一交</view>
      <view wx:if="{{item.ongoing}}" class="hw-series-next">{{item.nextLabel}}</view>
      <view class="hw-card-bottom"><view>完成 {{item.completed}} / {{item.target}} 人次</view><view class="hw-rate">查看每日进度 ›</view></view>
      </view>
      <view wx:if="{{!item.isSeries}}" data-id="{{item.id}}" bindtap="openDetail"><view class="hw-list-task-title">{{item.title}}</view><view class="hw-list-task-tags"><text class="hw-list-subject">{{item.subject}}</text><text class="hw-list-kind">{{item.kindLabel}} · 共 {{item.itemCount}} 项 · {{item.itemTypes}}</text><view class="hw-list-state">{{item.statusLabel}}</view></view><view class="hw-muted">{{item.classLabel}}</view><view wx:if="{{item.timeLabel}}" class="hw-task-times"><view>{{item.timeLabel}}</view></view><view wx:if="{{item.attentionLabel}}" class="hw-muted">{{item.attentionLabel}}</view><view class="hw-card-bottom hw-submission-summary"><view>{{item.listProgressLabel}} {{item.completed}}/{{item.target}}<text wx:if="{{item.submissionRemainder}}"> · {{item.submissionRemainder}}</text></view><view class="hw-rate">查看 ›</view></view></view>
    </view></block>
  </view>

  <view wx:elif="{{mode === 'drafts' && !readOnly}}" class="hw-drafts-page"><view class="hw-draft-toolbar"><text>共 {{draftRows.length}} 份 · 最近编辑排序</text><button bindtap="newTeacherDraft">＋ 新建</button></view><view wx:if="{{draftListError}}" class="hw-draft-error">{{draftListError}}<button bindtap="retryDraftList">重试</button></view><view wx:if="{{draftFeedback}}" class="hw-draft-feedback">{{draftFeedback}}</view><view wx:for="{{draftRows}}" wx:key="id" class="hw-draft-card"><view class="hw-draft-main" data-id="{{item.id}}" bindtap="openSavedDraft"><view class="hw-draft-edited">{{item.editedLabel}}</view><view class="hw-draft-title">{{item.title}}</view><view class="hw-draft-meta"><text>{{item.subject}}</text> {{item.kindLabel}} · {{item.itemCount}} 项　{{item.classLabel}}</view><view wx:if="{{item.expired}}" class="hw-draft-expired">首次截止已过，继续时需调整</view><view class="hw-draft-bottom"><text>首次截止 {{item.deadline}}</text><text>继续编辑 ›</text></view></view><button class="hw-draft-more" aria-label="{{item.title}}更多操作" data-id="{{item.id}}" bindtap="openDraftMenu">···</button></view><view wx:if="{{!draftRows.length && !draftListError}}" class="hw-draft-empty"><view>暂无草稿</view><view>未发布的内容会保存在这里。</view><button class="hw-secondary" bindtap="newTeacherDraft">新建作业或打卡</button></view><view class="hw-draft-privacy">仅自己可见，尚未发送给学生</view></view>
  <view wx:elif="{{mode === 'compose'}}" class="hw-compose">
    <view class="hw-compose-toolbar"><view class="hw-stepper hw-stepper-compact"><view class="{{composeStep === 0 ? 'active' : 'done'}}">① {{draft.kind === 'checkin' ? '填写打卡' : '填写作业'}}</view><text>—</text><view class="{{composeStep === 1 ? 'active' : ''}}">② 选择班级和学生</view></view><view wx:if="{{composeStep === 0}}" class="hw-kind-toolbar"><view class="{{draft.kind === 'homework' ? 'active' : ''}}" data-kind="homework" bindtap="changeKind">作业</view><view class="{{draft.kind === 'checkin' ? 'active' : ''}}" data-kind="checkin" bindtap="changeKind">打卡</view></view></view>
    <view wx:if="{{composeStep === 0}}"><view wx:if="{{deadlineExpired}}" class="hw-error">截止时间已过，请重新设置。<button size="mini" data-days="0" bindtap="quickDeadline">改为今天</button><button size="mini" data-days="1" bindtap="quickDeadline">改为明天</button></view>
      <view class="hw-card hw-compose-card">
        <view class="hw-auto-title-row"><input class="hw-input" aria-label="作业标题，可修改" value="{{draft.title}}" bindinput="changeTitle" /><picker wx:if="{{subjectOptions.length > 1}}" mode="selector" range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="changeSubject"><view class="hw-subject-select">{{draft.subject}}⌄</view></picker></view>
        <view wx:if="{{!subjectOptions.length}}" class="hw-error">暂无可发布学科，请联系学校管理员核对任教关系。</view>
        <view wx:if="{{draft.kind === 'checkin'}}" class="hw-compact-field"><view class="hw-label">连续打卡天数（1—30 天）</view><input class="hw-input" type="number" value="{{draft.cycleCount}}" bindinput="changeCycleCount" /></view>
        <view class="hw-description-head"><view class="hw-label hw-field-label">老师的要求</view><view class="hw-demo-fill" bindtap="fillDemoPaste">填入演示内容</view></view><textarea class="hw-textarea hw-paste-area" auto-height="{{true}}" maxlength="-1" placeholder="粘贴作业要求，编号自动分条" value="{{draft.description}}" bindinput="changeDescription" bindblur="recognizeDescription" />

        <view class="hw-attachment-heading"><view class="hw-label">附件<text>（选填）</text></view><view class="hw-attachment-actions"><view class="hw-worksheet-add" bindtap="openWorksheetLibrary">从作业素材库选择</view><view class="hw-attachment-add" bindtap="chooseMaterialAttachment">{{attachmentSaving ? '正在添加…' : '＋ 添加附件'}}</view></view></view>
        <task-attachments items="{{draft.attachments}}" removable="{{true}}" bind:remove="removeMaterialAttachment" />
      </view>
      <view class="hw-card hw-compose-card">
        <view class="hw-setting-head"><view class="hw-card-title">提交方式</view><view class="hw-mode-switch"><view class="{{settingMode === 'uniform' ? 'active' : ''}}" data-mode="uniform" bindtap="changeSettingMode">统一设置</view><view class="{{settingMode === 'individual' ? 'active' : ''}}" data-mode="individual" bindtap="changeSettingMode">单独设置</view></view></view>
        <view wx:if="{{recognitionStale}}" class="hw-muted">内容已修改，请核对识别结果。</view><view wx:if="{{recognitionStale && settingMode === 'individual' && (recognizedCount > 0 || draftItems.length > 1)}}" class="hw-link hw-recheck" bindtap="applyRecognition">确认重新识别</view>
        <view wx:elif="{{recognizedCount}}" class="hw-muted">已识别 {{recognizedCount}} 条要求，可逐条设置。</view><view wx:else class="hw-muted">未识别出编号时，按整段内容设置。</view>
        <view wx:if="{{settingMode === 'uniform'}}" class="hw-type-choices"><view class="hw-type-option {{uniformType === 'file' ? 'active' : ''}}" data-type="file" bindtap="selectUniformType">文件</view><view class="hw-type-option {{uniformType === 'photo' ? 'active' : ''}}" data-type="photo" bindtap="selectUniformType">图片</view><view class="hw-type-option {{uniformType === 'video' ? 'active' : ''}}" data-type="video" bindtap="selectUniformType">视频</view><view class="hw-type-option {{uniformType === 'audio' ? 'active' : ''}}" data-type="audio" bindtap="selectUniformType">录音</view><view class="hw-type-option {{uniformType === 'none' ? 'active' : ''}}" data-type="none" bindtap="selectUniformType">线下完成</view></view>
        <view wx:else><view class="hw-requirement-title"><view class="hw-label">完成要求 · {{draftItems.length}} 项</view></view><view wx:for="{{draftItems}}" wx:key="id" class="hw-requirement"><view class="hw-requirement-row" data-index="{{index}}" bindtap="toggleItemOptions"><view class="hw-requirement-number">{{index + 1}}</view><view class="hw-requirement-name">{{item.title || '未填写要求'}}</view><view class="hw-requirement-selected">{{item.submitLabel}} {{expandedItemIndex === index ? '⌃' : '›'}}</view></view><view wx:if="{{expandedItemIndex === index}}"><textarea class="hw-textarea hw-item-textarea" value="{{item.title}}" data-index="{{index}}" bindinput="changeItemTitle" /><view class="hw-type-choices hw-item-types"><view class="hw-type-option {{item.submitType === 'file' ? 'active' : ''}}" data-type="file" data-index="{{index}}" bindtap="selectItemType">文件</view><view class="hw-type-option {{item.submitType === 'photo' ? 'active' : ''}}" data-type="photo" data-index="{{index}}" bindtap="selectItemType">图片</view><view class="hw-type-option {{item.submitType === 'video' ? 'active' : ''}}" data-type="video" data-index="{{index}}" bindtap="selectItemType">视频</view><view class="hw-type-option {{item.submitType === 'audio' ? 'active' : ''}}" data-type="audio" data-index="{{index}}" bindtap="selectItemType">录音</view><view class="hw-type-option {{item.submitType === 'none' ? 'active' : ''}}" data-type="none" data-index="{{index}}" bindtap="selectItemType">线下完成</view></view><view wx:if="{{draftItems.length > 1}}" class="hw-link hw-remove-item" data-index="{{index}}" bindtap="removeItem">移除本条</view></view></view><view class="hw-add" bindtap="addItem">＋ 手动添加一项</view></view>
      </view>
      <view class="hw-card"><view class="hw-card-title">批改与页数</view><view wx:for="{{draftItems}}" wx:key="id"><view>{{index+1}}. {{item.title}}</view><view wx:if="{{draft.kind === 'homework' && (item.submitType === 'photo' || item.submitType === 'file')}}"><switch checked="{{item.gradingEnabled}}" data-index="{{index}}" bindchange="toggleGrading" /><text>{{item.gradingEnabled ? '自动批改' : '无需批改'}}</text><view class="hw-muted">{{item.submitType === 'file' && item.gradingEnabled ? '家长仅可交 PDF、Word' : item.gradingEnabled ? '提交后自动识题批改' : '仅收集，不生成批改结果'}}</view></view><view wx:else class="hw-muted">仅记录提交</view><input wx:if="{{item.submitType === 'photo'}}" type="number" placeholder="预计页数（选填，1—9）" data-index="{{index}}" value="{{item.expectedPages || ''}}" bindinput="changeExpectedPages" /></view></view>
      <view class="hw-card hw-compose-card"><view class="hw-card-title">截止时间</view><view>允许补交 <switch checked="{{draft.allowSupplement !== false}}" bindchange="toggleSupplement" /></view><view class="hw-date-summary" data-target="deadline" bindtap="openDatePicker"><view>首次截止</view><view>{{deadlineDisplay}}</view><text>›</text></view><view wx:if="{{draft.allowSupplement !== false}}" class="hw-date-summary" data-target="submitDeadline" bindtap="openDatePicker"><view>允许补交至</view><view>{{submitDeadlineDisplay}}</view><text>›</text></view><view class="hw-muted">补交截止默认比首次截止晚 7 天，可修改。</view></view>
    </view>
    <view wx:else class="hw-card hw-compose-card"><view class="hw-card-title">选择班级及接收人</view><view class="hw-muted">每个班可独立设置全班或部分学生。</view><view wx:for="{{classes}}" wx:key="id" class="hw-class-option"><view data-id="{{item.id}}" bindtap="toggleClass">{{item.selected ? '☑' : '□'}} {{item.name}}</view><view wx:if="{{item.selected}}" class="hw-recipient-class-actions"><button size="mini" data-id="{{item.id}}" data-mode="all" bindtap="setClassRecipients">{{item.recipientMode === 'all' ? '✓ ' : ''}}全班</button><button size="mini" data-id="{{item.id}}" data-mode="selected" bindtap="setClassRecipients">{{item.recipientMode === 'selected' ? '✓ ' : ''}}部分 {{item.recipientMode === 'selected' ? item.count : ''}}人 ›</button></view></view><view>已选 {{draft.classIds.length}} 个班 · 共发送 {{previewTargetCount}} 人</view></view>
    <view wx:if="{{recipientPickerOpen}}" class="hw-filter-mask"><view class="hw-filter-sheet"><view class="hw-card-title">选择本班学生</view><button bindtap="closeRecipientPicker">完成选择</button><input placeholder="搜索本班姓名或学号" value="{{studentSearch}}" bindinput="changeStudentSearch" /><view wx:for="{{studentGroups}}" wx:for-item="group" wx:key="id"><view>{{group.name}} · 已选 {{group.selectedCount}}/{{group.total}}</view><view class="hw-recipient-class-actions"><button data-selected="true" bindtap="selectRecipientClassAll">全选本班</button><button data-selected="false" bindtap="selectRecipientClassAll">清空本班</button></view><view wx:for="{{group.students}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleStudent">{{item.selected ? '☑' : '□'}} {{item.name}} · {{item.id}}</view><view wx:if="{{!group.students.length}}">没有匹配的学生，已选名单保留。</view></view></view></view>

    <view wx:if="{{composeError}}" class="hw-error">{{composeError}}</view><button class="hw-primary hw-bottom" bindtap="nextCompose">{{composeStep === 1 ? '核对发布内容' : '下一步：选择班级和学生'}}</button>
    <view wx:if="{{datePickerOpen}}" class="hw-date-mask" bindtap="closeDatePicker"><view class="hw-date-sheet" catchtap="stopDatePickerTap"><view class="hw-date-sheet-head"><view bindtap="closeDatePicker">取消</view><view>设置{{datePickerTarget === 'deadline' ? '首次截止' : '允许补交至'}}时间</view><view class="hw-link" bindtap="confirmDatePicker">确定</view></view><view class="hw-draft-actions"><button size="mini" data-days="0" bindtap="quickPickerDate">今天</button><button size="mini" data-days="1" bindtap="quickPickerDate">明天</button></view><view class="hw-calendar-month"><view data-delta="-1" bindtap="shiftDateMonth">‹</view><view>{{calendarTitle}}</view><view data-delta="1" bindtap="shiftDateMonth">›</view></view><view class="hw-calendar-week"><view wx:for="{{weekdays}}" wx:key="*this">{{item}}</view></view><view class="hw-calendar-grid"><view wx:for="{{calendarDays}}" wx:key="key" class="{{item.selected ? 'active' : ''}} {{item.empty || item.disabled ? 'empty' : ''}}" data-day="{{item.day}}" bindtap="chooseDateDay">{{item.day}}</view></view><view class="hw-picker-time"><view>时间</view><picker mode="selector" range="{{hourOptions}}" value="{{pickerHourIndex}}" bindchange="changePickerHour"><view class="hw-picker-time-cell">{{pickerHour}}　⌄</view></picker><text>:</text><picker mode="selector" range="{{minuteOptions}}" value="{{pickerMinuteIndex}}" bindchange="changePickerMinute"><view class="hw-picker-time-cell">{{pickerMinute}}　⌄</view></picker></view></view></view>
  <view wx:if="{{worksheetLibraryOpen}}" class="hw-date-mask" bindtap="closeWorksheetLibrary"><view class="hw-worksheet-sheet" catchtap="stopDatePickerTap"><view class="hw-date-sheet-head"><view bindtap="closeWorksheetLibrary">取消</view><view>选择作业素材</view><view></view></view><scroll-view scroll-y class="hw-worksheet-scroll"><view class="hw-worksheet-tip">选择后会自动填入学科、作业说明、空白作业附件和“拍照提交”要求。</view><view wx:for="{{worksheetTemplates}}" wx:key="id" class="hw-worksheet-card {{item.available ? '' : 'disabled'}}" data-id="{{item.id}}" bindtap="applyWorksheetTemplate"><image src="{{item.blankPath}}" mode="aspectFill" /><view><view><text>{{item.grade}}年级</text><text>{{item.subject}}</text></view><strong>{{item.title}}</strong><small>{{item.description}}</small><em>{{item.available ? '套用此素材' : '当前账号无该学科任教范围'}}</em></view></view></scroll-view></view></view>
  </view>

  <view wx:elif="{{mode === 'success'}}" class="hw-success"><view class="hw-success-icon">✓</view><view class="hw-muted">{{publishedTitle}} 已发布给 {{publishedTargetCount}} 名学生</view><view class="hw-card hw-success-receipt"><view class="hw-status-row"><view>接收班级</view><view>{{publishedClasses}}</view></view><view class="hw-status-row"><view>完成项目</view><view>{{publishedItemCount}} 项</view></view><view class="hw-status-row"><view>原截止</view><view>{{publishedDeadline}}</view></view><view class="hw-status-row"><view>补交截止</view><view>{{publishedSubmitDeadline}}</view></view><view class="hw-status-row"><view>家长端通知</view><view class="hw-rate">本地演示：待接入通知服务</view></view></view><view class="hw-muted">接收名单已按发布时冻结，返回列表后可查看任务统计。</view><button class="hw-primary hw-bottom" bindtap="returnToHomeworkHome">查看已发布任务</button></view>

  <view wx:elif="{{mode === 'detail'}}"><view class="hw-card"><view>{{detailStatus}} {{selectedTask.managementReason}}</view><button wx:if="{{canManageTask}}" bindtap="openManagement">管理任务</button><view wx:if="{{canManageTask}}" class="hw-muted">{{selectedTask.notification.message || '本地演示：尚未接入通知服务'}}</view><button wx:if="{{canManageTask && selectedTask.notification.status === 'failed'}}" bindtap="retryNotification">重试通知</button><view wx:for="{{changeRows}}" wx:key="at"><view>{{item.at}} · {{item.label}} · {{item.reason}}</view><view class="hw-muted">变更前 {{item.beforeText}}</view><view class="hw-muted">变更后 {{item.afterText}}</view></view></view><view wx:if="{{detailClassOptions.length > 2}}" class="hw-detail-classes"><view class="hw-muted">查看班级 · 共 {{detailClassOptions.length - 1}} 个班</view><scroll-view scroll-x enhanced class="hw-detail-class-scroll"><view class="hw-detail-class-options"><view wx:for="{{detailClassOptions}}" wx:key="id" class="hw-detail-class-option {{detailClassId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectDetailClass"><view>{{item.name}}</view><text>已交 {{item.completed}}/{{item.target}} 人</text></view></view></scroll-view></view>
    <view class="hw-card hw-detail-summary"><view class="hw-detail-eyebrow">{{selectedTask.subject}}{{selectedTask.kind === 'checkin' ? '打卡' : '作业'}}</view><view class="hw-detail-title-row"><view class="hw-detail-title">{{selectedTask.title}}</view><view wx:if="{{attachmentCount}}" class="hw-detail-attachment" bindtap="openTaskAttachments">附件 {{attachmentCount}} ›</view></view><view class="hw-detail-class-label">{{detailClassLabel}}</view><view class="hw-detail-description">{{selectedTask.description}}</view><view class="hw-detail-dates"><view><text>正常截止</text><view>{{selectedTask.deadline}}</view></view><view><text>补交截止</text><view>{{selectedTask.submitDeadline}}</view></view></view><view class="hw-detail-progress"><view data-filter="completed" bindtap="openStudentList"><strong>{{summary.completed}}/{{summary.target}}</strong><text>人已交齐</text></view><view data-filter="missing" bindtap="openStudentList"><strong>{{summary.target - summary.completed}}</strong><text>人未交齐</text></view><view class="hw-detail-roster" data-filter="all" bindtap="openStudentList">查看名单 ›</view></view></view>
    <view class="hw-detail-requirement-head"><view>作业要求</view><text>共 {{requirementRows.length}} 项 · 点击查看提交</text></view><view class="hw-card hw-detail-requirements"><view wx:for="{{requirementRows}}" wx:key="id" class="hw-detail-requirement" data-id="{{item.id}}" bindtap="openItemStudents"><view class="hw-detail-requirement-index">{{item.index}}</view><view class="hw-detail-requirement-content"><view>{{item.title}}</view><text><text class="hw-detail-requirement-type">{{item.typeLabel}}</text>{{item.metaLabel}}</text></view><view class="hw-detail-requirement-result"><button wx:if="{{item.metaLabel === '自动批改'}}" data-id="{{item.id}}" catchtap="openItemGrades">查看批改</button><view><strong>{{item.count}}/{{item.target}}</strong> 人{{item.resultLabel}}</view><text>›</text></view></view></view>
    <view wx:if="{{answerRows.length}}" class="hw-card hw-answer-workflow"><view class="hw-card-title">教师参考答案</view><view class="hw-muted">老师提供，按本作业题目关联；修改不影响学生判定和统计。</view>
