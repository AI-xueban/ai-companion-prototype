.hw-page{min-height:100vh;padding:28rpx 28rpx 70rpx;background:#f5f8fc;color:#213b54;font-size:26rpx}.hw-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:28rpx}.hw-eyebrow{color:#78a0b8;font-size:21rpx}.hw-title{margin-top:8rpx;font-size:42rpx;font-weight:700}.hw-back,.hw-link{color:#4b8db4;font-size:24rpx}.hw-intro,.hw-footnote{line-height:1.6;color:#788da2;font-size:23rpx}.hw-intro{margin-bottom:22rpx}.hw-section{margin:34rpx 0 16rpx;font-weight:700;font-size:30rpx}.hw-card{margin:15rpx 0;padding:26rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(32,76,112,.05)}.hw-card-top,.hw-card-bottom,.hw-type-row,.hw-switch-row,.hw-status-row{display:flex;justify-content:space-between;align-items:center;gap:18rpx}.hw-card-title{font-weight:700;font-size:29rpx}.hw-badge{padding:6rpx 14rpx;border-radius:30rpx;background:#e9f5fb;color:#4085a9;font-size:21rpx}.hw-muted{margin-top:12rpx;color:#8799aa;font-size:22rpx;line-height:1.5}.hw-card-bottom{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #edf2f6;color:#70849a}.hw-rate{color:#4b83bb;font-weight:700}.hw-primary,.hw-secondary{margin:0;border:0;border-radius:16rpx;background:#4c9ac2;color:#fff;font-size:26rpx;font-weight:700}.hw-primary::after,.hw-secondary::after{border:0}.hw-primary{height:84rpx;line-height:84rpx}.hw-secondary{height:84rpx;line-height:84rpx;background:#eaf1f5;color:#536e84}.hw-bottom{margin-top:36rpx}.hw-kind-row{display:flex;gap:14rpx;margin:10rpx 0 22rpx}.hw-kind{flex:1;padding:17rpx;border:1rpx solid #dce8f0;border-radius:14rpx;text-align:center;color:#7890a3}.hw-kind.active,.hw-chip.active{border-color:#5a9ec3;background:#eaf6fc;color:#347da4;font-weight:700}.hw-input{height:78rpx;width:100%;margin-top:15rpx;padding:0 18rpx;box-sizing:border-box;border:1rpx solid #e2eaf1;border-radius:14rpx;background:#f9fbfd}.hw-textarea{width:100%;height:148rpx;margin-top:15rpx;padding:18rpx;box-sizing:border-box;border:1rpx solid #e2eaf1;border-radius:14rpx;background:#f9fbfd}.hw-type-row{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #edf2f6}.hw-type{color:#398bb3}.hw-add{padding:24rpx;text-align:center;color:#4c91b5;border:1rpx dashed #a9cfdf;border-radius:16rpx;background:#f7fcff}.hw-label{font-weight:700}.hw-chip-row{display:flex;flex-wrap:wrap;gap:12rpx;margin:20rpx 0}.hw-chip{padding:12rpx 18rpx;border:1rpx solid #dfebf2;border-radius:30rpx;color:#6c859a;font-size:22rpx}.hw-stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.hw-stat{padding:22rpx 12rpx;border-radius:18rpx;background:#fff;text-align:center;font-size:21rpx}.hw-stat-num{margin-bottom:10rpx;color:#4d86bb;font-size:34rpx;font-weight:700}.hw-status-row{padding:15rpx 0}.hw-status-row+.hw-status-row{border-top:1rpx solid #edf2f6}.hw-mask{position:fixed;inset:0;z-index:9;display:flex;align-items:center;justify-content:center;padding:38rpx;background:rgba(18,43,70,.48)}.hw-dialog{width:100%;padding:32rpx;border-radius:24rpx;background:#fff}.hw-dialog .hw-kind-row{margin:32rpx 0 0}.hw-dialog button{flex:1}.hw-footnote{padding:18rpx 4rpx}
.hw-material-row{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin-top:12rpx}.hw-material-row .hw-muted{flex:1}.hw-material-preview{display:flex;align-items:center;gap:20rpx;margin-top:14rpx}.hw-material-preview image{width:126rpx;height:126rpx;border-radius:12rpx}.hw-material-image{display:block;width:100%;margin-top:18rpx;border-radius:12rpx}.hw-review{margin-top:18rpx}
.hw-tappable,.hw-status-row.hw-tappable{cursor:pointer}.hw-original-image{display:block;width:100%;margin-top:20rpx;border-radius:14rpx;background:#eef4f6}.hw-original-video{display:block;width:100%;height:360rpx;margin-top:20rpx;border-radius:14rpx;background:#1f3548}.hw-video-placeholder{margin-top:20rpx;padding:50rpx 24rpx;border-radius:14rpx;background:#eaf2f7;color:#56758d;line-height:1.6}.hw-question-row{display:flex;justify-content:space-between;gap:12rpx;padding:18rpx 0;border-top:1rpx solid #edf2f6;font-size:22rpx}.hw-question-row:first-child{margin-top:20rpx}
.hw-stepper{display:flex;justify-content:space-between;gap:8rpx;margin:0 0 24rpx}.hw-stepper view{flex:1;padding:16rpx 6rpx;border-radius:12rpx;background:#e9eef3;color:#7b90a1;text-align:center;font-size:21rpx}.hw-stepper view.active{background:#d8edf8;color:#226b96;font-weight:700}.hw-field-label{margin-top:20rpx}.hw-date-row{display:flex;gap:14rpx;margin-top:14rpx}.hw-date-row picker{flex:1}.hw-date-cell{padding:20rpx 12rpx;border:1rpx solid #dce8f0;border-radius:12rpx;background:#f9fbfd;text-align:center}.hw-student-scroll{height:370rpx;margin-top:16rpx;border:1rpx solid #e2eaf1;border-radius:14rpx}.hw-student-option{display:flex;justify-content:space-between;padding:19rpx 22rpx;border-bottom:1rpx solid #edf2f6}.hw-student-option.active{color:#287ca7;background:#ecf7fd}.hw-student-class{margin-left:12rpx;color:#91a3b1;font-size:21rpx}.hw-error{margin-top:24rpx;padding:18rpx;border-radius:12rpx;background:#fff0ee;color:#b64237}.hw-dialog{max-height:78vh;box-sizing:border-box}.hw-review-section{padding:20rpx 0;border-bottom:1rpx solid #e9eef3}.hw-review-item{padding-top:16rpx;line-height:1.5}

.hw-page{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}
.hw-business-nav{position:fixed;left:0;right:0;bottom:0;z-index:8;display:flex;align-items:center;height:90rpx;padding:0 28rpx env(safe-area-inset-bottom);background:#fff;box-shadow:0 -5rpx 22rpx rgba(34,71,99,.08)}
.hw-business-nav view{flex:1;text-align:center;color:#7c92a5;font-size:26rpx;line-height:90rpx}
.hw-business-nav view.active{color:#287fa8;font-weight:700}
.hw-visibility-warning{margin:16rpx 0;padding:20rpx 22rpx;border-radius:15rpx;background:#fff4e8;color:#8b5b24;font-size:23rpx;line-height:1.55}
.hw-page{padding-top:20rpx}
.hw-head{margin-bottom:16rpx}
.hw-title{margin-top:5rpx;font-size:37rpx}
.hw-section{margin-top:24rpx}
.hw-series-card{border:1rpx solid #b9dce9;background:#fbfdff}
.hw-series-card .hw-badge{background:#dff0f8;color:#287ca3}
.hw-series-next{margin-top:15rpx;padding:15rpx 18rpx;border-radius:12rpx;background:#eef7fb;color:#2f7295;font-size:23rpx;font-weight:700}
.hw-series-phases{margin-top:18rpx;border-top:1rpx solid #deebf1}
.hw-series-phase{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:19rpx 0}
