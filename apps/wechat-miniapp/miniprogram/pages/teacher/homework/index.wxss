.hw-eyebrow,.hw-intro,.hw-footnote{color:#647e91}
.hw-back,.hw-link,.hw-rate,.hw-type,.hw-business-nav view.active{color:#087fc5}
.hw-primary{background:#168fe0}
.hw-badge,.hw-series-card .hw-badge{background:#e5f5ff;color:#087fc5}
.hw-series-card{border-color:#dbe9f0;background:#fff}
.hw-series-next{background:#f0f9ff;color:#087fc5}

