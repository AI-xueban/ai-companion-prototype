@import "../../../styles/learning-report.wxss";
.teacher-learning{min-height:100vh;padding:0 28rpx 72rpx;background:#f5f8fc;color:#263c55;font-size:25rpx}.tl-head{margin:0 -28rpx;padding:42rpx 28rpx 37rpx;background:linear-gradient(145deg,#e6f4ff,#f6faff)}.tl-eyebrow{color:#6f9cb8;font-size:22rpx}.tl-title{margin-top:13rpx;font-size:43rpx;font-weight:700}.tl-sub{margin-top:9rpx;color:#7992a7;font-size:23rpx}.tl-scope{margin-top:24rpx}.tl-class-scroll{white-space:nowrap}.tl-chips{display:flex;gap:12rpx}.tl-chip{flex:none;padding:14rpx 21rpx;border-radius:28rpx;background:#fff;color:#66839d}.tl-chip.active{background:#367fad;color:#fff;font-weight:700}.tl-switch{display:flex;gap:8rpx;margin-top:18rpx;padding:7rpx;border-radius:17rpx;background:#e9eff5}.tl-switch view{flex:1;padding:15rpx 8rpx;border-radius:12rpx;color:#7490a8;text-align:center;font-size:23rpx}.tl-switch view.active{background:#fff;color:#2b76a3;font-weight:700;box-shadow:0 2rpx 8rpx rgba(35,80,120,.08)}.tl-period{max-width:370rpx}.tl-tabs{display:flex;justify-content:space-between;margin-top:30rpx;border-bottom:1rpx solid #e4ebf1}.tl-tabs view{padding:16rpx 18rpx;color:#8fa0af}.tl-tabs view.active{border-bottom:4rpx solid #2e84b4;color:#237ba9;font-weight:700}.tl-hero{margin-top:24rpx;padding:28rpx;border-radius:23rpx;background:linear-gradient(140deg,#173d68,#256d8c);color:#fff}.tl-hero-label{color:#c8e3ec;font-size:23rpx}.tl-hero-rate{margin:11rpx 0;font-size:60rpx;font-weight:700}.tl-hero-note{color:#d5e8ee;font-size:22rpx}.tl-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:18rpx}.tl-stats view{padding:20rpx 10rpx;border-radius:18rpx;background:#fff;color:#8b9cad;text-align:center;font-size:20rpx}.tl-stats text{display:block;margin-bottom:8rpx;color:#327fa8;font-size:34rpx;font-weight:700}.tl-section{margin:37rpx 0 16rpx;font-size:30rpx;font-weight:700}.tl-section-between{display:flex;align-items:center;justify-content:space-between}.tl-mini-switch{display:flex;gap:6rpx;padding:5rpx;border-radius:14rpx;background:#e9e