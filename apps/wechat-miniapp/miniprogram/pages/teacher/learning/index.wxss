.teacher-learning{min-height:100vh;padding:0 28rpx 72rpx;background:#f5f8fc;color:#263c55;font-size:25rpx}.tl-head{margin:0 -28rpx;padding:42rpx 28rpx 37rpx;background:linear-gradient(145deg,#e6f4ff,#f6faff)}.tl-eyebrow{color:#6f9cb8;font-size:22rpx}.tl-title{margin-top:13rpx;font-size:43rpx;font-weight:700}.tl-sub{margin-top:9rpx;color:#7992a7;font-size:23rpx}.tl-scope{margin-top:24rpx}.tl-class-scroll{white-space:nowrap}.tl-chips{display:flex;gap:12rpx}.tl-chip{flex:none;padding:14rpx 21rpx;border-radius:28rpx;background:#fff;color:#66839d}.tl-chip.active{background:#367fad;color:#fff;font-weight:700}.tl-switch{display:flex;gap:8rpx;margin-top:18rpx;padding:7rpx;border-radius:17rpx;background:#e9eff5}.tl-switch view{flex:1;padding:15rpx 8rpx;border-radius:12rpx;color:#7490a8;text-align:center;font-size:23rpx}.tl-switch view.active{background:#fff;color:#2b76a3;font-weight:700;box-shadow:0 2rpx 8rpx rgba(35,80,120,.08)}.tl-period{max-width:370rpx}.tl-tabs{display:flex;justify-content:space-between;margin-top:30rpx;border-bottom:1rpx solid #e4ebf1}.tl-tabs view{padding:16rpx 18rpx;color:#8fa0af}.tl-tabs view.active{border-bottom:4rpx solid #2e84b4;color:#237ba9;font-weight:700}.tl-hero{margin-top:24rpx;padding:28rpx;border-radius:23rpx;background:linear-gradient(140deg,#173d68,#256d8c);color:#fff}.tl-hero-label{color:#c8e3ec;font-size:23rpx}.tl-hero-rate{margin:11rpx 0;font-size:60rpx;font-weight:700}.tl-hero-note{color:#d5e8ee;font-size:22rpx}.tl-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:18rpx}.tl-stats view{padding:20rpx 10rpx;border-radius:18rpx;background:#fff;color:#8b9cad;text-align:center;font-size:20rpx}.tl-stats text{display:block;margin-bottom:8rpx;color:#327fa8;font-size:34rpx;font-weight:700}.tl-section{margin:37rpx 0 16rpx;font-size:30rpx;font-weight:700}.tl-section-between{display:flex;align-items:center;justify-content:space-between}.tl-mini-switch{display:flex;gap:6rpx;padding:5rpx;border-radius:14rpx;background:#e9eff5;font-size:22rpx}.tl-mini-switch text{padding:9rpx 16rpx;border-radius:10rpx;color:#8a9cab}.tl-mini-switch text.active{background:#fff;color:#2e7fa8}.tl-card,.tl-empty{margin-top:12rpx;padding:8rpx 24rpx;border-radius:21rpx;background:#fff}.tl-empty{padding:28rpx;color:#96a6b6}.tl-row{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.tl-list-row{min-height:76rpx;padding:17rpx 0}.tl-list-row+.tl-list-row,.tl-event+.tl-event{border-top:1rpx solid #edf1f5}.tl-strong{font-size:26rpx;font-weight:700}.tl-blue{color:#3789b5;font-weight:700;white-space:nowrap}.tl-muted{margin-top:8rpx;color:#899bab;font-size:22rpx;line-height:1.5}.tl-caption,.tl-footnote{margin:18rpx 2rpx 0;color:#96a6b5;font-size:21rpx;line-height:1.55}.tl-footnote{margin-top:36rpx}.tl-knowledge{padding:24rpx;margin-bottom:14rpx}.tl-question-list{margin-top:17rpx;padding-top:12rpx;border-top:1rpx solid #edf1f5}.tl-question-list .tl-muted{margin:12rpx 0}.tl-back{margin:25rpx 0;color:#387fac}.tl-event{padding:21rpx 0}
.tl-head{padding-top:24rpx;padding-bottom:22rpx}.tl-head-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:10rpx}.tl-head-row .tl-title{margin:0;font-size:38rpx;line-height:1.25}.tl-head-row .tl-period{flex:none;width:262rpx;max-width:none;margin:0;padding:5rpx}.tl-head-row .tl-period view{padding:10rpx 3rpx;font-size:20rpx}.tl-sub{margin-top:7rpx}.tl-scope{margin-top:10rpx}.tl-scope .tl-back{margin:12rpx 0}.tl-scope .tl-switch{margin-top:8rpx}.tl-scope .tl-class-scroll{margin-top:8rpx}.tl-scope .tl-chip{padding:11rpx 18rpx}.tl-tabs{margin-top:15rpx}.tl-hero{margin-top:14rpx}
.tl-question-entry{padding:19rpx 0;border-bottom:1rpx solid #edf1f5}.tl-detail-mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;background:rgba(20,39,57,.45)}.tl-detail{width:100%;max-height:82vh;overflow-y:auto;padding:30rpx 28rpx 60rpx;border-radius:26rpx 26rpx 0 0;background:#fff}.tl-detail-head{display:flex;justify-content:space-between;gap:20rpx;color:#287fa8}.tl-event{cursor:pointer}

.teacher-learning{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}
.tl-business-nav{position:fixed;left:0;right:0;bottom:0;z-index:8;display:flex;align-items:center;height:90rpx;padding:0 28rpx env(safe-area-inset-bottom);background:#fff;box-shadow:0 -5rpx 22rpx rgba(34,71,99,.08)}
.tl-business-nav view{flex:1;text-align:center;color:#7c92a5;font-size:26rpx;line-height:90rpx}
.tl-business-nav view.active{color:#287fa8;font-weight:700}
.tl-hero{display:grid;grid-template-columns:1fr auto;align-items:center;column-gap:20rpx;padding:28rpx 32rpx;box-shadow:0 14rpx 32rpx rgba(26,76,110,.14)}
.tl-hero-label{grid-column:1;grid-row:1;font-size:24rpx}
.tl-hero-rate{grid-column:2;grid-row:1 / span 2;margin:0;font-size:66rpx;line-height:1.1}
.tl-hero-note{grid-column:1;grid-row:2;margin-top:12rpx;line-height:1.45}
.tl-focus{margin-top:18rpx;overflow:hidden;border:1rpx solid #cee4ee;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(31,91,124,.08)}
.tl-focus-kicker{padding:24rpx 28rpx 0;background:#edf8fc;color:#287f9f;font-size:20rpx;font-weight:700;letter-spacing:2rpx}
.tl-focus .tl-section{margin:0;padding:7rpx 28rpx 22rpx;background:#edf8fc;color:#173e5b;font-size:31rpx}
.tl-focus .tl-caption{margin:0;padding:17rpx 28rpx 0;color:#6c8799}
.tl-focus .tl-card{margin:0;padding:0 28rpx;border-radius:0}
.tl-focus .tl-list-row{min-height:88rpx}
.tl-focus .tl-empty{margin:0;padding:28rpx;background:#fff}
.tl-focus + .tl-stats{margin-top:18rpx}
.tl-stats view{border:1rpx solid #e8eef4}
.tl-head{padding-top:18rpx;padding-bottom:17rpx}
.tl-head-row{margin-top:7rpx}
.tl-head-row .tl-title{font-size:35rpx}
.tl-scope{margin-top:0}
.tl-scope-options{padding:8rpx 0 14rpx;border-bottom:1rpx solid #e4edf2}
.tl-scope-options .tl-switch{margin-top:0}
.tl-tabs{margin-top:8rpx}

/* 学情页使用白底蓝色重点，避免整块深蓝压住后续信息。 */
.teacher-learning{background:#f5fbff;color:#193349}
.tl-head{background:#fff;border-bottom:1rpx solid #e5edf3}
.tl-eyebrow{color:#537891}
.tl-head-row .tl-period{background:#e9f6ff}
.tl-switch view.active,.tl-chip.active{color:#087fc5;background:#fff}
.tl-tabs view.active,.tl-business-nav view.active{color:#087fc5;border-bottom-color:#168fe0}
.tl-hero{background:#fff;border:1rpx solid #e2ebf1;box-shadow:0 8rpx 25rpx rgba(25,51,73,.05);color:#193349}
.tl-hero-label,.tl-hero-note{color:#647e91}
.tl-hero-rate{color:#168fe0}
.tl-blue,.tl-stats text{color:#087fc5}
.tl-focus{border-color:#dbe9f0;box-shadow:0 8rpx 24rpx rgba(25,51,73,.05)}
.tl-focus-kicker,.tl-focus .tl-section{background:#f0f9ff}
.tl-focus-kicker{color:#087fc5}
.tl-head-row{margin:0}
.tl-greeting{flex:1;min-width:0}
.tl-greeting-line{color:#193349;font-size:35rpx;font-weight:700;line-height:1.3}
.tl-greeting-meta{margin-top:6rpx;color:#6c8395;font-size:21rpx;line-height:1.4}
.tl-role-dismiss{position:fixed;top:0;right:0;bottom:0;left:0;z-index:18;background:transparent}
.tl-role-picker{position:relative;z-index:19;flex:none}
.tl-role-badge{display:flex;align-items:center;gap:6rpx;min-height:66rpx;padding:0 18rpx;border-radius:14rpx;background:#e5f5ff;color:#087fc5;font-size:21rpx;font-weight:700}
.tl-role-chevron,.tl-scope-arrow{position:relative;top:-3rpx;flex:none;box-sizing:border-box;width:13rpx;height:13rpx;margin-left:5rpx;border-right:3rpx solid #087fc5;border-bottom:3rpx solid #087fc5;transform:rotate(45deg);transition:transform .15s,top .15s}
.tl-role-chevron.open,.tl-scope-arrow.open{top:3rpx;transform:rotate(225deg)}
.tl-role-menu{position:absolute;right:0;top:100%;min-width:212rpx;margin-top:10rpx;padding:8rpx;border:1rpx solid #dcebf2;border-radius:16rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(25,51,73,.13)}
.tl-role-menu-label{padding:8rpx 14rpx 4rpx;color:#8ba0af;font-size:18rpx}
.tl-role-option{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:72rpx;padding:0 14rpx;border-radius:10rpx;color:#385269;font-size:23rpx;white-space:nowrap}
.tl-role-option text{color:#8ca7ba;font-size:28rpx}
.tl-role-option:active{background:#e5f5ff;color:#087fc5}
.tl-condition-row{display:flex;align-items:center;gap:12rpx;margin-top:16rpx}
.tl-condition-row .tl-scope-summary{display:flex;flex:0 1 auto;align-items:center;gap:10rpx;min-width:0;min-height:70rpx;padding:0 16rpx;border:1rpx solid #dcebf2;border-radius:16rpx;background:#fff}
.tl-condition-row .tl-scope-static{display:flex;flex:0 1 auto;align-items:center;gap:10rpx;min-width:0;min-height:70rpx;padding:0 4rpx;border:0;background:transparent}
.tl-condition-row .tl-scope-key{flex:none;color:#7792a5;font-size:20rpx;font-weight:400}
.tl-condition-row .tl-scope-value{overflow:hidden;color:#193349;font-size:22rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.tl-condition-row .tl-period{flex:none;width:255rpx;max-width:none;margin:0 0 0 auto;padding:6rpx;background:#e9f6ff}
.tl-condition-row .tl-period view{padding:13rpx 2rpx;font-size:20rpx}
