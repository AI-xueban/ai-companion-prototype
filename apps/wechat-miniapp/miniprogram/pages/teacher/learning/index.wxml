          </view>
          <view class="ml-card"><view class="ml-card-head"><view class="ml-h2">学科作答概况</view></view><template is="materialMetrics" data="{{v:subjectHome.material}}" />
            <button class="ml-entry" data-route="{{subjectHome.review}}" bindtap="openSubjectRoute"><view>阶段回顾<text class="ml-small">按作业、练习或知识点查看</text></view><text class="ml-blue">按阶段查看 ›</text></button><button class="ml-entry" data-tab="students" bindtap="changeTab"><text>学生学情</text><text class="ml-blue">{{subjectHome.material.enrolled}}人 ›</text></button>
          </view>
        </view>
      </view>
    </view>
    <view wx:elif="{{tab === 'overview' && scope.view === 'school'}}">
      <view wx:if="{{!schoolDetail}}">
        <view class="lr-card lr-hero">
          <view class="lr-title">校级学习覆盖</view>
          <view class="lr-muted">{{periodStart}} 至 {{asOf}}</view>
          <view class="lr-metrics">
            <view><text>{{recordedClasses}} / {{classComparisons.length}}</text>有学习记录的班级</view>
            <view><text>{{learned}} / {{enrolled}}</text>有学伴学习记录</view>
          </view>
        </view>
        <view class="lr-card"><view class="lr-strong">各班学习覆盖</view>
          <view wx:for="{{classComparisons}}" wx:key="id" class="lr-row" data-id="{{item.id}}" bindtap="changeClass"><view>{{item.name}}</view><text class="lr-action">{{item.learned}} / {{item.enrolled}} 人有记录 ›</text></view>
        </view>
        <view class="lr-card"><view class="lr-strong">应用使用</view><view>{{used}} 名学生有应用使用记录</view></view>
      </view>
      <view wx:else>
        <view class="lr-card lr-hero"><view class="lr-title">{{filterSummary}}</view><view class="lr-muted">{{periodStart}} 至 {{asOf}}</view>
          <view class="lr-metrics"><view><text>{{enrolled}} 人</text>在册</view><view><text>{{learned}} 人</text>有学伴学习记录</view><view><text>{{enrolled - learned}} 人</text>暂无学伴学习记录</view></view>
        </view>
        <view class="lr-card"><view class="lr-strong">各科学习覆盖</view><view wx:for="{{subjects}}" wx:key="subject" class="lr-row"><text>{{item.subject}}</text><text>{{item.people}} / {{enrolled}} 人有记录</text></view><view wx:if="{{!subjects.length}}" class="lr-muted">所选区间暂无学科学习记录</view></view>
        <view class="lr-card"><view class="lr-strong">学习活动来源</view><view wx:for="{{schoolActivitySources}}" wx:key="name" class="lr-row"><text>{{item.name}}</text><text>{{item.count}} 项活动</text></view><view wx:if="{{!schoolActivitySources.length}}" class="lr-muted">所选区间暂无学习活动</view></view>
      </view>
    </view>
    <view wx:elif="{{tab === 'students'}}"><view class="tl-section">{{scope.view !== 'school' ? filterSummary + ' · ' + enrolled + ' 人' : '当前范围 · ' + enrolled + ' 名学生'}}</view><view class="tl-caption">{{periodStart}} 至 {{asOf}}</view><input wx:if="{{scope.view !== 'school'}}" class="tl-student-search" placeholder="按姓名查找学生" value="{{rosterName}}" bindinput="searchRoster" /><view wx:if="{{scope.view === 'subject'}}" class="lr-tabs"><button class="{{rosterFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="filterRoster">全班 {{enrolled}}</button><button class="{{rosterFilter === 'wrong' ? 'active' : ''}}" data-filter="wrong" bindtap="filterRoster">答错学生 {{wrongPeople}}</button></view><view wx:if="{{!visibleStudents.length}}" class="tl-empty">{{rosterName ? '没有匹配的学生' : '当前范围暂无学生'}}</view><view wx:else class="tl-card"><view wx:for="{{visibleStudents}}" wx:key="studentId" class="tl-row tl-list-row" data-id="{{item.studentId}}" bindtap="openStudent"><view><view class="tl-strong">{{item.name}}</view><view wx:if="{{scope.view === 'subject'}}" class="tl-muted">{{item.counts.totalCount ? '答对 ' + item.counts.correctCount + ' 道 · 答错 ' + item.counts.wrongCount + ' 道 · 有订正 ' + item.counts.correctedCount + ' 道' : '所选区间暂无作答记录'}}</view><view wx:else class="tl-muted">{{item.className}} · {{item.learned ? item.minutes + ' 分钟 · ' + item.days + ' 天' : item.used ? '仅有使用记录' : '暂无使用记录'}}</view></view><view class="tl-blue">查看 ›</view></view></view></view>
    <view wx:elif="{{tab === 'questions'}}"><view class="tl-stats"><view><text>{{firstQuestions}}</text>首次作答题次</view><view><text>{{answeredStudents}}</text>作答学生</view><view><text>{{wrongPeople}}</text>首次答错学生</view></view><view class="tl-caption">错误涉及人数只表示有首次答错记录，不等于未掌握；作业批改题次不混入自主练习。</view><view class="tl-section">知识点与题目</view><view wx:for="{{knowledge}}" wx:key="key" class="tl-card tl-knowledge" data-key="{{item.key}}" bindtap="openKnowledge"><view class="tl-row"><view class="tl-strong">{{item.subject}} · {{item.knowledge || '知识点暂未明确'}}</view><view class="tl-blue">查看 ›</view></view><view class="tl-muted">{{item.students}} 人练过 · {{item.questions}} 道题 · 首次错误涉及 {{item.wrongPeople}} 人</view><view wx:if="{{selectedKnowledge === item.key}}" class="tl-question-list"><view wx:for="{{questionEvidence}}" wx:for-item="question" wx:key="id" class="tl-question-entry" data-id="{{question.id}}" catchtap="openQuestion"><view class="tl-strong">{{question.label}}</view><view class="tl-muted">{{question.answered}} 人作答，{{question.wrong}} 人首次答错 · 看原题与学生 ›</view></view></view></view><view wx:if="{{!knowledge.length}}" class="tl-empty">当前范围暂无逐题作答。</view></view>
    <view wx:else><view class="tl-stats"><view><text>{{minutes}}</text>学习分钟</view><view><text>{{timeDays}}</text>有记录日期</view><view><text>{{timeRows.length}}</text>学习活动</view></view><view class="tl-caption">按发生时间倒序展示当前筛选范围内的真实学习活动；小晤问答不计学习时长。</view><view class="tl-section">时间记录</view><view wx:if="{{timeRows.length}}" class="tl-card"><view wx:for="{{timeRows}}" wx:key="id" class="tl-event"><view class="tl-row"><view><view class="tl-strong">{{item.date}} {{item.start}}</view><view class="tl-muted">{{item.studentName}} · {{item.className}} · {{item.subject}}</view></view><view class="tl-blue">{{item.minutes}} 分钟</view></view><view class="tl-muted">{{item.feature}} · {{item.title}} · {{item.status}}</view></view></view><view wx:else class="tl-empty">当前范围暂无学习活动。</view></view>
  </view>
  <view wx:if="{{!correctionRoute && !selectedStudentId && !followup && !subjectPage && !(scope.view === 'subject' && tab === 'students')}}" class="tl-business-nav"><view class="active">学情</view><view bindtap="openHomework">作业</view></view>
  <view wx:if="{{selectedPair}}" class="tl-detail-mask" bindtap="closePair"><view class="tl-detail" catchtap="noop">
    <view class="tl-detail-head"><view class="tl-strong">{{selectedPair.name}} · 两次作答</view><view bindtap="closePair">关闭 ×</view></view>
    <view class="lr-evidence"><view class="lr-strong">{{selectedPair.before.date}} · {{selectedPair.before.step}}</view><view>{{selectedPair.before.stem}}</view><view>学生作答：{{selectedPair.before.answer}}</view><view>{{selectedPair.before.result}}</view></view>
    <view class="lr-evidence"><view class="lr-strong">{{selectedPair.after.date}} · {{selectedPair.after.step}}</view><view>{{selectedPair.after.stem}}</view><view>学生作答：{{selectedPair.after.answer}}</view><view>{{selectedPair.after.result}}</view></view>
    <button wx:if="{{!selectedStudentId}}" class="lr-link" data-id="{{selectedPair.studentId}}" bindtap="openStudent">查看学生个人学情 ›</button>
  </view></view>
  <view wx:if="{{selectedQuestion}}" class="tl-detail-mask" bindtap="closeQuestion"><view class="tl-detail" catchtap="noop"><view class="tl-detail-head"><view class="tl-strong">{{selectedQuestion.title}}</view><view bindtap="closeQuestion">关闭 ×</view></view><view class="tl-question-entry"><view class="tl-strong">{{selectedQuestion.stem}}</view><view class="tl-muted">参考答案：{{selectedQuestion.reference}}</view><view class="tl-muted">{{selectedQuestion.version}} · {{selectedQuestion.scoring}}</view></view><view wx:if="{{selectedQuestion.rows.length}}" class="tl-section">首次作答与订正</view><view wx:for="{{selectedQuestion.rows}}" wx:key="studentId" class="tl-question-entry" data-id="{{item.studentId}}" bindtap="openStudent"><view class="tl-row"><view class="tl-strong">{{item.name}}</view><view class="tl-blue">查看学生 ›</view></view><view class="tl-muted">首次作答：{{item.answer}} · {{item.result}}</view><view class="tl-muted">{{item.correction}}</view></view></view></view>
  <view wx:if="{{selectedActivity}}" class="tl-detail-mask" bindtap="closeActivity"><view class="tl-detail" catchtap="noop"><view class="tl-detail-head"><view class="tl-strong">{{selectedActivity.activity.feature}} · 活动详情</view><view bindtap="closeActivity">关闭 ×</view></view><view class="tl-muted">{{selectedActivity.date}} {{selectedActivity.activity.start}} · {{selectedActivity.activity.title}} · {{selectedActivity.activity.minutes}} 分钟 · {{selectedActivity.activity.status}}</view><view class="tl-section">原题与作答</view><view wx:if="{{selectedActivity.questions.length}}"><view wx:for="{{selectedActivity.questions}}" wx:key="id" class="tl-question-entry"><view class="tl-strong">{{item.stem}}</view><view class="tl-muted">{{item.kind}}作答：{{item.answer}} · {{item.result}}</view><view class="tl-muted">参考答案：{{item.reference}} · {{item.scoring}}</view><view class="tl-muted">{{item.version}}</view></view></view><view wx:else class="tl-muted">本次活动没有关联逐题作答。</view></view></view>
</view>
