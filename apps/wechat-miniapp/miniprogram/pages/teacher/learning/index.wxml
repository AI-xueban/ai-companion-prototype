<import src="correction.wxml" />
<template name="materialMetrics">
  <view class="ml-metrics"><view class="ml-metric"><text class="ml-number">{{v.stats.people}}/{{v.enrolled}}</text><text class="ml-caption">有判定学生</text></view><view class="ml-metric"><text class="ml-number">{{v.stats.questions}}<text class="ml-unit">道</text></text><text class="ml-caption">有判定题目</text></view><view class="ml-metric"><text class="ml-number">{{v.stats.attempts}}<text class="ml-unit">次</text></text><text class="ml-caption">有效作答</text></view></view>
</template>
<template name="materialPage">
  <view class="ml-learning {{materialCompact ? 'ml-scrolled' : ''}}">
    <view wx:if="{{m.question}}" class="ml-sticky-context" style="top:{{personalNavHeight}}px"><button bindtap="materialTop">查看原题 ↑</button><view>{{m.question.source.name}} · {{m.question.title}}</view><text>{{m.question.people}}人有判定 · {{m.question.wrongPeople}}人答错 · {{m.question.pendingPeople}}人待复核</text></view>
    <view class="ml-context">{{filterSummary}}</view>
    <view wx:if="{{m.kind === 'stage'}}" class="ml-period"><button wx:for="{{[1,7,14,30]}}" wx:key="*this" class="{{route.days === item ? 'ml-on' : ''}}" data-days="{{item}}" bindtap="changeSubjectIssuePeriod">{{item === 1 ? '今天' : '近' + item + '天'}}</button></view>
    <view class="ml-date">{{date}}</view>
    <block wx:if="{{m.kind === 'stage'}}">
      <view class="ml-card"><view class="ml-card-head"><view class="ml-h2">阶段作答概况</view></view><template is="materialMetrics" data="{{v:m}}" /><view class="ml-mini-line">答对 {{m.stats.correct}} 题次 · 答错 {{m.stats.wrongAttempts}} 题次</view><view class="ml-coverage"><view wx:if="{{m.stats.questions}}">{{m.stats.questions}}道题中，{{m.stats.linked}}道已明确知识点，{{m.stats.questions - m.stats.linked}}道暂未明确。</view><view wx:else>当前时段暂无有判定的题目。</view><button wx:if="{{m.stats.questions > m.stats.linked}}" class="ml-coverage-action" data-route="{{m.unknownRoute}}" bindtap="openSubjectRoute">查看这{{m.stats.questions - m.stats.linked}}道题 ›</button></view><view wx:if="{{m.stats.pending}}" class="ml-quiet">另有 {{m.stats.pending}} 条作答待复核，未计入以上结果</view></view>
      <view class="ml-view-tabs"><button class="{{m.mode === 'source' ? 'ml-on' : ''}}" data-mode="source" bindtap="changeMaterialMode">作业与练习</button><button class="{{m.mode === 'knowledge' ? 'ml-on' : ''}}" data-mode="knowledge" bindtap="changeMaterialMode">知识点</button></view>
      <view wx:if="{{m.mode === 'source'}}" class="ml-card"><button wx:for="{{m.sources}}" wx:key="id" class="ml-source-row" data-route="{{item.route}}" bindtap="openSubjectRoute"><view class="ml-source-top"><text class="ml-source-icon">{{item.kind === '上传资料' ? '▤' : '✎'}}</text><text class="ml-strong">{{item.name}}</text><text class="ml-chevron">›</text></view><view class="ml-sub">{{item.date}} · {{item.kind}}</view><view class="ml-source-stats"><text>{{item.stats.questions}}道题有判定</text><text class="ml-blue">{{item.stats.wrongQuestions}}道有误 · {{item.stats.bad}}人答错</text></view><view wx:if="{{item.stats.questions > item.stats.linked}}" class="ml-quiet">{{item.stats.questions - item.stats.linked}}道题的知识点暂未明确</view><view wx:if="{{!item.stats.questions && item.stats.pending}}" class="ml-quiet">结果待复核，暂不统计对错</view></button><view wx:if="{{!m.sources.length}}" class="ml-empty">当前时段暂无作答记录</view></view>
      <view wx:else class="ml-card"><view class="ml-card-head"><view class="ml-h2">知识点情况</view><text class="ml-sub">覆盖 {{m.stats.linked}}/{{m.stats.questions}} 道题</text></view><view class="ml-quiet">仅统计知识点已明确的题目</view><button wx:if="{{m.unknownStats.questions}}" class="ml-unknown-entry" data-route="{{m.unknownRoute}}" bindtap="openSubjectRoute"><view><view class="ml-strong">知识点暂未明确的题目</view><text class="ml-small">已有判定结果，可按来源查看</text></view><text class="ml-blue">{{m.unknownStats.questions}}道 ›</text></button><button wx:for="{{m.groups}}" wx:key="name" class="ml-knowledge-row" data-route="{{item.route}}" bindtap="openSubjectRoute"><view><view class="ml-strong">{{item.name}}</view><text class="ml-small">{{item.stats.people}}人有判定 · {{item.stats.questions}}道题 · 答对{{item.stats.correct}}/{{item.stats.attempts}}题次</text></view><text class="ml-blue">查看题目 ›</text></button><view wx:if="{{!m.groups.length}}" class="ml-empty">暂无可分析的知识点结果，可按作业与练习查看题目</view></view>
      <view class="ml-card"><button class="ml-entry" bindtap="openStageRoster"><text>查看本阶段学生学情</text><text class="ml-blue">{{m.enrolled}}人 ›</text></button></view>
    </block>
    <block wx:elif="{{m.kind === 'list'}}">
      <view wx:if="{{m.sourceId}}" class="ml-card"><view class="ml-h2">{{m.source.name || '作业与练习'}}</view><view class="ml-sub">{{m.source.kind}} · {{m.source.date}}</view><view class="ml-mini-line">{{m.selectionStats.questions}}道题有判定 · {{m.selectionStats.wrongQuestions}}道有误 · {{m.selectionStats.bad}}人答错</view></view>
      <view class="ml-result-tabs ml-question-tabs"><button class="{{!m.onlyWrong ? 'ml-on' : ''}}" data-route="{{m.allRoute}}" bindtap="changeMaterialList">全部 {{m.matches.length}}</button><button class="{{m.onlyWrong ? 'ml-on' : ''}}" data-route="{{m.wrongRoute}}" bindtap="changeMaterialList">有学生答错 {{m.selectionStats.wrongQuestions}}</button></view>
      <block wx:for="{{m.sources}}" wx:key="id" wx:for-item="source"><view wx:if="{{!m.sourceId}}" class="ml-list-heading"><text class="ml-strong">{{source.name}}</text><text>{{source.date}} · {{source.questions.length}}道</text></view><view wx:for="{{source.questions}}" wx:key="id" class="ml-question-card"><view class="ml-q-label"><text>{{item.title}}</text><text class="ml-tag">{{item.knowledge || '知识点暂未明确'}}</text></view><view class="ml-q-stem">{{item.stem}}</view><view class="ml-q-foot"><text>{{item.people}}人有判定 · {{item.wrongPeople}}人答错</text><button class="ml-link" data-route="{{item.route}}" bindtap="openSubjectRoute">查看学生 ›</button></view><view wx:if="{{item.pendingPeople}}" class="ml-quiet">{{item.pendingPeople}}人待复核，未计入对错人数</view></view></block><view wx:if="{{!m.visible.length}}" class="ml-empty">当前范围暂无题目</view>
    </block>
    <block wx:elif="{{m.question}}">
      <view class="ml-card"><view class="ml-q-label"><text>{{m.question.title}}</text><text class="ml-tag">{{m.question.source.kind}}</text></view><view class="ml-sub">{{m.question.source.name}}</view><view class="ml-q-stem">{{m.question.stem}}</view><view class="ml-q-meta"><text class="ml-tag">{{m.question.knowledge || '知识点暂未明确'}}</text></view><view class="ml-reference">参考答案　{{m.question.reference}}</view></view>
      <view class="ml-card"><view class="ml-counts-row"><view><text class="ml-number">{{m.question.people}}</text><text class="ml-caption">人有有效判定</text></view><view class="ml-amber"><text class="ml-number">{{m.question.wrongPeople}}</text><text class="ml-caption">人答错</text></view><view><text class="ml-number">{{m.question.pendingPeople}}</text><text class="ml-caption">人待复核</text></view></view><view class="ml-quiet">待复核不计入对错；答错学生中{{m.question.correctedPeople}}人有订正记录。</view></view>
      <view class="ml-card"><view class="ml-card-head"><view class="ml-h2">学生作答</view><text class="ml-sub">点姓名展开</text></view><view class="ml-result-tabs"><button wx:for="{{m.resultOptions}}" wx:key="key" class="{{materialResult === item.key ? 'ml-on' : ''}}" data-key="{{item.key}}" bindtap="changeMaterialResult">{{item.label}} {{item.count}}</button></view><input class="ml-search" placeholder="按姓名查找学生" value="{{questionSearch}}" bindinput="searchQuestionStudents" /><view class="ml-filter-line"><text>当前显示 {{questionStudents.length}} 人</text><picker range="{{['全部订正状态','暂无订正','订正仍错','订正答对']}}" value="{{questionFilterIndex}}" bindchange="filterQuestionStudents"><text class="ml-blue">{{questionFilter === 'all' ? '全部订正状态' : questionFilter === 'missing' ? '暂无订正' : questionFilter === 'still' ? '订正仍错' : '订正答对'}} ⌄</text></picker></view>
        <view wx:for="{{questionStudents}}" wx:key="id" class="ml-student-row"><button class="ml-student-toggle" data-id="{{item.id}}" bindtap="toggleAnswerStudent"><view><view class="ml-strong">{{item.name}}</view><text class="ml-small">{{item.date}} · {{item.chains.length ? (item.wrong ? '答错' : '答对') : '待复核'}}</text></view><view class="ml-student-right"><text class="ml-tag ml-{{item.status}}">{{item.statusLabel}}</text><text>{{expandedStudentId === item.id ? '⌃' : '⌄'}}</text></view></button><block wx:if="{{expandedStudentId === item.id}}"><block wx:for="{{item.chains}}" wx:key="id" wx:for-item="chain"><view class="ml-answer-pair"><view><text class="ml-small">{{chain.date}} {{chain.time}} · 作答</text><view class="ml-answer {{chain.correct ? 'ml-good' : ''}}">{{chain.answer}}</view><text class="ml-small">{{chain.correct ? '答对' : '答错'}}</text></view><text class="ml-arrow">→</text><view><text class="ml-small">{{chain.latest ? chain.latest.date + ' ' + chain.latest.time + ' · 订正' : '订正'}}</text><view class="ml-answer {{chain.latest.correct ? 'ml-good' : ''}}">{{chain.latest ? chain.latest.answer : '—'}}</view><text class="ml-small">{{chain.latest ? (chain.latest.correct ? '本次答对' : '本次仍错') : '暂无订正记录'}}</text></view></view><button wx:if="{{chain.corrections.length > 1}}" class="ml-link" data-id="{{chain.id}}" bindtap="toggleCorrectionHistory">{{correctionHistoryId === chain.id ? '收起' : '查看全部 ' + chain.corrections.length + ' 次订正'}} ›</button><block wx:if="{{correctionHistoryId === chain.id}}"><view wx:for="{{chain.corrections}}" wx:key="id" class="ml-reference">{{item.date}} {{item.time}} · {{item.answer}} · {{item.correct ? '答对' : '仍错'}}</view></block></block><view wx:for="{{item.pendingAttempts}}" wx:key="id" wx:for-item="pending" class="ml-reference">{{pending.date}} {{pending.time}} · 待复核<view>{{pending.answer}}</view>不计入对错</view><button class="ml-student-personal" data-id="{{item.id}}" bindtap="openStudent">查看{{item.name}}个人学情 ›</button></block></view><view wx:if="{{!questionStudents.length}}" class="ml-empty">没有符合条件的学生</view>
      </view>
    </block>
    <view wx:else class="ml-empty">当前时段暂无本题作答</view>
  </view>
</template>

<template name="subjectAnswerChains">
  <view wx:for="{{chains}}" wx:for-item="chain" wx:key="id" class="tl-answer-chain">
    <view wx:if="{{chains.length > 1}}" class="lr-muted">作答记录 {{index + 1}}</view>
    <view class="tl-answer-block"><view class="tl-answer-block-head"><text>首次作答</text><text class="tl-answer-status {{chain.correct ? 'fixed' : 'still'}}">{{chain.correct ? '答对' : '答错'}}</text></view><view class="lr-muted">{{chain.date}} {{chain.time}}</view><view>{{chain.answer}}</view></view>
    <view wx:if="{{chain.latest}}" class="tl-answer-block"><view class="tl-answer-block-head"><text>最近一次订正</text><text class="tl-answer-status {{chain.latest.correct ? 'fixed' : 'still'}}">{{chain.latest.correct ? '答对' : '仍错'}}</text></view><view class="lr-muted">{{chain.latest.date}} {{chain.latest.time}}</view><view>{{chain.latest.answer}}</view></view>
    <view wx:else class="lr-muted">暂无订正记录</view>
    <button wx:if="{{chain.corrections.length > 1}}" class="lr-link" data-id="{{chain.id}}" bindtap="toggleCorrectionHistory">{{correctionHistoryId === chain.id ? '收起订正记录' : '查看全部 ' + chain.corrections.length + ' 次订正'}} ›</button>
    <block wx:if="{{correctionHistoryId === chain.id}}"><view wx:for="{{chain.corrections}}" wx:for-item="correction" wx:key="id" class="tl-answer-block"><view class="tl-answer-block-head">第 {{index + 1}} 次订正 · {{correction.pending ? '结果待确认' : correction.correct ? '答对' : '仍错'}}</view><view class="lr-muted">{{correction.date}} {{correction.time}}</view><view>{{correction.answer}}</view></view></block>
  </view>
</template>
<page-navigation title="{{correctionPage && !correctionLegacy && !selectedStudentId && !subjectPage && (correctionRoute || tab === 'overview') ? correctionPage.title : schoolDetail ? '班级学习覆盖' : selectedStudentId ? '学生个人学情' : subjectPage ? subjectPage.title : followup ? '周报跟进名单' : (scope.view !== 'school' && tab === 'students') ? '学生学情' : '学情'}}" back="{{(correctionRoute && !correctionLegacy) || schoolDetail || !!selectedStudentId || !!subjectPage || followup || (scope.view !== 'school' && tab === 'students')}}" home="{{(correctionRoute && !correctionLegacy) || schoolDetail || !!selectedStudentId || !!subjectPage || followup || (scope.view !== 'school' && tab === 'students')}}" home-label="回到学情首页" bind:back="backFromDetail" bind:home="returnToModuleHome" />
<view class="teacher-learning lr-teacher">
  <view wx:if="{{!correctionRoute && !selectedStudentId && !followup && !subjectPage && !(scope.view !== 'school' && tab === 'students')}}" class="tl-head"><view class="tl-head-row"><view class="tl-greeting"><view class="tl-greeting-line">Hi，{{greetingName}}</view><view class="tl-greeting-meta">{{schoolName}} · {{teacherDesignation}}</view></view><view wx:if="{{roleMenuOpen}}" class="tl-role-dismiss" bindtap="closeRoleMenu"></view><view wx:if="{{!selectedStudentId && views.length > 1}}" class="tl-role-picker"><view class="tl-role-badge" bindtap="toggleRoleMenu">{{viewLabel}}<view class="tl-role-chevron {{roleMenuOpen ? 'open' : ''}}"></view></view><view wx:if="{{roleMenuOpen}}" class="tl-role-menu"><view class="tl-role-menu-label">切换到</view><view wx:for="{{switchableViews}}" wx:key="id" class="tl-role-option" data-view="{{item.id}}" bindtap="changeView">{{item.label}}<text>›</text></view></view></view></view><view wx:if="{{selectedStudentId}}" class="tl-title">{{selectedStudentName}}的学习记录</view><view wx:if="{{selectedStudentId}}" class="tl-sub">{{scopeLabel}} · {{scope.period === '7d' ? '近 7 天' : '近 30 天'}}</view></view>
  <view wx:if="{{correctionPage && !correctionLegacy && (correctionRoute || (tab === 'overview' && !selectedStudentId && !subjectPage && !followup))}}">
    <block wx:if="{{!correctionRoute}}">
      <view wx:if="{{scope.view === 'subject'}}" class="cl-class-tabs"><view class="cl-class-options"><button wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="moveSubjectClass" class="{{item.selected ? 'active' : ''}}">{{item.name}}</button></view><picker range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="changeLearningSubject"><view>{{subjectOptions[subjectIndex]}} ⌄</view></picker></view>
      <view wx:else class="cl-class-tabs"><text>{{filterSummary}} · 全科</text><picker wx:if="{{scope.view === 'school'}}" range="{{['全校','七年级','八年级']}}" bindchange="changeCorrectionGrade"><view>年级 ⌄</view></picker><picker wx:if="{{scope.view === 'school'}}" range="{{correctionScopeNames}}" bindchange="changeCorrectionClass"><view>切换范围 ⌄</view></picker></view>
    </block>
    <template is="correctionPage" data="{{m:correctionPage}}" />
  </view>
  <view wx:elif="{{selectedStudentId && scope.view === 'subject' && personalView}}" class="pl-personal" style="padding-bottom:{{personalBottomSpace}}px">
    <view wx:if="{{personalCompact}}" class="pl-compact" style="top:{{personalNavHeight}}px"><view class="pl-compact-line"><text>{{selectedStudentName}} · {{personalClassName}} · {{scope.learningSubject}}</text><text bindtap="personalToTop">{{personalView.label}} ⌃</text></view><view class="pl-compact-date">{{personalRange.start}} 至 {{personalRange.end}}</view></view>
    <view class="pl-identity"><view class="pl-avatar">{{personalInitial}}</view><view><view class="pl-name">{{selectedStudentName}}</view><view class="pl-subline">{{personalClassName}}</view></view><text class="pl-subject">{{scope.learningSubject}}</text></view>
    <view class="pl-range-control"><view class="pl-seg"><button wx:for="{{personalModes}}" wx:key="id" class="{{personalRange.mode === item.id || (item.id === 'custom' && (personalRange.mode === '1d' || personalRange.mode === '14d')) ? 'pl-active' : ''}}" data-mode="{{item.id}}" bindtap="changePersonalMode">{{item.label}}</button></view><view class="pl-period-caption">{{personalRange.start}} 至 {{personalRange.end}}</view><view class="pl-micro-note">订正进展截至 {{personalView.correctionAsOf}}</view></view>
    <view wx:if="{{!personalView.complete}}" class="pl-demo-notice">当前只有 {{dates[29]}} 至 {{dates[0]}} 的记录，暂不生成完整学期结论。</view>
    <view class="pl-card"><view class="pl-section-head"><view class="pl-heading pl-rail">时段总览</view><text>{{personalView.label}}</text></view><view class="pl-subline">{{personalView.complete ? '练过 ' + personalView.summary.totalCount + ' 道题 · 涉及 ' + personalView.topics.length + ' 个知识点' : '当前尚无完整学期统计'}}</view><view class="pl-metrics">
      <button class="pl-metric" data-filter="correct" data-reset="true" bindtap="selectPersonalFilter"><view class="pl-number">{{personalView.complete ? personalView.summary.correctCount : '—'}}<text>道</text></view><view class="pl-metric-label">答对<text>›</text></view></button>
      <button class="pl-metric pl-wrong" data-filter="wrong" data-reset="true" bindtap="selectPersonalFilter"><view class="pl-number">{{personalView.complete ? personalView.summary.wrongCount : '—'}}<text>道</text></view><view class="pl-metric-label">答错<text>›</text></view></button>
      <button class="pl-metric pl-corrected" data-filter="corrected" data-reset="true" bindtap="selectPersonalFilter"><view class="pl-number">{{personalView.complete ? personalView.summary.correctedCount : '—'}}<text>道</text></view><view class="pl-metric-label">有订正<text>›</text></view></button>
    </view><view class="pl-micro-note">有订正包含结果待确认的提交，不抵扣答错题数。</view><view wx:if="{{personalView.unknownCount}}" class="pl-micro-note">其中 {{personalView.unknownCount}} 道题的知识点暂未明确，已计入总览。</view></view>
    <view class="pl-card"><view class="pl-section-head"><view class="pl-heading">知识点情况</view><text>全部练过的知识点</text></view>
      <block wx:if="{{personalView.topics.length}}"><view class="pl-table-row pl-table-head"><text>知识点</text><text>答对</text><text>答错</text><text>有订正</text><text></text></view><view wx:for="{{personalView.topics}}" wx:key="name" class="pl-table-row" data-index="{{index}}" bindtap="selectPersonalKnowledge"><text>{{item.name}}</text><text>{{item.correct}}</text><text class="pl-wrong-number">{{item.wrong}}</text><text class="pl-fixed-number">{{item.corrected}}</text><text>›</text></view><view class="pl-micro-note">数量单位：道 · 点知识点查看对应题目</view></block>
      <view wx:else class="pl-empty">{{personalView.complete ? (personalView.unknownCount ? '已有作答结果，知识点暂未明确' : '这个时段暂无作答记录') : '完整学期数据暂缺'}}</view>
    </view>
    <view class="pl-card" id="personal-questions"><view class="pl-section-head"><view class="pl-heading">题目与作答</view><text>{{personalView.visible.length}} 道题</text></view><view class="pl-q-tabs"><button wx:for="{{personalFilters}}" wx:key="id" class="{{personalFilter === item.id ? 'pl-active' : ''}}" data-filter="{{item.id}}" bindtap="selectPersonalFilter">{{item.label}} {{personalView.counts[item.id]}}</button></view><view class="pl-topic-select"><text>知识点</text><picker range="{{personalView.topicOptions}}" value="{{personalTopicIndex}}" bindchange="changePersonalTopic"><view>{{personalView.topicOptions[personalTopicIndex]}} ⌄</view></picker></view>
      <view wx:for="{{personalView.visible}}" wx:for-item="question" wx:key="id" class="pl-qrow">
        <view data-id="{{question.id}}" bindtap="togglePersonalQuestion"><view class="pl-qhead"><text>{{question.knowledge || '知识点暂未明确'}}</text><text class="pl-tag {{question.students[0].status === 'fixed' ? 'pl-fixed' : ''}}">{{question.students[0].statusLabel}} ⌄</text></view><view wx:if="{{question.source}}" class="pl-small">{{question.source.name}} · 第{{question.source.number}}题</view><view class="pl-qstem">{{question.stem}}</view></view>
        <block wx:if="{{personalQuestionId === question.id}}"><view class="pl-small">{{question.students[0].date}} · {{question.students[0].wrong ? '答错' : '答对'}}</view>
          <block wx:for="{{question.students[0].chains}}" wx:for-item="chain" wx:key="id"><view wx:if="{{question.students[0].chains.length > 1}}" class="pl-subline">作答记录 {{index + 1}}</view><view class="pl-pair"><view class="pl-answer"><view class="pl-small">{{chain.date}} {{chain.time}} · 作答</view><view class="pl-answer-value {{chain.answer.length > 12 ? 'pl-long' : ''}}">{{chain.answer}}</view><view class="pl-small">{{chain.correct ? '答对' : '答错'}}</view></view><text class="pl-arrow">→</text><view class="pl-answer"><view class="pl-small">{{chain.latest ? chain.latest.date + ' ' + chain.latest.time + ' · 订正' : '订正'}}</view><view class="pl-answer-value {{chain.latest.correct ? 'pl-fixed' : ''}} {{chain.latest.answer.length > 12 ? 'pl-long' : ''}}">{{chain.latest ? chain.latest.answer : '—'}}</view><view class="pl-small">{{chain.latest ? chain.latest.pending ? '结果待确认' : chain.latest.correct ? '本次答对' : '本次仍错' : '暂无记录'}}</view></view></view>
          <view wx:if="{{chain.corrections.length > 1}}" class="pl-history"><view data-id="{{chain.id}}" bindtap="toggleCorrectionHistory">全部 {{chain.corrections.length}} 次订正 ⌄</view><view wx:if="{{correctionHistoryId === chain.id}}"><view wx:for="{{chain.corrections}}" wx:for-item="correction" wx:key="id">{{correction.date}} {{correction.time}} · {{correction.answer}} · {{correction.correct ? '答对' : '仍错'}}</view></view></view></block>
          <view class="pl-reference">参考答案　{{question.reference}}</view>
        </block>
      </view>
      <view wx:if="{{!personalView.visible.length}}" class="pl-empty">{{!personalView.complete ? '完整学期数据暂缺' : personalFilter === 'all' ? '这个时段暂无作答记录' : personalFilter === 'correct' ? '这个时段暂无答对记录' : personalFilter === 'wrong' ? '这个时段暂无答错记录' : '这个时段暂无订正记录'}}</view>
    </view>
    <view class="pl-card"><view class="pl-activities" bindtap="togglePersonalActivities">{{personalActivitiesOpen ? '⌄' : '▸'}} 其他学习活动 · {{personalView.complete ? personalView.activities.length : '—'}} 项</view><block wx:if="{{personalActivitiesOpen}}"><view wx:for="{{personalView.activities}}" wx:key="id" class="pl-activity" data-id="{{item.id}}" bindtap="openActivity"><text>{{item.date}} · {{item.feature}}</text><text>查看 ›</text></view></block></view>
