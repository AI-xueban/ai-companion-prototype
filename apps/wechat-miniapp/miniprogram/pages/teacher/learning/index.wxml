<view class="teacher-learning">
  <view class="tl-head"><view class="tl-head-row"><view class="tl-greeting"><view class="tl-greeting-line">Hi，{{greetingName}}</view><view class="tl-greeting-meta">{{schoolName}} · {{teacherDesignation}}</view></view><view wx:if="{{roleMenuOpen}}" class="tl-role-dismiss" bindtap="closeRoleMenu"></view><view wx:if="{{!selectedStudentId && views.length > 1}}" class="tl-role-picker"><view class="tl-role-badge" bindtap="toggleRoleMenu">{{viewLabel}}<view class="tl-role-chevron {{roleMenuOpen ? 'open' : ''}}"></view></view><view wx:if="{{roleMenuOpen}}" class="tl-role-menu"><view class="tl-role-menu-label">切换到</view><view wx:for="{{switchableViews}}" wx:key="id" class="tl-role-option" data-view="{{item.id}}" bindtap="changeView">{{item.label}}<text>›</text></view></view></view></view><view wx:if="{{selectedStudentId}}" class="tl-title">{{selectedStudentName}}的学习记录</view><view wx:if="{{selectedStudentId}}" class="tl-sub">{{scopeLabel}} · {{scope.period === '7d' ? '近 7 天' : '近 30 天'}}</view></view>
  <view wx:if="{{selectedStudentId}}">
    <view class="tl-back" bindtap="closeStudent">‹ 返回{{title}}</view>
    <view class="tl-stats"><view><text>{{selectedSummary.minutes}}</text>学习分钟</view><view><text>{{selectedSummary.days}}</text>学习天数</view><view><text>{{selectedSummary.firstCount}}</text>首次作答</view></view>
    <view class="tl-caption">仅显示当前工作视角授权范围内的记录；小晤问答不计学习分钟。</view>
    <view class="tl-section">学习轨迹</view><view wx:if="{{selectedTimeline.length}}" class="tl-card"><view wx:for="{{selectedTimeline}}" wx:key="id" class="tl-event" data-id="{{item.id}}" bindtap="openActivity"><view class="tl-row"><view class="tl-strong">{{item.subject}} · {{item.feature}}</view><view class="tl-blue">{{item.minutes}} 分钟 ›</view></view><view class="tl-muted">{{item.date}} {{item.start}} · {{item.title}}</view><view class="tl-muted">{{item.status}}{{item.answers ? ' · 首次作答 ' + item.answers + ' 题' : ''}}</view></view></view><view wx:else class="tl-empty">当前范围暂无学习活动。</view>
  </view>
  <view wx:else>
    <view class="tl-scope"><view class="tl-condition-row"><view wx:if="{{scope.view !== 'homeroom'}}" class="tl-scope-summary" bindtap="toggleFilters"><text class="tl-scope-key">范围</text><text class="tl-scope-value">{{filterSummary}}</text><view class="tl-scope-arrow {{filtersOpen ? 'open' : ''}}"></view></view><view wx:else class="tl-scope-static"><text class="tl-scope-key">范围</text><text class="tl-scope-value">{{filterSummary}}</text></view><view class="tl-switch tl-period"><view class="{{scope.period === '7d' ? 'active' : ''}}" data-period="7d" bindtap="changePeriod">近 7 天</view><view class="{{scope.period === '30d' ? 'active' : ''}}" data-period="30d" bindtap="changePeriod">近 30 天</view></view></view><view wx:if="{{filtersOpen && scope.view !== 'homeroom'}}" class="tl-scope-options"><view wx:if="{{scope.view === 'school'}}" class="tl-switch"><view class="{{scope.grade === 'all' ? 'active' : ''}}" data-grade="all" bindtap="changeGrade">全校</view><view class="{{scope.grade === 7 ? 'active' : ''}}" data-grade="7" bindtap="changeGrade">七年级</view><view class="{{scope.grade === 8 ? 'active' : ''}}" data-grade="8" bindtap="changeGrade">八年级</view></view><scroll-view wx:if="{{scope.view !== 'homeroom'}}" scroll-x="true" class="tl-class-scroll"><view class="tl-chips"><view wx:if="{{scope.view === 'school'}}" class="tl-chip {{scope.classId === 'all' ? 'active' : ''}}" data-id="all" bindtap="changeClass">全部班级</view><view wx:for="{{classes}}" wx:key="id" class="tl-chip {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeClass">{{item.name}}</view></view></scroll-view></view></view>
    <view class="tl-tabs"><view class="{{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="changeTab">概览</view><view class="{{tab === 'students' ? 'active' : ''}}" data-tab="students" bindtap="changeTab">学生</view><view class="{{tab === 'questions' ? 'active' : ''}}" data-tab="questions" bindtap="changeTab">题目</view><view class="{{tab === 'time' ? 'active' : ''}}" data-tab="time" bindtap="changeTab">时间</view></view>
    <view wx:if="{{tab === 'overview'}}">
      <view class="tl-hero"><view class="tl-hero-label">{{scope.view === 'school' ? '学校学习覆盖' : scope.view === 'homeroom' ? '本班学习参与' : '任教学科学习参与'}}</view><view class="tl-hero-rate">{{coverage}}%</view><view class="tl-hero-note">{{learned}} / {{enrolled}} 人发生学习 · {{scope.period === '7d' ? '近 7 天' : '近 30 天'}}</view></view>
      <view wx:if="{{scope.view === 'school'}}" class="tl-focus"><view class="tl-focus-kicker">校级优先看</view><view class="tl-section">班级覆盖差异 · 从低到高</view><view wx:if="{{classComparisons.length}}" class="tl-card"><view wx:for="{{classComparisons}}" wx:key="id" class="tl-row tl-list-row" data-id="{{item.id}}" bindtap="changeClass"><view><view class="tl-strong">{{item.name}}</view><view class="tl-muted">{{item.learned}} / {{item.enrolled}} 人发生学习</view></view><view class="tl-blue">{{item.coverage}}% ›</view></view></view><view wx:else class="tl-empty">当前已选具体班级，可查看学生明细。</view></view>
      <view wx:elif="{{scope.view === 'homeroom'}}" class="tl-focus"><view class="tl-focus-kicker">班主任优先看</view><view class="tl-section">需要核对的学生</view><view class="tl-caption">仅表示本期未见学伴学习活动，不能推断线下学习情况。</view><view wx:if="{{attentionStudents.length}}" class="tl-card"><view wx:for="{{attentionStudents}}" wx:key="studentId" class="tl-row tl-list-row" data-id="{{item.studentId}}" bindtap="openStudent"><view class="tl-strong">{{item.name}}</view><view class="tl-blue">{{item.used ? '仅有使用记录' : '暂无使用记录'}} ›</view></view></view><view wx:else class="tl-empty">本期本班学生均有学伴学习活动。</view></view>
      <view wx:else class="tl-focus"><view class="tl-focus-kicker">任课老师优先看</view><view class="tl-section">错误集中的知识点</view><view class="tl-caption">按首次答错涉及人数排序，点击查看原题与学生作答。</view><view wx:if="{{focusKnowledge.length}}" class="tl-card"><view wx:for="{{focusKnowledge}}" wx:key="key" class="tl-row tl-list-row" data-key="{{item.key}}" bindtap="openFocusKnowledge"><view><view class="tl-strong">{{item.knowledge}}</view><view class="tl-muted">{{item.students}} 人练过 · {{item.questions}} 道题</view></view><view class="tl-blue">{{item.wrongPeople}} 人首次答错 ›</view></view></view><view wx:else class="tl-empty">当前范围暂无逐题作答。</view></view>
      <view wx:if="{{scope.view === 'school'}}" class="tl-stats"><view><text>{{minutes}}</text>学习分钟</view><view><text>{{used}}</text>应用使用人数</view><view><text>{{answeredStudents}}</text>首次作答学生</view></view>
      <view wx:elif="{{scope.view === 'homeroom'}}" class="tl-stats"><view><text>{{minutes}}</text>学习分钟</view><view><text>{{average}}</text>学习者人均分钟</view><view><text>{{answeredStudents}}</text>首次作答学生</view></view>
      <view wx:else class="tl-stats"><view><text>{{firstQuestions}}</text>首次作答题次</view><view><text>{{wrongPeople}}</text>首次答错学生</view><view><text>{{minutes}}</text>学习分钟</view></view>
      <view wx:if="{{scope.view !== 'subject'}}"><view class="tl-section">各科学习</view><view wx:if="{{subjects.length}}" class="tl-card"><view wx:for="{{subjects}}" wx:key="subject" class="tl-row tl-list-row"><view>{{item.subject}}</view><view class="tl-blue">{{item.people}} 人 · {{item.minutes}} 分钟</view></view></view><view wx:else class="tl-empty">当前范围暂无学习记录。</view></view>
      <view wx:if="{{scope.view === 'school'}}"><view class="tl-section tl-section-between"><view>功能使用</view><view class="tl-mini-switch"><text class="{{rankingBy === 'people' ? 'active' : ''}}" data-by="people" bindtap="changeRanking">人数</text><text class="{{rankingBy === 'count' ? 'active' : ''}}" data-by="count" bindtap="changeRanking">次数</text></view></view><view class="tl-card"><view wx:for="{{ranking}}" wx:key="name" class="tl-row tl-list-row"><view>{{index + 1}}. {{item.name}}</view><view class="tl-blue">{{rankingBy === 'people' ? item.people + ' 人' : item.count + ' 次'}}</view></view><view wx:if="{{!ranking.length}}" class="tl-muted">暂无功能使用记录。</view></view><view class="tl-caption">小晤问答只计应用使用，不计入学习覆盖。</view></view>
    </view>
    <view wx:elif="{{tab === 'students'}}"><view class="tl-section">当前范围 · {{enrolled}} 名学生</view><view class="tl-caption">点击学生查看当前授权范围的学习轨迹。</view><view class="tl-card"><view wx:for="{{students}}" wx:key="studentId" class="tl-row tl-list-row" data-id="{{item.studentId}}" bindtap="openStudent"><view><view class="tl-strong">{{item.name}}</view><view class="tl-muted">{{item.className}} · {{item.learned ? item.minutes + ' 分钟 · ' + item.days + ' 天' : item.used ? '仅有使用记录' : '暂无使用记录'}}</view></view><view class="tl-blue">查看 ›</view></view></view></view>
    <view wx:elif="{{tab === 'questions'}}"><view class="tl-stats"><view><text>{{firstQuestions}}</text>首次作答题次</view><view><text>{{answeredStudents}}</text>作答学生</view><view><text>{{wrongPeople}}</text>首次答错学生</view></view><view class="tl-caption">错误涉及人数只表示有首次答错记录，不等于未掌握；作业批改题次不混入自主练习。</view><view class="tl-section">知识点与题目</view><view wx:for="{{knowledge}}" wx:key="key" class="tl-card tl-knowledge" data-key="{{item.key}}" bindtap="openKnowledge"><view class="tl-row"><view class="tl-strong">{{item.subject}} · {{item.knowledge}}</view><view class="tl-blue">查看 ›</view></view><view class="tl-muted">{{item.students}} 人练过 · {{item.questions}} 道题 · 首次错误涉及 {{item.wrongPeople}} 人</view><view wx:if="{{selectedKnowledge === item.key}}" class="tl-question-list"><view wx:for="{{questionEvidence}}" wx:for-item="question" wx:key="id" class="tl-question-entry" data-id="{{question.id}}" catchtap="openQuestion"><view class="tl-strong">{{question.label}}</view><view class="tl-muted">{{question.answered}} 人作答，{{question.wrong}} 人首次答错 · 看原题与学生 ›</view></view></view></view><view wx:if="{{!knowledge.length}}" class="tl-empty">当前范围暂无逐题作答。</view></view>
    <view wx:else><view class="tl-stats"><view><text>{{minutes}}</text>学习分钟</view><view><text>{{timeDays}}</text>有记录日期</view><view><text>{{timeRows.length}}</text>学习活动</view></view><view class="tl-caption">按发生时间倒序展示当前筛选范围内的真实学习活动；小晤问答不计学习时长。</view><view class="tl-section">时间记录</view><view wx:if="{{timeRows.length}}" class="tl-card"><view wx:for="{{timeRows}}" wx:key="id" class="tl-event"><view class="tl-row"><view><view class="tl-strong">{{item.date}} {{item.start}}</view><view class="tl-muted">{{item.studentName}} · {{item.className}} · {{item.subject}}</view></view><view class="tl-blue">{{item.minutes}} 分钟</view></view><view class="tl-muted">{{item.feature}} · {{item.title}} · {{item.status}}</view></view></view><view wx:else class="tl-empty">当前范围暂无学习活动。</view></view>
  </view>
  <view wx:if="{{!selectedStudentId}}" class="tl-business-nav"><view class="active">学情</view><view bindtap="openHomework">作业</view></view>
  <view wx:if="{{selectedQuestion}}" class="tl-detail-mask" bindtap="closeQuestion"><view class="tl-detail" catchtap="noop"><view class="tl-detail-head"><view class="tl-strong">原题与学生作答</view><view bindtap="closeQuestion">关闭 ×</view></view><view class="tl-question-entry"><view class="tl-strong">{{selectedQuestion.stem}}</view><view class="tl-muted">参考答案：{{selectedQuestion.reference}}</view><view class="tl-muted">{{selectedQuestion.version}} · {{selectedQuestion.scoring}}</view></view><view class="tl-section">首次作答与订正</view><view wx:for="{{selectedQuestion.rows}}" wx:key="studentId" class="tl-question-entry" data-id="{{item.studentId}}" bindtap="openStudent"><view class="tl-row"><view class="tl-strong">{{item.name}}</view><view class="tl-blue">查看学生 ›</view></view><view class="tl-muted">首次作答：{{item.answer}} · {{item.result}}</view><view class="tl-muted">{{item.correction}}</view></view></view></view>
  <view wx:if="{{selectedActivity}}" class="tl-detail-mask" bindtap="closeActivity"><view class="tl-detail" catchtap="noop"><view class="tl-detail-head"><view class="tl-strong">{{selectedActivity.activity.feature}} · 活动详情</view><view bindtap="closeActivity">关闭 ×</view></view><view class="tl-muted">{{selectedActivity.date}} {{selectedActivity.activity.start}} · {{selectedActivity.activity.title}} · {{selectedActivity.activity.minutes}} 分钟 · {{selectedActivity.activity.status}}</view><view class="tl-section">原题与作答</view><view wx:if="{{selectedActivity.questions.length}}"><view wx:for="{{selectedActivity.questions}}" wx:key="id" class="tl-question-entry"><view class="tl-strong">{{item.stem}}</view><view class="tl-muted">{{item.kind}}作答：{{item.answer}} · {{item.result}}</view><view class="tl-muted">参考答案：{{item.reference}} · {{item.scoring}}</view><view class="tl-muted">{{item.version}}</view></view></view><view wx:else class="tl-muted">本次活动没有关联逐题作答。</view></view></view>
</view>
