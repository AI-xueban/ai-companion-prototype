<view class="result-page {{learningMode === 'tutor' ? 'tutor-page' : ''}} {{learningMode === 'result' ? 'grade-page' : ''}} {{role === 'guardian' ? 'parent' : 'teacher'}}">
  <view class="navigation"><view style="height:{{statusBarHeight}}px"></view><view class="nav-row" style="height:{{navBarHeight}}px"><view class="back" bindtap="goBack" aria-label="返回">‹</view><view>{{learningMode === 'tutor' ? '1对1讲题' : learningMode === 'history' ? '讲题记录' : learningMode === 'notebook' ? '孩子的错题本' : role === 'guardian' ? '单题批改结果' : '整份批改结果'}}</view></view></view>
  <view wx:if="{{denied}}" class="card muted">当前账号无权查看此学生的作业结果。</view>
  <block wx:elif="{{learningMode === 'result'}}">
    <view wx:if="{{role === 'teacher'}}" class="eyebrow">{{studentName}} · {{taskTitle}}</view><view wx:if="{{role === 'teacher'}}" class="title">整份批改结果</view>
    <view wx:if="{{role === 'teacher' && progress.total}}" class="status"><view>{{progress.title}}</view><view class="muted">{{progress.pending ? '提交已成功，可离开页面稍后查看；完成时间以实际批改结果为准。' : '仅有效判定计入对错统计。'}}</view></view>
    <view wx:if="{{role === 'teacher'}}" class="metrics"><view><text>{{progress.total}}</text>总题数</view><view><text>{{progress.correct}}</text>答对</view><view><text class="wrong">{{progress.wrong}}</text>答错</view><view><text>{{progress.unavailable}}</text>待处理</view></view>
    <view wx:if="{{!pages.length}}" class="card muted">暂无作业批改结果。</view>
    <block wx:else>
      <view wx:if="{{role === 'teacher'}}" class="section">整份作业 <text class="muted">共 {{pages.length}} 页提交</text></view>
      <view wx:if="{{role === 'teacher' && pages.length > 1}}" class="page-tabs"><view wx:for="{{pages}}" wx:key="id" class="{{item.selected ? 'active' : ''}}" data-index="{{index}}" bindtap="changePage">第 {{index + 1}} 页</view></view>
      <view wx:if="{{role === 'teacher' && !hideOriginal}}" class="card grade-paper-card"><view class="grade-paper-title">{{pages[pageIndex].title}}</view><view wx:if="{{pages[pageIndex].mock}}" class="muted grade-paper-note">演示作业样张 · 点击题目查看对应解析</view>
      <view wx:if="{{pages[pageIndex].path}}" class="marked-paper"><image class="paper-image" src="{{pages[pageIndex].path}}" mode="widthFix" /><block wx:for="{{questions}}" wx:key="id"><view wx:if="{{item.regionStyle}}" class="paper-region {{item.tone}} {{item.selected ? 'selected' : ''}}" style="{{item.regionStyle}}" data-id="{{item.id}}" catchtap="selectQuestion"><text class="paper-mark">{{item.mark}}</text></view></block></view><view wx:else class="muted grade-paper-legend">原图暂不可用。</view><view class="muted grade-paper-legend">✓ 答对　× 答错　? 待复核或存疑；点击题框查看单题。</view><view wx:if="{{!regionCount}}" class="muted grade-paper-legend">题目区域暂未定位，可通过下方题目入口查看。</view><view wx:if="{{pages[pageIndex].path}}" class="link grade-paper-link" bindtap="previewOriginal">查看原图</view>
      </view>
      <view wx:if="{{role === 'teacher'}}" class="section row">逐题查看 <view class="link" bindtap="toggleWrong">{{wrongOnly ? '显示全部' : '只看错题'}}</view></view>
      <view wx:if="{{role === 'teacher'}}" class="chips"><block wx:for="{{questions}}" wx:key="id"><view wx:if="{{!wrongOnly || item.wrong}}" class="{{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectQuestion">{{item.label}} · {{item.result}}</view></block></view>
      <view wx:if="{{role === 'guardian' && selected}}" class="result-stage {{resultSheetFull ? 'is-full-stage' : ''}}" style="height:calc(100vh - {{statusBarHeight + navBarHeight}}px)">
        <scroll-view scroll-y scroll-into-view="{{'paper-q-' + selected.id}}" class="result-photo"><view wx:if="{{pages[pageIndex].path}}" class="result-marked-paper"><image src="{{pages[pageIndex].path}}" mode="widthFix" /><block wx:for="{{questions}}" wx:key="id"><view wx:if="{{item.regionStyle && item.released}}" id="paper-q-{{item.id}}" class="paper-region {{item.tone}} {{item.selected ? 'selected' : ''}}" style="{{item.regionStyle}}" data-id="{{item.id}}" data-item="{{pages[pageIndex].id}}" catchtap="selectSheetQuestion"><text class="paper-mark">{{item.mark}}</text></view></block></view><view wx:else class="muted">原图暂不可用，请查看下方提取的题目。</view><text class="result-photo-hint">点击题框切换题目 · 原图可上下查看</text></scroll-view>
        <view class="result-sheet {{resultSheetMinimized ? 'is-minimized' : ''}} {{resultSheetFull ? 'is-full' : ''}}" style="height:{{resultSheetRatio * 100}}%"><view class="result-handle" bindtouchstart="sheetTouchStart" catchtouchmove="sheetTouchMove" bindtouchend="sheetTouchEnd" bindtouchcancel="sheetTouchCancel" bindtap="toggleResultSheet"><view></view></view><view class="result-sheet-top"><scroll-view scroll-x scroll-into-view="{{'result-q-' + selected.id}}" class="result-question-nav"><view wx:for="{{questionNav}}" wx:key="id" id="result-q-{{item.id}}" class="{{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" data-item="{{item.itemId}}" bindtap="selectSheetQuestion" aria-label="{{item.number + '，' + item.result}}"><text>{{item.number}}</text><text class="grade-{{item.tone}}">{{item.mark}}</text></view></scroll-view></view>
        <scroll-view scroll-y="{{!resultSheetMinimized}}" scroll-top="{{resultSheetScrollTop}}" bindscroll="onResultSheetScroll" class="result-sheet-body" aria-hidden="{{resultSheetMinimized}}"><view class="result-answer-heading"><text>参考答案</text><view wx:if="{{resultSheetFull}}" bindtap="showResultOriginal">查看原图 ⌄</view></view>
          <block wx:if="{{selected.explanationAllowed}}"><view class="result-answer">{{selected.answer}}</view><view wx:if="{{selected.reviewed}}" class="muted">教师已复核</view><view class="result-reading"><text>解析</text><view>{{selected.explanation}}</view></view></block><view wx:else class="muted">{{selected.result}}，答案与解析暂不可查看。</view>
          <view wx:if="{{selected.referenceNotice}}" class="muted">教师参考答案：{{selected.referenceNotice}}</view><view wx:if="{{selected.referenceAnswer}}" class="result-reference"><text>教师参考答案</text><view>{{selected.referenceAnswer}}</view><view>{{selected.referenceExplanation}}</view></view><view class="result-history-link" bindtap="openTutorHistory">讲题记录 ›</view>
        </scroll-view><view class="result-sheet-footer"><button class="primary" disabled="{{!selected.explanationAllowed}}" bindtap="openTutor">{{selected.explanationAllowed ? '深度解题' : '解析更新后可解题'}}</button></view></view>
      </view>
      <view wx:if="{{selected && role === 'teacher'}}" class="card" id="result-detail">
        <view class="row single-heading"><view class="single-title"><text class="single-label">{{selected.label}}</text><view wx:if="{{role === 'guardian'}}" class="single-status {{selected.wrong ? 'wrong' : ''}}">{{selected.result}}</view><view wx:else class="badge {{selected.wrong ? 'wrong' : ''}}">{{selected.result}}</view></view><button wx:if="{{selected.allowed && role === 'guardian'}}" class="single-bookmark" aria-label="{{selected.saved ? '已加入错题本，点击修改错因' : '加入错题本'}}" bindtap="openMistakeReason">{{selected.saved ? '✓ 已加入' : '＋ 错题本'}}</button></view>
        <view wx:if="{{role === 'guardian'}}" class="single-original"><view class="single-original-head"><text>原题原图</text><text wx:if="{{selected.originalPath}}" class="single-original-link" bindtap="previewOriginal">查看整页 ›</text></view><view wx:if="{{selected.originalPath}}" class="single-original-crop {{selected.originalLocated ? 'located' : 'full'}}" bindtap="previewOriginal"><image src="{{selected.originalPath}}" mode="widthFix" style="{{selected.originalCropStyle}}" /></view><view wx:else class="single-original-empty">原图暂不可用</view><text wx:if="{{selected.originalMock}}" class="single-original-note">演示作业样张{{selected.originalLocated ? ' · 已定位当前题目' : ''}}</text></view>
        <view class="{{role === 'guardian' ? 'single-extracted' : ''}}"><text wx:if="{{role === 'guardian'}}" class="single-extracted-label">题目文字（批改提取）</text><view class="stem">{{selected.stem}}</view></view>
        <view wx:if="{{selected.allowed && !selected.explanationAllowed}}" class="muted">判定已更新，解析暂未更新</view>
        <view wx:if="{{selected.explanationAllowed}}" class="{{role === 'guardian' ? 'single-analysis' : ''}}">
          <view wx:if="{{role === 'guardian'}}" class="single-ai-notice"><text>✦ {{selected.reviewed ? '教师已复核' : 'AI 批改'}}</text><text>{{selected.reviewed ? '当前判定已由教师复核，答案与解析供学习参考。' : '结果仅供参考'}}</text></view>
          <view wx:else class="muted">本次 AI 答案与解析 · 不代表教师已核对</view>
          <block wx:for="{{selected.sections}}" wx:key="title"><view wx:if="{{role !== 'guardian' || index > 0 && index < 4}}" class="explanation"><view class="row" data-index="{{index}}" bindtap="toggleSection"><text>{{item.title === '本次 AI 答案' && role === 'guardian' ? '答案' : item.title}}</text><text class="muted">{{item.open ? '−' : '＋'}}</text></view><view wx:if="{{item.open}}" class="explanation-text">{{item.text}}</view></view></block>
          <view wx:if="{{role !== 'guardian' && selected.videoUrl}}" class="explanation"><view>知识点视频</view><video wx:if="{{selected.videoUrl}}" class="original" src="{{selected.videoUrl}}" controls /><view wx:else class="muted">暂无知识点视频</view></view>
        </view>
        <view wx:if="{{!selected.allowed}}" class="answer muted">{{selected.result}}，已有有效结果时可查看答案与解析。</view>
      </view>
      <view wx:if="{{!selected}}" class="card muted">当前页暂无可查看的错题。</view>
    </block>
  </block>
  <view wx:elif="{{learningMode === 'notebook'}}"><view class="title">{{studentName}}的错题本</view><view wx:if="{{!notebookEntries.length}}" class="card muted">还没有加入的题目。</view><view wx:for="{{notebookEntries}}" wx:key="key" class="card"><view>{{item.question.label}}</view><view class="stem">{{item.question.stem}}</view><view class="muted">错因：{{item.reason}} · 第 {{item.version}} 版</view></view><button class="learning-button" bindtap="closeLearning">返回批改结果</button></view>
  <view wx:elif="{{learningMode === 'history'}}"><view class="title">讲题记录</view><view wx:if="{{tutorHistory}}" class="card"><view>{{selected.label}} · {{tutorHistory.status}}</view><view class="muted">最近更新 {{tutorHistory.updated}}</view><view class="muted">讲题进度保存在本机，可从本题继续。</view></view><view wx:else class="card muted">还没有讲题记录。点击「1对1讲题」开始。</view><button class="learning-button" bindtap="closeLearning">返回批改结果</button></view>
  <view wx:elif="{{learningMode === 'tutor' && tutor}}" class="ht-root ht-simple" style="height:calc(100vh - {{statusBarHeight + navBarHeight}}px)">
    <view class="ht-source {{tutor.originalOpen ? 'is-expanded' : 'is-collapsed'}}"><view class="ht-source-header" bindtouchstart="sourceTouchStart" bindtouchend="sourceTouchEnd"><text>{{selected.label}}</text><button class="ht-source-toggle" bindtap="toggleTutorOriginal">{{tutor.originalOpen ? '收起原题 ⌃' : '展开原题 ⌄'}}</button></view><scroll-view wx:if="{{tutor.originalOpen}}" scroll-y class="ht-source-scroll" enhanced show-scrollbar><view class="ht-source-stem">{{selected.stem}}</view><view wx:if="{{selected.originalPath}}" class="ht-source-photo" bindtap="previewOriginal"><image src="{{selected.originalPath}}" mode="widthFix" /><text>⛶</text></view><view wx:else class="ht-muted">原图暂不可用</view></scroll-view><view wx:else class="ht-source-stem">{{selected.stem}}</view><view class="ht-source-handle" bindtouchstart="sourceTouchStart" bindtouchend="sourceTouchEnd" bindtap="toggleTutorOriginal"><view></view></view></view>
    <view wx:if="{{tutor.phase === 'unsupported'}}" class="ht-empty"><view>本题讲解暂未配置</view><view>{{tutorCaption}}</view><button class="ht-button primary" bindtap="closeLearning">返回原题</button></view>
    <view wx:elif="{{tutor.phase === 'done'}}" class="ht-summary"><view class="ht-heading">{{tutor.transferStatus === '本次变式判断符合' || tutor.transferStatus === '变式在帮助下完成' ? '✓ 练习完成' : '✓ 这道题讲完啦'}}</view><view wx:for="{{tutorBoardLines}}" wx:key="*this" class="ht-board-line">{{item}}</view><button class="ht-button primary" bindtap="finishTutor">返回作业</button><button class="ht-button ht-text-link" bindtap="transferTutor">再练一道</button></view>
<view wx:else class="ht-lesson">
        <view class="ht-progress-track"><view style="width:{{(tutor.cursor + 1) / lessonLength * 100}}%"></view></view><view class="ht-board"><view class="ht-board-title">{{tutorAction.title}}</view><view wx:if="{{tutorRatio}}" class="ht-ratio"><view class="ht-ratio-cells"><view wx:for="{{[0,1,2,3,4,5,6]}}" wx:key="*this" class="{{index < 4 ? 'filled' : ''}}"></view></view><view class="ht-bracket part">24人</view><view class="ht-bracket whole">全班？人</view></view><view wx:for="{{tutorBoardLines}}" wx:key="*this" class="ht-board-line">{{item}}</view><view wx:if="{{tutorAction.board.columns}}" class="ht-grid"><view wx:for="{{tutorCells}}" wx:key="id" class="ht-cell {{item.color}}" style="width:{{tutorCellWidth}};height:{{tutorCellHeight}}"></view></view><view wx:if="{{tutorAction.board.caption}}" class="ht-muted">{{tutorAction.board.caption}}</view></view>
      <view class="ht-dock"><view class="ht-caption"><view class="ht-caption-label">{{tutor.phase === 'paused' ? '已暂停' : tutor.phase === 'resume' ? '继续上次讲解' : tutorCanAnswer ? '轮到你了' : '小晤讲解'}}</view><view class="ht-speech">{{tutor.phase === 'feedback' || tutor.phase === 'remedial' || tutor.phase === 'aside' ? tutorAction.speech : tutorCaption}}</view></view>
        <view class="ht-main-actions"><button wx:if="{{tutor.phase === 'resume'}}" class="ht-button primary" bindtap="resumeTutor">继续上次</button><button wx:elif="{{tutorCanAnswer || tutor.phase === 'feedback' || tutor.phase === 'remedial' || tutor.phase === 'aside'}}" class="ht-button ht-text-link" bindtap="reopenTutorSheet">{{tutorCanAnswer ? '继续作答' : tutor.phase === 'feedback' ? '查看反馈' : tutor.phase === 'remedial' ? '查看提示' : '查看答疑'}}</button><button wx:elif="{{tutorLive}}" class="ht-button ht-play" bindtap="pauseTutor">Ⅱ</button><button wx:else class="ht-button ht-play" bindtap="resumeTutor">▷</button></view>
        <button class="ht-ask-entry" bindtap="openTutorAsk"><text>♩</text><text>不懂就问我</text><text>⌨</text></button>
      </view></view>
    <view wx:if="{{tutorSheet && tutor.phase !== 'done' && tutor.phase !== 'unsupported'}}" class="ht-sheet-mask" bindtap="closeTutorSheet"><view class="ht-sheet" catchtap="stopReasonTap"><view class="ht-sheet-handle"></view><view class="ht-sheet-head"><view><text>{{tutorSheet === 'help' ? '卡点补讲' : tutorSheet === 'ask' ? '问问小晤' : '你来试试'}}</text><view class="ht-sheet-title">{{tutor.phase === 'aside' ? '这一步这样理解' : tutorSheet === 'ask' ? '想问哪一步？' : tutorCanAnswer ? tutorPrompt : tutor.phase === 'feedback' ? '回答正确' : tutor.phase === 'remedial' ? '再拆开讲一步' : tutor.phase === 'aside' ? '这个问题这样看' : '说说你的想法'}}</view></view><button class="ht-sheet-close" bindtap="closeTutorSheet">×</button></view><scroll-view scroll-y class="ht-sheet-body"><view wx:if="{{(!tutorCanAnswer && tutorSheet !== 'ask' || tutor.phase === 'aside') && tutor.phase !== 'feedback'}}" class="ht-sheet-explain">{{tutorCaption}}</view><view wx:if="{{tutor.feedback && tutor.feedback !== tutorCaption}}" class="ht-sheet-feedback">{{tutor.feedback}}</view><view wx:if="{{tutorCanAnswer && tutorSheet !== 'ask'}}" class="ht-options"><button wx:for="{{tutorOptions}}" wx:key="*this" class="ht-button" data-answer="{{item}}" bindtap="tutorOption">{{item}}</button></view><view wx:if="{{tutor.phase === 'transfer' || tutor.phase === 'paused' && tutor.returnPhase === 'transfer'}}" class="ht-sheet-actions"><button class="ht-button ht-text-link" bindtap="skipTutor">结束练习</button></view><view wx:if="{{tutor.phase === 'choice'}}" class="ht-sheet-actions"><button class="ht-button" bindtap="tutorExplain">换个方式看</button><button class="ht-button primary" bindtap="skipTutor">先继续讲</button></view><view wx:if="{{tutorNeedsHelp}}" class="ht-sheet-actions"><button class="ht-button ht-text-link" bindtap="tutorHint">讲解当前步骤</button></view><view wx:if="{{tutor.phase === 'aside'}}" class="ht-sheet-actions"><button class="ht-button primary" bindtap="tutorBack">返回讲题</button></view><view wx:if="{{tutor.phase === 'feedback' || tutor.phase === 'remedial'}}" class="ht-sheet-actions"><button class="ht-button primary" bindtap="continueTutorSheet">{{tutor.phase === 'remedial' ? '再试一次' : '继续讲解'}}</button></view><view wx:if="{{tutorCanAnswer && tutorSheet !== 'ask'}}" class="ht-sheet-actions"><button class="ht-button ht-text-link" bindtap="tutorHint">我还不懂</button></view><view wx:if="{{tutorSheet === 'ask' && tutor.phase !== 'aside'}}" class="ht-composer"><block wx:if="{{tutorEditor}}"><input class="ht-draft-input" focus="{{tutorEditor}}" maxlength="500" value="{{tutor.draft}}" bindfocus="focusTutor" bindblur="blurTutor" bindinput="changeTutorAnswer" bindconfirm="submitTutorInput" confirm-type="send" placeholder="{{tutorCanAnswer && tutorSheet !== 'ask' ? '输入你的回答' : '说说你的想法'}}"/><button class="ht-button ht-send" bindtap="submitTutorInput">发送</button><button class="ht-button ht-mode" bindtap="cancelTutorInput">🎙</button></block><block wx:else><button class="ht-button ht-voice" bindtap="voiceTutor">♩　{{tutorCanAnswer && tutorSheet !== 'ask' ? '说说你的答案' : '有疑问，随时问我'}}</button><button class="ht-button ht-mode" bindtap="editTutor">⌨</button></block></view><view wx:if="{{tutorNotice}}" class="ht-feedback">{{tutorNotice}}</view></scroll-view></view></view>
  </view>

  <view wx:if="{{reasonOpen && !denied}}" class="reason-mask" bindtap="closeMistakeReason"><view class="reason-sheet" catchtap="stopReasonTap"><view class="row"><view>加入错题本 · 标记错因</view><view bindtap="closeMistakeReason">×</view></view><view class="chips"><view wx:for="{{mistakeReasons}}" wx:key="*this" class="{{mistakeReason === item ? 'active' : ''}}" data-reason="{{item}}" bindtap="chooseMistakeReason">{{item}}</view></view><view class="muted">记录到当前孩子的错题本，重复加入会更新错因。</view><view wx:if="{{learningError}}" class="wrong">{{learningError}}</view><button class="learning-button primary" bindtap="saveMistake">确认加入</button></view></view>
</view>
