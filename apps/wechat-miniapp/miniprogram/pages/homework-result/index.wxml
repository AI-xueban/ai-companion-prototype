<view class="result-page {{learningMode === 'tutor' ? 'tutor-page' : ''}} {{learningMode === 'result' ? 'grade-page' : ''}} {{role === 'guardian' ? 'parent' : 'teacher'}}">
  <view class="navigation"><view style="height:{{statusBarHeight}}px"></view><view class="nav-row" style="height:{{navBarHeight}}px"><view class="back" bindtap="goBack" aria-label="返回">‹</view><view>{{learningMode === 'tutor' ? '1对1讲题' : learningMode === 'notebook' ? '孩子的错题本' : '整份批改结果'}}</view></view></view>
  <view wx:if="{{denied}}" class="card muted">当前账号无权查看此学生的作业结果。</view>
  <block wx:elif="{{learningMode === 'result'}}">
    <view class="eyebrow">{{studentName}} · {{taskTitle}}</view><view class="title">整份批改结果</view>
    <view wx:if="{{progress.total}}" class="status"><view>{{progress.title}}</view><view class="muted">{{progress.pending ? '提交已成功，可离开页面稍后查看；完成时间以实际批改结果为准。' : role === 'guardian' ? 'AI 判定供参考，教师纠正后自动同步。' : '仅有效判定计入对错统计。'}}</view></view>
    <view class="metrics"><view><text>{{progress.total}}</text>总题数</view><view><text>{{progress.correct}}</text>答对</view><view><text class="wrong">{{progress.wrong}}</text>答错</view><view><text>{{progress.unavailable}}</text>{{role === 'guardian' ? '待处理' : '待处理'}}</view></view>
    <view wx:if="{{!pages.length}}" class="card muted">暂无作业批改结果。</view>
    <block wx:else>
      <view class="section">整份作业 <text class="muted">共 {{pages.length}} 页提交</text></view>
      <view wx:if="{{pages.length > 1}}" class="page-tabs"><view wx:for="{{pages}}" wx:key="id" class="{{item.selected ? 'active' : ''}}" data-index="{{index}}" bindtap="changePage">第 {{index + 1}} 页</view></view>
      <view wx:if="{{!hideOriginal}}" class="card grade-paper-card"><view class="grade-paper-title">{{pages[pageIndex].title}}</view><view wx:if="{{pages[pageIndex].mock}}" class="muted grade-paper-note">演示作业样张 · 点击题目查看对应解析</view>
        <view wx:if="{{pages[pageIndex].path}}" class="marked-paper"><image class="paper-image" src="{{pages[pageIndex].path}}" mode="widthFix" /><block wx:for="{{questions}}" wx:key="id"><view wx:if="{{item.regionStyle}}" class="paper-region {{item.tone}} {{item.selected ? 'selected' : ''}}" style="{{item.regionStyle}}" data-id="{{item.id}}" catchtap="selectQuestion"><text class="paper-mark">{{item.mark}}</text><text class="paper-box-label">{{item.label}} · {{item.boxLabel}}</text></view></block></view><view wx:else class="muted grade-paper-legend">原图暂不可用。</view><view class="muted grade-paper-legend">✓ 正确　× 错误　? 待复核或存疑；点击题框查看单题。</view><view wx:if="{{!regionCount}}" class="muted grade-paper-legend">题目区域暂未定位，可通过下方题目入口查看。</view><view wx:if="{{pages[pageIndex].path}}" class="link grade-paper-link" bindtap="previewOriginal">查看原图</view>
      </view>
      <view class="section row">逐题查看 <view class="link" bindtap="toggleWrong">{{wrongOnly ? '显示全部' : '只看错题'}}</view></view>
      <view class="chips"><block wx:for="{{questions}}" wx:key="id"><view wx:if="{{!wrongOnly || item.wrong}}" class="{{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectQuestion">{{item.label}} · {{item.result}}</view></block></view>
      <view wx:if="{{selected.referenceNotice}}" class="card muted">教师参考答案：{{selected.referenceNotice}}</view><view wx:if="{{selected.referenceAnswer}}" class="card"><view>教师参考答案 · 独立参考</view><view>{{selected.referenceAnswer}}</view><view class="muted">{{selected.referenceExplanation}}</view></view><view wx:if="{{selected}}" class="card" id="result-detail"><view class="row"><view>{{selected.label}}</view><view class="badge {{selected.wrong ? 'wrong' : ''}}">{{selected.result}}</view></view><view class="stem">{{selected.stem}}</view><view wx:if="{{selected.allowed && role === 'guardian'}}" class="learning-actions"><button bindtap="openMistakeReason">{{selected.saved ? '已加入 · 修改错因' : '加入错题本'}}</button><button disabled="{{!selected.explanationAllowed}}" class="primary" bindtap="openTutor">1对1讲题</button></view><view wx:if="{{selected.allowed && !selected.explanationAllowed}}" class="muted">判定已更新，解析暂未更新</view><block wx:if="{{selected.explanationAllowed}}"><view class="muted">本次 AI 答案与解析 · 不代表教师已核对</view><view wx:for="{{selected.sections}}" wx:key="title" class="explanation"><view class="row" data-index="{{index}}" bindtap="toggleSection"><text>{{item.title}}</text><text class="muted">{{item.open ? '−' : '＋'}}</text></view><view wx:if="{{item.open}}" class="explanation-text">{{item.text}}</view></view><view class="explanation"><view>知识点视频</view><video wx:if="{{selected.videoUrl}}" class="original" src="{{selected.videoUrl}}" controls /><view wx:else class="muted">暂无知识点视频</view></view></block><view wx:if="{{selected.allowed && role === 'guardian'}}" class="link" bindtap="openNotebook">查看孩子的错题本</view><view wx:if="{{!selected.allowed}}" class="answer muted">{{selected.result}}，已有有效结果时可查看答案与解析。</view></view>
      <view wx:else class="card muted">当前页暂无可查看的错题。</view>
    </block>
  </block>
  <view wx:elif="{{learningMode === 'notebook'}}"><view class="title">{{studentName}}的错题本</view><view wx:if="{{!notebookEntries.length}}" class="card muted">还没有加入的题目。</view><view wx:for="{{notebookEntries}}" wx:key="key" class="card"><view>{{item.question.label}}</view><view class="stem">{{item.question.stem}}</view><view class="muted">错因：{{item.reason}} · 第 {{item.version}} 版</view></view><button class="learning-button" bindtap="closeLearning">返回批改结果</button></view>
  <view wx:elif="{{learningMode === 'tutor' && tutor}}" class="ht-root" style="height:calc(100vh - {{statusBarHeight + navBarHeight}}px)">
    <view class="ht-source"><view class="row"><text>{{selected.label}}</text><text class="link" bindtap="tutorOriginal">查看原题</text></view><view class="ht-muted">{{selected.stem}}</view></view>
    <view wx:if="{{tutor.phase === 'unsupported'}}" class="ht-empty"><view>本题讲解暂未配置</view><view>{{tutorCaption}}</view><button class="ht-button primary" bindtap="closeLearning">返回原题</button></view>
    <view wx:elif="{{tutor.phase === 'done'}}" class="ht-summary"><view class="ht-pill">本次结束</view><view class="ht-heading">这道题，我们讲到这里</view><view class="ht-muted">讲解完成与理解验证分别记录，原作业判分保持不变。</view><view wx:for="{{tutorSummary}}" wx:key="id" class="ht-evidence"><text>{{item.title}}</text><text>{{item.status}}</text></view><view class="ht-muted">不自动作为孩子长期掌握证据</view><button class="ht-button primary" bindtap="closeLearning">返回原题</button><view wx:if="{{tutor.transferStatus}}" class="ht-feedback">{{tutor.transferStatus}}</view><button class="ht-button" bindtap="transferTutor">试一个同类小判断</button><button class="ht-button" bindtap="beginGuide">从头再讲</button></view>
      <view wx:else class="ht-lesson">
        <view class="ht-progress"><view class="{{tutor.cursor === 0 ? 'active' : ''}}"><view class="ht-dot"></view>理解题意</view><view class="{{tutor.cursor > 0 && tutor.cursor < lessonLength - 1 ? 'active' : ''}}"><view class="ht-dot"></view>分步推导</view><view class="{{tutor.cursor === lessonLength - 1 ? 'active' : ''}}"><view class="ht-dot"></view>方法归纳</view></view>
      <view class="ht-board"><view class="ht-board-meta"><text>{{tutorAction.tag}}</text><text>第 {{tutor.cursor + 1}} / {{lessonLength}} 步</text></view><view class="ht-board-title"><text class="ht-step-number">{{tutor.cursor + 1}}</text>{{tutorAction.title}}</view><view wx:for="{{tutorAction.board.lines}}" wx:key="*this" class="ht-board-line">{{item}}</view><view wx:if="{{tutorAction.board.columns}}" class="ht-grid"><view wx:for="{{tutorCells}}" wx:key="id" class="ht-cell {{item.color}}" style="width:{{tutorCellWidth}};height:{{tutorCellHeight}}"></view></view><view wx:if="{{tutorAction.board.caption}}" class="ht-muted">{{tutorAction.board.caption}}</view></view>
      <view class="ht-dock"><view class="ht-caption"><view class="ht-caption-label">{{tutor.phase === 'paused' ? '已暂停' : tutor.phase === 'resume' ? '继续上次讲解' : tutorCanAnswer ? '轮到你了' : '小晤讲解'}}</view><view class="ht-speech">{{tutorCaption}}</view></view>
        <view class="ht-main-actions"><block wx:if="{{tutor.phase === 'resume'}}"><button class="ht-button primary" bindtap="resumeTutor">继续上次</button><button class="ht-button" bindtap="beginGuide">从头讲</button></block><button wx:elif="{{tutorCanAnswer || tutor.phase === 'feedback' || tutor.phase === 'remedial' || tutor.phase === 'aside'}}" class="ht-button primary" bindtap="reopenTutorSheet">继续互动</button><block wx:elif="{{tutorLive}}"><button class="ht-button ht-play" bindtap="pauseTutor">暂停</button><button class="ht-button ht-text-button" bindtap="nextTutor">下一段</button></block><button wx:else class="ht-button ht-play" bindtap="resumeTutor">继续播放</button><button wx:if="{{tutor.phase !== 'resume'}}" class="ht-button ht-help" bindtap="tutorHint">这一步没懂</button></view>
        <button class="ht-ask-entry" bindtap="openTutorAsk"><text>♩</text><text>有疑问，随时问我</text><text>⌨</text></button>
      </view></view>
    <view wx:if="{{tutor.phase !== 'done' && tutor.phase !== 'unsupported'}}" class="ht-settings"><button class="ht-button" bindtap="soundTutor">语音</button><button class="ht-button" bindtap="tutorDirect">{{tutor.direct ? '边讲边练' : '直接讲解'}}</button></view>
    <view wx:if="{{tutorSheet && tutor.phase !== 'done' && tutor.phase !== 'unsupported'}}" class="ht-sheet-mask" bindtap="closeTutorSheet"><view class="ht-sheet" catchtap="stopReasonTap"><view class="ht-sheet-handle"></view><view class="ht-sheet-head"><view><text>{{tutorSheet === 'help' ? '卡点补讲' : tutorSheet === 'ask' ? '向小晤提问' : '边讲边练'}}</text><view class="ht-sheet-title">{{tutorCanAnswer ? '轮到你了' : tutor.phase === 'feedback' ? '回答反馈' : tutor.phase === 'remedial' ? '再拆开讲一步' : tutor.phase === 'aside' ? '这个问题这样看' : '说说你的想法'}}</view></view><button class="ht-sheet-close" bindtap="closeTutorSheet">×</button></view><scroll-view scroll-y class="ht-sheet-body"><view wx:if="{{tutorCanAnswer}}" class="ht-sheet-question">{{tutorPrompt}}</view><view wx:else class="ht-sheet-explain">{{tutorCaption}}</view><view wx:if="{{tutor.feedback && tutor.feedback !== tutorCaption}}" class="ht-sheet-feedback">{{tutor.feedback}}</view><view wx:if="{{tutorCanAnswer}}" class="ht-options"><button wx:for="{{tutorOptions}}" wx:key="*this" class="ht-button" data-answer="{{item}}" bindtap="tutorOption">{{item}}</button></view><view wx:if="{{tutor.phase === 'choice'}}" class="ht-sheet-actions"><button class="ht-button" bindtap="tutorExplain">换个方式看</button><button class="ht-button primary" bindtap="skipTutor">先继续讲</button></view><view wx:if="{{tutor.phase === 'aside'}}" class="ht-sheet-actions"><button class="ht-button primary" bindtap="tutorBack">返回讲题</button></view><view wx:if="{{tutor.phase === 'feedback' || tutor.phase === 'remedial'}}" class="ht-sheet-actions"><button class="ht-button primary" bindtap="continueTutorSheet">{{tutor.phase === 'remedial' ? '再试一次' : '继续讲解'}}</button></view><view wx:if="{{tutorCanAnswer}}" class="ht-sheet-actions"><button class="ht-button" bindtap="tutorHint">给点提示</button><button class="ht-button" bindtap="skipTutor">先继续讲</button></view><view wx:if="{{tutorSheet === 'ask' || tutorCanAnswer}}" class="ht-composer"><block wx:if="{{tutorEditor}}"><input class="ht-draft-input" maxlength="500" value="{{tutor.draft}}" bindfocus="focusTutor" bindblur="blurTutor" bindinput="changeTutorAnswer" bindconfirm="submitTutorInput" confirm-type="send" placeholder="{{tutorCanAnswer && tutorSheet !== 'ask' ? '输入你的回答' : '说说你的想法'}}"/><button class="ht-button ht-send" bindtap="submitTutorInput">发送</button><button class="ht-button ht-mode" bindtap="cancelTutorInput">🎙</button></block><block wx:else><button class="ht-button ht-voice" bindtap="voiceTutor">♩　{{tutorCanAnswer && tutorSheet !== 'ask' ? '说说你的答案' : '有疑问，随时问我'}}</button><button class="ht-button ht-mode" bindtap="editTutor">⌨</button></block></view><view wx:if="{{tutorNotice}}" class="ht-feedback">{{tutorNotice}}</view></scroll-view></view></view>
    <view wx:if="{{tutor.originalOpen}}" class="ht-modal"><scroll-view scroll-y class="ht-modal-body"><view class="row"><text>作业原题</text><button class="ht-button" bindtap="closeTutorOriginal">返回讲题</button></view><view class="ht-speech">{{selected.stem}}</view><image wx:for="{{pages}}" wx:key="id" wx:if="{{item.path}}" src="{{item.path}}" mode="widthFix" style="width:100%" /></scroll-view></view>
  </view>

  <view wx:if="{{reasonOpen && !denied}}" class="reason-mask" bindtap="closeMistakeReason"><view class="reason-sheet" catchtap="stopReasonTap"><view class="row"><view>加入错题本 · 标记错因</view><view bindtap="closeMistakeReason">×</view></view><view class="chips"><view wx:for="{{mistakeReasons}}" wx:key="*this" class="{{mistakeReason === item ? 'active' : ''}}" data-reason="{{item}}" bindtap="chooseMistakeReason">{{item}}</view></view><view class="muted">记录到当前孩子的错题本，重复加入会更新错因。</view><view wx:if="{{learningError}}" class="wrong">{{learningError}}</view><button class="learning-button primary" bindtap="saveMistake">确认加入</button></view></view>
</view>
