.ht-progress i,.ht-dot{display:block;width:8px;height:8px;margin:0 auto 7px;border:1px solid #a7b0c0;border-radius:50%;background:#fff;position:relative;z-index:1}
.ht-progress .active{color:#4f56d9;font-weight:600}.ht-progress .active i,.ht-progress .active .ht-dot{background:#4f56d9;border-color:#4f56d9;box-shadow:0 0 0 3px #f0f1ff}
.ht-step{display:flex;justify-content:space-between;align-items:center;padding:12px 18px 0;font-size:10px;color:#7c879b;gap:10px}
.ht-step>span:first-child,.ht-step>text:first-child{color:#4f56d9;background:none;padding:0;border-radius:0}
.ht-board{background:#fff;border:0;border-radius:0;padding:12px 20px 26px;margin:0;min-height:210px;box-sizing:border-box;flex:1}
.ht-board h2,.ht-board-title{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:650;line-height:1.5;margin:0 0 14px;color:#202c43}
.ht-step-number{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;width:25px;height:25px;border:1px solid #4f56d9;border-radius:50%;font-size:14px;font-weight:500;color:#4f56d9;margin-right:4px}
.ht-board p,.ht-board-line{font-size:16px;line-height:1.9;margin:6px 0;color:#202c43;white-space:pre-wrap;overflow-wrap:anywhere}
.ht-grid{display:flex;flex-wrap:wrap;height:140px;box-sizing:content-box;border:1px solid #46556c;margin:20px 0 10px;background:#fff;overflow:hidden}
.ht-grid i,.ht-cell{box-sizing:border-box;display:block;border-right:1px solid #798a9b;border-bottom:1px solid #798a9b}
.ht-grid .green{background:#a7d3cf}.ht-grid .orange{background:#6e78df}.ht-grid .empty{background:#fff}.ht-board>small{font-size:11px;color:#7c879b}
.ht-dock{margin-top:auto;border-top:1px solid #e0e6f3;background:linear-gradient(110deg,#eef0ff 0%,#eff6ff 55%,#edf9f8 100%);padding:14px 18px 12px;box-sizing:border-box;min-width:0}
.ht-caption{border:0;background:transparent;border-radius:0;padding:0;margin:0 0 12px}
.ht-caption-label{color:#168f94;font-size:12px;display:flex;align-items:center;gap:7px;margin-bottom:7px;font-weight:600}
.ht-caption-label i{width:5px;height:14px;background:#168f94;border-radius:3px;box-shadow:5px 0 0 -1px #75bfc2;margin-right:4px}
.ht-caption p,.ht-speech{font-size:15px;line-height:1.8;margin:0;color:#202c43;white-space:pre-wrap;overflow-wrap:anywhere}
.ht-question{display:block;font-size:15px;color:#202c43;margin-top:10px;line-height:1.8;font-weight:600}
.ht-actions,.ht-controls{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0}
.ht-root .ht-button,.ht-options>button{box-sizing:border-box;width:auto;flex:initial;display:inline-flex;align-items:center;justify-content:center;min-width:0;margin:0;border:1px solid #dbe2f0;border-radius:12px;background:#ffffffde;color:#63718b;font-size:12px;line-height:1.5;padding:10px 12px;min-height:42px;cursor:pointer;font-family:inherit}
.ht-root .ht-button.primary{background:#4f56d9;border-color:#4f56d9;color:#fff;font-weight:600}
.ht-inputbar{display:flex;align-items:stretch;gap:10px;margin-top:12px}
.ht-root .ht-ask-entry{flex:1;justify-content:flex-start;font-size:12px;color:#8893a6;background:#ffffffde;min-height:44px;padding-left:14px}
.ht-root .ht-answer-cta{flex:1;min-height:44px;font-size:14px}.ht-root .ht-keyboard{font-size:11px;background:#fff}.ht-root .ht-play{min-width:52px;max-width:82px}
.ht-root .ht-controls{position:static;bottom:auto;background:none;padding:0;z-index:auto;justify-content:flex-end;gap:4px;margin-top:6px}
.ht-root .ht-text-button{border:0;background:none;min-height:32px;padding:4px 6px;font-size:11px;color:#77839c;border-radius:5px}
.ht-options{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.ht-options>button{flex:1;color:#4f56a3;background:#ffffffc9;border-color:#d9def5;font-size:13px;min-height:40px}
.ht-editor{margin:12px 0}.ht-editor label,.ht-editor>view:first-child{font-size:11px;color:#7c879b}
.ht-editor textarea,.ht-input{box-sizing:border-box;display:block;resize:none;width:100%;height:75px;padding:10px 12px;border:1px solid #d9e1f0;border-radius:12px;background:#fff;color:#202c43;font-family:inherit;font-size:14px;line-height:1.6;margin-top:7px}
.ht-feedback{color:#687a96;font-size:11px;line-height:1.8;margin:10px 18px}.ht-dock>.ht-feedback{margin:8px 0}
.ht-more{margin:0;padding:12px 18px;border:0;color:#929db0;font-size:10px;background:#f8fafd}.ht-more summary{cursor:pointer}.ht-more p{font-size:10px;line-height:1.8}
.ht-summary,.ht-empty{background:#fff;border:1px solid #e3e8f1;border-radius:16px;padding:24px 18px;margin:16px 18px}.ht-summary h2{font-size:21px;line-height:1.6;color:#202c43}.ht-summary p,.ht-empty p{font-size:13px;color:#7c879b;line-height:1.9}.ht-root .ht-summary>.ht-button{display:flex;width:100%;margin-top:12px}
.ht-pill{display:inline-block;background:#eff0ff;color:#4f56d9;border-radius:6px;padding:3px 9px;font-size:11px}
.ht-evidence{display:flex;justify-content:space-between;gap:16px;padding:15px 0;border-bottom:1px solid #e8edf5;font-size:12px}.ht-evidence b{font-size:11px;color:#168f94}.ht-summary>small{display:block;margin:15px 0;font-size:10px;color:#929db0}
.ht-modal{position:fixed;z-index:200;inset:0;background:#202c4366;display:flex;align-items:center;justify-content:center;padding:22px;box-sizing:border-box}.ht-modal>div,.ht-modal-body{background:#fff;max-height:85vh;overflow:auto;padding:18px;border-radius:18px;width:100%;box-sizing:border-box}.ht-modal header{display:flex;justify-content:space-between;align-items:center}.ht-modal img{width:100%;height:auto;margin-top:15px}.ht-root button:disabled{opacity:.5;cursor:default}

.ht-button::after,.ht-icon::after{border:0}

.result-page.tutor-page{padding:0;background:#fff}.tutor-page .navigation{margin:0}.ht-root{display:flex;flex-direction:column;min-height:0;padding:0;box-sizing:border-box}.ht-header,.ht-source,.ht-progress,.ht-step,.ht-more{flex-shrink:0}.ht-lesson{flex:1;min-height:0;overflow:hidden}.ht-board{min-height:0;overflow:auto}.ht-dock{flex-shrink:0;max-height:65%;overflow:auto}.ht-more{max-height:140px;overflow:auto}.ht-summary,.ht-empty{overflow:auto}.ht-root .ht-progress .active{background:transparent!important;border-color:transparent!important;color:#4f56d9!important}

.ht-root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}

/* Match the compact grading summary in the browser prototype. */
.result-page.grade-page .navigation{margin-bottom:14rpx}
.result-page.grade-page .eyebrow{font-size:22rpx}
.result-page.grade-page .title{font-size:38rpx;line-height:1.3;margin:4rpx 0 12rpx}
.result-page.grade-page .status{padding:17rpx 22rpx;border-radius:18rpx;font-size:25rpx}
.result-page.grade-page .status .muted{margin-top:3rpx;line-height:1.4;font-size:20rpx}
.result-page.grade-page .metrics{margin:12rpx 0 14rpx;padding:12rpx 0;border-radius:18rpx}
.result-page.grade-page .metrics text{font-size:36rpx;line-height:1.25}
.result-page.grade-page .section{margin:16rpx 0 8rpx}
.result-page.grade-page .page-tabs{justify-content:flex-start;gap:10rpx}
.result-page.grade-page .page-tabs>view{padding:8rpx 14rpx}
.result-page.grade-page .grade-paper-card{overflow:hidden;margin:12rpx 0;padding:0;border-radius:22rpx}
.result-page.grade-page .grade-paper-title{padding:20rpx 24rpx 0;font-weight:600}
.result-page.grade-page .grade-paper-note{padding:2rpx 24rpx 10rpx;line-height:1.4}
.result-page.grade-page .grade-paper-card .marked-paper{margin-top:10rpx}
.result-page.grade-page .grade-paper-note+.marked-paper{margin-top:0}
.result-page.grade-page .grade-paper-legend,.result-page.grade-page .grade-paper-link{display:block;margin:10rpx 24rpx}
/* Guardian single-question result follows the approved warm-orange layout. */
.result-page.parent.grade-page{min-height:100vh;box-sizing:border-box;padding-bottom:190rpx;background:radial-gradient(circle at 92% 3%,#fff0e4 0,transparent 30%),linear-gradient(175deg,#fffdfb,#fff8f2 56%,#fffdfb);color:#3f2b20}
.parent.grade-page .navigation{background:#fffdfb}
