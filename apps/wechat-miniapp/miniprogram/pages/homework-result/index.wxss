/* Tutoring: approved indigo/teal visual direction, white board and pale gradient dock. */
.ht-root{color:#202c43;padding:0 0 16px;line-height:1.65;background:#fff;min-width:0}
.ht-header{display:flex;align-items:center;justify-content:space-between;padding:0 18px 10px;gap:10px}
.ht-header small,.ht-muted{font-size:11px;color:#7c879b;line-height:1.7}
.ht-heading{font-size:23px;font-weight:650}.ht-icon{border:1px solid #e3e8f1;border-radius:18px;background:#fff;color:#64718a;padding:7px 12px;font-size:11px;line-height:1.5;margin:0;flex-shrink:0}
.ht-source{padding:12px 18px 14px;margin:0;border:0;border-bottom:1px solid #e3e8f1;background:#fff;border-radius:0}
.ht-source-label{display:inline-block;color:#4f56d9;background:#eff0ff;font-size:11px;line-height:1.6;padding:2px 7px;border-radius:5px;margin:0 8px 6px 0}
.ht-source>b{font-size:12px;font-weight:500;color:#7c879b}.ht-source>button,.ht-source .link{float:right;border:0;background:none;color:#67748b;font-size:11px;padding:2px 0}
.ht-source>p,.ht-source>.ht-muted{font-size:14px;line-height:1.8;margin:3px 0 0;color:#202c43;white-space:pre-wrap}
.ht-lesson{display:flex;flex-direction:column;min-height:480px}
.ht-progress{display:flex;justify-content:space-between;gap:8px;margin:0 18px;padding:15px 0;border-bottom:1px solid #e3e8f1}
