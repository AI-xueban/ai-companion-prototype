.tutor-page .ht-simple{background:#fff}.tutor-page .ht-simple .ht-source{background:#f8f6fd;box-shadow:none;border:0}.ht-simple .ht-lesson{padding:0 18px}.tutor-page .ht-simple .ht-board{border:0;box-shadow:none;border-radius:0}.ht-simple .ht-board-line{text-align:center;font-size:22px;line-height:1.8}.ht-simple .ht-board-title{font-size:15px;font-weight:500}.ht-simple .ht-ratio-cells>view{flex:1;border-right:1px solid #b49ce4}.ht-simple .ht-ratio-cells .filled{background:#dcd3f4}.ht-simple .ht-dock{position:relative;background:#fff;border:0;box-shadow:none}.ht-simple .ht-main-actions{position:absolute;right:4px;top:0;margin:0}.ht-simple .ht-caption{margin-right:45px}.ht-simple .ht-main-actions .ht-play{min-width:36px;width:36px;min-height:36px;height:36px;border:1px solid #e5dff0;background:#fff;color:#8d75b9}.ht-simple .ht-caption-label{color:#927abf}.ht-simple .ht-sheet-mask{background:#24233555}.ht-simple .ht-sheet{min-height:260px}.ht-simple .ht-sheet-head{border:0}.ht-simple .ht-sheet-title{font-size:21px}.ht-simple .ht-sheet-body{padding-bottom:calc(26px + env(safe-area-inset-bottom))}.ht-simple .ht-sheet .ht-options .ht-button{background:#fff;color:#26314a;border-color:#ded5ed;font-size:17px}.ht-simple .ht-sheet .ht-options{display:flex}.ht-simple .ht-sheet .ht-text-link{background:none;border:0;color:#8e79ad}.ht-simple .ht-heading{font-size:23px;font-weight:650;margin:12px 0 28px}.ht-simple .ht-summary .ht-board-line{margin:12px 0}.ht-simple .ht-method view{font-size:16px;line-height:1.7;margin-top:10px}

/* Inline original panel has its own scroll region and never covers the board. */
.tutor-page .ht-simple .ht-source{display:flex;flex-direction:column;flex:none;max-height:45%;min-height:0;padding:12px 14px 0;box-sizing:border-box;overflow:hidden}
.ht-simple .ht-source.is-expanded{height:45%}.ht-simple .ht-source-header{display:flex;align-items:center;justify-content:space-between;gap:10px;flex:none;min-height:30px;color:#80709d;font-size:12px}.ht-source-header>text{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ht-simple .ht-source-toggle{flex:none;margin:0;padding:0;border:0;background:transparent;min-height:30px;line-height:30px;color:#8b70b3;font-size:12px}.ht-source-toggle:after{border:0}
.ht-simple .ht-source-stem{margin:6px 0 8px;color:#17213b;font-size:15px;line-height:1.6;white-space:pre-wrap;word-break:break-all}.ht-simple .ht-source.is-collapsed>.ht-source-stem{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;max-height:3.2em;flex:none}
.ht-simple .ht-source-scroll{height:0;flex:1;min-height:0;box-sizing:border-box}.ht-simple .ht-source-photo{position:relative;margin:8px 0 12px;border:1px solid #e6dff0;border-radius:10px;background:#fff;overflow:hidden}.ht-source-photo image{display:block;width:100%;height:auto}.ht-source-photo text{position:absolute;right:6px;bottom:6px;background:#ffffffdf;color:#80699f;padding:3px 6px;font-size:18px}
.ht-simple .ht-source-handle{display:flex;align-items:center;justify-content:center;flex:none;width:100%;height:18px}.ht-source-handle>view{width:36px;height:4px;border-radius:4px;background:#d6cce9}

.result-sheet{height:61%;box-shadow:0 -8rpx 44rpx #23304414}.result-sheet.expanded{height:100%}.result-question-nav>view{width:auto;min-width:120rpx;height:72rpx;padding:0 18rpx;box-sizing:border-box;border-radius:18rpx;background:#f3f4f6;color:#666e7d;font-weight:400}.result-question-nav>view.selected{background:#fff0e9;color:#ed795f}.result-sheet-title>text:first-child{color:#17263e;font-size:34rpx}.result-text-link{margin-left:auto;color:#818899;font-size:22rpx}.result-source-toggle{padding:10rpx 0 16rpx;text-align:right;color:#818899;font-size:22rpx}.result-stem{padding:20rpx 24rpx}.result-stem>view{margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-height:3.2em;color:#24334b;font-size:26rpx}.result-section-label{margin:28rpx 0 8rpx;color:#6d7687;font-size:24rpx;font-weight:400}.result-answer{padding:0;background:none;color:#17263e;font-size:46rpx}.result-full{margin-top:24rpx;padding:0;border-color:#edf0f3}.result-solution-toggle{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;margin:0!important;font-weight:600;color:#233047!important}.result-full>view+view{margin:0 0 28rpx;color:#344159;font-size:26rpx;line-height:1.8}.result-sheet-footer .primary{width:100%;border-radius:24rpx;background:#f47b60;font-size:30rpx}.result-source-original{overflow:hidden;border-radius:16rpx}.result-source-original .result-source-crop{width:100%;height:0;box-sizing:content-box}.result-source-crop image{position:absolute;top:0;left:0}

.result-sheet{height:55%;border-radius:40rpx 40rpx 0 0;box-shadow:0 -12rpx 48rpx #23304416}.result-handle{height:48rpx;min-height:48rpx;box-sizing:border-box;padding:20rpx 0}.result-sheet-top{padding:0 32rpx 16rpx;min-height:88rpx;box-sizing:border-box}.result-question-nav>view{display:inline-flex;align-items:center;gap:16rpx;min-width:200rpx;height:72rpx;padding:0 24rpx;border-radius:18rpx 18rpx 0 0;border-bottom:4rpx solid transparent;background:#fff;color:#586174}.result-question-nav>view.selected{background:#fff0e9;color:#e9775b;border-bottom-color:#f47b60}.result-question-nav .grade-correct{color:#279b71}.result-question-nav .grade-wrong{color:#dc5d66}.result-question-nav .grade-pending{color:#9b8c70}.result-sheet-body{padding:14rpx 36rpx 16rpx}.result-sheet.is-minimized .result-sheet-body{visibility:hidden;pointer-events:none;padding-top:0;padding-bottom:0}.result-answer-heading{display:flex;align-items:center;justify-content:space-between;min-height:60rpx;color:#334158;font-size:26rpx;font-weight:600}.result-answer-heading>view{font-size:22rpx;color:#818899;font-weight:400}.result-answer{font-size:56rpx;line-height:1.5;margin:10rpx 0 20rpx;padding:0;color:#17263e;background:none}.result-reading{border-top:1rpx solid #edf0f3;padding-top:24rpx}.result-reading>text{font-size:28rpx;color:#233047;font-weight:600}.result-reading>view{margin-top:20rpx;color:#344159;font-size:26rpx;line-height:1.85;white-space:pre-wrap}.result-history-link{padding:24rpx 0 16rpx;color:#818899;font-size:22rpx}.result-sheet-footer{flex-shrink:0;padding:16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #f1f2f5}.result-sheet-footer .primary{min-height:92rpx;font-size:30rpx}.result-photo{min-height:0}.result-stage.is-full-stage .result-photo{visibility:hidden}

.result-sheet{box-sizing:border-box;max-height:100%}.result-photo{padding:0;box-sizing:border-box}.result-photo-context{margin:24rpx 28rpx 18rpx}.result-marked-paper{width:calc(100% - 40rpx);margin:20rpx}.result-photo-hint{margin:16rpx 28rpx 36rpx}

.correction-history{margin-top:24rpx;padding:20rpx 0;border-top:1rpx solid #eee5de}.correction-title{font-size:27rpx;font-weight:600;color:#29394d;margin-bottom:14rpx}.correction-entry{padding:16rpx;margin:12rpx 0;border-radius:14rpx;background:#fff8f3;font-size:25rpx;line-height:1.6;white-space:pre-wrap}.correction-entry>text{display:block;color:#8b96a2;font-size:21rpx;margin-bottom:8rpx}.correction-entry image{display:block;max-width:100%;width:220rpx;margin:12rpx 0;border-radius:10rpx}.correction-entry audio{width:100%;margin:12rpx 0}.result-sheet-footer .correction-entry-button{width:100%;min-height:76rpx;margin:0 0 12rpx;border:1rpx solid #efc5b6;border-radius:18rpx;background:#fff7f2;color:#c56c4f;font-size:27rpx}.correction-mask{position:fixed;inset:0;z-index:150;display:flex;align-items:flex-end;background:#17253688}.correction-sheet{box-sizing:border-box;width:100%;max-height:88vh;overflow-y:auto;padding:28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#fff;color:#26384c}.correction-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx;font-size:31rpx}.correction-head text{font-size:44rpx;padding:0 12rpx;color:#8a95a2}.correction-sheet textarea{box-sizing:border-box;width:100%;min-height:210rpx;padding:20rpx;border:1rpx solid #e8dcd4;border-radius:18rpx;background:#fffaf7;font-size:27rpx}.correction-actions{display:flex;gap:16rpx;margin:20rpx 0}.correction-actions button{flex:1;margin:0;min-height:76rpx;border:1rpx solid #ead4c9;border-radius:16rpx;background:#fff8f4;color:#a86d52;font-size:24rpx}.correction-photos{display:flex;gap:12rpx;flex-wrap:wrap}.correction-photos>view{position:relative;width:150rpx;height:150rpx}.correction-photos image{width:100%;height:100%;border-radius:12rpx}.correction-photos text{position:absolute;right:0;top:0;padding:0 12rpx;background:#26384ccc;color:#fff;border-radius:0 12rpx 0 12rpx}.correction-audio{display:flex;align-items:center;gap:12rpx}.correction-audio audio{flex:1}.correction-audio text{color:#c46c51;font-size:23rpx}.correction-tip{color:#a16a50;font-size:23rpx}.correction-error{margin:12rpx 0;color:#c34232;font-size:23rpx}.correction-submit{width:100%;min-height:90rpx;margin-top:24rpx;border-radius:18rpx;background:#f47b60;color:#fff;font-size:29rpx}
/* AI 批改结果标识 */
.grade-ai-badge{position:absolute;z-index:3;top:18rpx;right:18rpx;padding:10rpx 18rpx;border:1rpx solid #ffffffbb;border-radius:36rpx;background:#287fae;color:#fff;font-size:21rpx;font-weight:700;box-shadow:0 4rpx 14rpx #214d6d55;pointer-events:none}
.grade-ai-note{margin:12rpx 0 8rpx;padding:16rpx 18rpx;border-radius:14rpx;background:#fff6e9;color:#9b713d;font-size:22rpx;line-height:1.55}
.result-photo>.grade-ai-note{margin:12rpx 0 4rpx}

.feedback-section{margin:20rpx 0;color:#7c8f9e;font-size:24rpx}.feedback-section button{margin:12rpx 0}.correction-sheet picker{padding:24rpx;margin-bottom:20rpx;border:1rpx solid #e6dcd5;border-radius:16rpx;background:#fffaf6}

.correction-feedback{background:#fff7e7;border-radius:18rpx;padding:20rpx;margin:16rpx 0;line-height:1.8}
