.parent.grade-page .single-question{margin:0 0 22rpx;padding:32rpx 30rpx 26rpx;border:1rpx solid #edd8c8;border-radius:36rpx;box-shadow:0 18rpx 44rpx #a66a3812;color:#3f2b20}
.single-heading{align-items:center;gap:20rpx}.single-title{display:flex;align-items:center;flex:1;min-width:0;gap:14rpx}.single-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#4f321f;font-size:32rpx;font-weight:700;line-height:1.45}
.single-bookmark{flex:none;min-height:72rpx;margin:0;padding:0 20rpx;border:1rpx solid #e5845d;border-radius:20rpx;background:#fffaf7;color:#b95836;font-size:22rpx;font-weight:700;line-height:72rpx}
.single-bookmark:after,.single-cta button:after{border:0}
.single-status{display:inline-flex;align-items:center;flex:none;width:max-content;margin:0;padding:7rpx 16rpx;border-radius:999rpx;background:#e8f6ee;color:#18734d;font-size:22rpx;font-weight:700;line-height:1.2}.single-status.wrong{background:#fff0ec;color:#c23832!important}
.single-original{margin:28rpx 0 0}.single-original-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:14rpx;color:#7d6553;font-size:22rpx;font-weight:650}.single-original-link{color:#c46640}.single-original-crop{position:relative;display:block;overflow:hidden;width:100%;aspect-ratio:2.08/1;border:1rpx solid #eedfd5;border-radius:24rpx;background:#f6f1ed;box-sizing:border-box}.single-original-crop image{position:absolute;display:block;max-width:none}.single-original-crop.full image{position:relative;width:100%!important;height:auto!important;left:0!important;top:0!important}.single-original-note{display:block;margin:10rpx 4rpx 0;color:#a08d80;font-size:20rpx}.single-original-empty{padding:36rpx;border:1rpx dashed #ead9cd;border-radius:24rpx;background:#fffaf7;color:#9d8a7c;text-align:center;font-size:22rpx}
.single-extracted{margin:28rpx 0 28rpx;padding:22rpx 24rpx;border-radius:24rpx;background:#fffaf7}.single-extracted-label{display:block;margin-bottom:10rpx;color:#a06a4f;font-size:20rpx;font-weight:650}.parent.grade-page .single-question .single-extracted .stem{margin:0;padding:0;color:#3f2b20;font-size:30rpx;font-weight:550;line-height:1.7}
.single-analysis{padding-top:24rpx;border-top:1rpx solid #f1e3d8}
.single-ai-notice{display:flex;align-items:flex-start;gap:16rpx;margin-bottom:10rpx;padding:18rpx 20rpx;border-radius:22rpx;background:linear-gradient(120deg,#fff5ee,#fff9f5);color:#7d6553;font-size:24rpx;font-weight:500;line-height:1.5}
.single-ai-notice text:first-child{display:inline-flex;align-items:center;flex:none;min-width:0;padding:0;border:0;color:#b95825;font-size:24rpx;font-weight:700;line-height:1.5;white-space:nowrap}.single-ai-notice text:last-child{flex:1;min-width:0}
.parent.grade-page .single-question .explanation{margin:0;padding:24rpx 0;border-color:#efddce}.parent.grade-page .single-question .explanation .row{color:#4f321f;font-size:28rpx;font-weight:700;min-height:52rpx}.parent.grade-page .single-question .explanation-text{margin-top:12rpx;padding-right:8rpx;color:#5e4a3d;font-size:26rpx;font-weight:500;line-height:1.72}
