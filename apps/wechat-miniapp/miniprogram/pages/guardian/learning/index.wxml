<view class="learning-page">
  <view class="learning-hero">
    <view class="learning-child-line"><view class="learning-child-identity"><view>{{studentName}}</view><view class="learning-child-class">· {{className}}</view></view><view wx:if="{{children.length > 1}}" class="learning-child-trigger" bindtap="toggleChildPicker">切换孩子 ⌄</view></view>

    <view class="learning-inline-periods"><button class="{{period === 'day' ? 'active' : ''}}" data-period="day" bindtap="changePeriod">今日</button><button class="{{period === '7d' ? 'active' : ''}}" data-period="7d" bindtap="changePeriod">近 7 天</button><button class="{{period === '30d' ? 'active' : ''}}" data-period="30d" bindtap="changePeriod">近 30 天</button></view>
  </view>
  <view class="learning-brief"><view class="learning-brief-label">{{summaryTitle}}</view><view>{{summaryLine}}</view></view>
  <view class="learning-section"><view class="learning-section-title">最近学习记录</view><view class="learning-section-note">{{timeline.length ? '点开查看内容与结果' : ''}}</view></view>
  <view wx:if="{{visibleTimeline.length}}" class="learning-card learning-timeline-card"><view wx:for="{{visibleTimeline}}" wx:key="id" class="learning-event" data-id="{{item.id}}" bindtap="openActivity"><view class="learning-event-top"><view class="learning-strong">{{item.subject}} · {{item.feature}}</view><view class="learning-time">{{item.minutes}} 分钟 ›</view></view><view class="learning-muted">{{item.date}} {{item.start}} · {{item.title}}</view><view class="learning-muted">{{item.status}}{{item.answers ? ' · 首次作答 ' + item.answers + ' 题' : ''}}</view></view></view>
  <view wx:else class="learning-empty">本期暂无学习活动记录。</view>
  <button wx:if="{{timeline.length > 3}}" class="learning-expand" bindtap="toggleTimeline">{{showAllTimeline ? '收起记录' : '查看最近 ' + timeline.length + ' 条记录'}} ›</button>
  <view class="learning-section"><view class="learning-section-title">学科情况</view></view>
  <view wx:if="{{subjects.length}}" class="learning-card"><view wx:for="{{subjects}}" wx:key="subject" class="learning-subject"><view><view class="learning-strong">{{item.subject}}</view><view class="learning-muted">{{item.count}} 条学习活动</view></view><view class="learning-subject-value">{{item.minutes}} 分钟</view></view></view>
  <view wx:else class="learning-empty">本期暂无可计入学习的活动。</view>
  <button class="learning-expand learning-feature-toggle" bindtap="toggleFeatures">{{featureOpen ? '收起功能使用' : '查看功能使用'}} ›</button>
  <view wx:if="{{featureOpen}}" class="learning-card"><view class="learning-subject"><view><view class="learning-strong">小晤问答</view><view class="learning-muted">仅计应用使用</view></view><view class="learning-subject-value">{{chatCount}} 次</view></view><view class="learning-subject"><view><view class="learning-strong">AI 解题</view><view class="learning-muted">{{solveProblems}} 道题 · {{solveCount}} 次解题</view></view><view class="learning-subject-value">{{solveQuestions}} 次问答</view></view></view>
  <view class="learning-business-nav"><view class="active">学习报告</view><view bindtap="openHomework">作业</view></view>
  <view class="learning-footnote">学习分钟仅按学伴学习活动统计，不含小晤问答和设备亮屏时间；一次订正答对不代表稳定掌握。</view>
  <view wx:if="{{selectedActivity}}" class="learning-detail-mask" bindtap="closeActivity"><view class="learning-detail" catchtap="noop"><view class="learning-detail-head"><view class="learning-strong">{{selectedActivity.activity.feature}} · 活动详情</view><view bindtap="closeActivity">关闭 ×</view></view><view class="learning-muted">{{selectedActivity.activity.subject}} · {{selectedActivity.activity.title}}</view><view class="learning-muted">{{selectedActivity.date}} {{selectedActivity.activity.start}} · {{selectedActivity.activity.minutes}} 分钟 · {{selectedActivity.activity.status}}</view><view class="learning-section-title learning-detail-title">原题与作答</view><view wx:if="{{selectedActivity.questions.length}}"><view wx:for="{{selectedActivity.questions}}" wx:key="id" class="learning-question"><view class="learning-strong">{{item.stem}}</view><view class="learning-muted">{{item.kind}}作答：{{item.answer}} · {{item.result}}</view><view class="learning-muted">参考答案：{{item.reference}} · {{item.scoring}}</view><view class="learning-muted">{{item.version}}</view></view></view><view wx:else class="learning-muted">本次活动没有关联逐题作答；仅展示实际发生的内容与时长。</view></view></view>

  <view wx:if="{{childPickerOpen}}" class="learning-child-modal-mask" bindtap="closeChildPicker"><view class="learning-child-modal" catchtap="stopChildDialogTap"><view class="learning-child-modal-head"><text>切换孩子</text><view bindtap="closeChildPicker">×</view></view><view class="learning-child-menu"><view wx:for="{{children}}" wx:key="id" class="learning-child-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeChild"><text class="learning-option-name">{{item.name}}</text><view class="learning-option-meta"><text>{{item.className}}</text><text class="learning-option-check">{{item.selected ? '✓' : ''}}</text></view></view></view><view class="learning-child-modal-cancel" bindtap="closeChildPicker">取消</view></view></view>
</view>
