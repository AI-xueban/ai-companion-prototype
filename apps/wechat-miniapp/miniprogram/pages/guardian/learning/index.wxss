p:8rpx;color:#8b9caf;font-size:22rpx;line-height:1.5}.learning-subject-value,.learning-time{color:#3188a7;font-weight:700;white-space:nowrap}.learning-event{padding:22rpx 0}.learning-event-top{display:flex;justify-content:space-between;gap:15rpx}.learning-tail{padding:16rpx 0;color:#a4b0bc;font-size:21rpx}.learning-homework{height:80rpx;line-height:80rpx;margin-top:36rpx;border-radius:17rpx;background:#e2f2f8;color:#267fa7;font-size:27rpx;font-weight:700}.learning-homework::after{border:0}.learning-footnote{margin-top:25rpx;color:#a0adba;font-size:21rpx;line-height:1.6}
.learning-hero{padding-top:24rpx;padding-bottom:22rpx}.learning-head-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:8rpx}.learning-title{margin:0;font-size:38rpx;line-height:1.25}.learning-period{flex:none;gap:4rpx;margin:0;padding:5rpx;border-radius:18rpx;background:#deedf5}.learning-period button{height:48rpx;line-height:48rpx;padding:0 13rpx;border-radius:13rpx;background:transparent;font-size:20rpx}.learning-period button.active{background:#fff;color:#267da7}.learning-date{margin:8rpx 0 0;font-size:20rpx}.learning-summary{gap:12rpx;margin-top:20rpx}.learning-primary,.learning-small{min-height:178rpx;padding:22rpx}.learning-primary{display:flex;flex-direction:column;justify-content:space-between}.learning-primary-value{margin:8rpx 0;font-size:40rpx;line-height:1.15}.learning-small{justify-content:space-around;padding:16rpx 18rpx}.learning-small>view{display:flex;align-items:baseline;justify-content:space-between;gap:7rpx}.learning-small>view+view{padding-top:10rpx;border-top:1rpx solid #edf1f5}.learning-small text{margin:0;font-size:33rpx}.learning-section{margin-top:28rpx;margin-bottom:14rpx}.learning-subject{padding:18rpx 0}
.learning-child-line{display:flex;align-items:center;justify-content:space-between;gap:10rpx}.learning-child-trigger{flex:none;color:#287fa8;font-size:22rpx;font-weight:700}.learning-child-menu{margin-top:12rpx;padding:6rpx;border-radius:15rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(35,59,85,.09)}.learning-child-option{padding:17rpx 14rpx;color:#526c83;font-size:23rpx}.learning-child-option+.learning-child-option{border-top:1rpx solid #edf1f5}.learning-child-option.active{color:#287fa8;font-weight:700}
.learning-days{margin-top:16rpx;white-space:nowrap}.learning-days-inner{display:flex;gap:10rpx}.learning-day{flex:none;padding:10rpx 18rpx;border-radius:24rpx;background:#fff;color:#638196;font-size:21rpx}.learning-day.active{background:#267da7;color:#fff}.learning-detail-mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;background:rgba(20,39,57,.45)}.learning-detail{width:100%;max-height:82vh;overflow-y:auto;padding:30rpx 28rpx 60rpx;border-radius:26rpx 26rpx 0 0;background:#fff}.learning-detail-head{display:flex;justify-content:space-between;gap:20rpx;color:#287fa8}.learning-detail-title{margin-top:32rpx}.learning-question{margin-top:20rpx;padding:22rpx;border-radius:17rpx;background:#f5f8fc}.learning-event{cursor:pointer}

.learning-page{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}
.learning-business-nav{position:fixed;left:0;right:0;bottom:0;z-index:8;display:flex;align-items:center;height:90rpx;padding:0 28rpx env(safe-area-inset-bottom);background:#fff;box-shadow:0 -5rpx 22rpx rgba(34,71,99,.08)}
.learning-business-nav view{flex:1;text-align:center;color:#7c92a5;font-size:26rpx;line-height:90rpx}
.learning-business-nav view.active{color:#287fa8;font-weight:700}
.learning-brief{margin-top:20rpx;padding:25rpx 28rpx;border-radius:22rpx;background:linear-gradient(135deg,#173e66,#1f6b81);color:#fff;font-size:29rpx;font-weight:600;line-height:1.55}
.learning-expand{margin:18rpx 0 0;padding:20rpx;width:100%;border:0;border-radius:16rpx;background:#e6f2f8;color:#287fa8;font-size:24rpx}.learning-expand::after{border:0}.learning-feature-toggle{margin-top:30rpx}
.learning-brief{display:block;padding:30rpx 32rpx;box-shadow:0 16rpx 30rpx rgba(24,74,105,.16);font-size:30rpx}
.learning-brief-label{margin-bottom:13rpx;color:#c2e2ed;font-size:21rpx;font-weight:500;letter-spacing:2rpx}
.learning-brief + .learning-section{margin-top:35rpx}
.learning-timeline-card{border-left:6rpx solid #71b4cc;padding-left:27rpx}
.learning-event-top .learning-strong{color:#24445e}
.learning-time{font-size:24rpx}
.learning-hero{padding-top:20rpx;padding-bottom:18rpx}
.learning-head-row{margin-top:12rpx}
.learning-head-row .learning-date{flex:1;min-width:0;margin:0;color:#7891a5;font-size:20rpx;line-height:1.4}
.learning-head-row .learning-period{flex:none}

/* 家长学习报告使用珊瑚橙作少量强调。 */
.learning-page{background:#fff;color:#193349}
.learning-hero{background:#fff;border-bottom:1rpx solid #f2e8e3}
.learning-eyebrow,.learning-head-row .learning-date{color:#657789}
.learning-period{background:#fff1e9}
.learning-period button.active{color:#df6749}
.learning-day.active{background:#ef795a;color:#fff}
.learning-primary{background:#fff7f3;border:1rpx solid #ffe3d8;color:#193349}
.learning-primary-label,.learning-primary-note{color:#b76852}
.learning-primary-value,.learning-small text,.learning-subject-value,.learning-time{color:#e77253}
.learning-brief{background:#fff7f3;border:1rpx solid #ffe3d8;box-shadow:none;color:#193349}
.learning-brief-label{color:#b76852}
.learning-timeline-card{border-left-color:#ef795a}
.learning-child-trigger,.learning-child-option.active,.learning-detail-head,.learning-business-nav view.active{color:#df6749}
.learning-expand,.learning-homework{background:#fff1e9;color:#dc6a4d}
.learning-question{background:#fff8f5}

.learning-child-line{min-height:50rpx;padding-bottom:24rpx;margin-bottom:16rpx;border-bottom:1rpx solid #f2e8e3}.learning-child-identity{font-size:30rpx;font-weight:700;color:#193349}.learning-child-class{margin-top:6rpx;font-size:22rpx;font-weight:400;color:#657789}

.learning-child-option{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.learning-option-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.learning-option-meta{display:flex;align-items:center;gap:16rpx;flex:none;white-space:nowrap;font-size:22rpx}.learning-option-check{width:24rpx;text-align:right}

.learning-child-identity{display:flex;align-items:center;gap:12rpx;min-width:0;white-space:nowrap;font-size:28rpx}.learning-child-identity>view:first-child{flex:none}.learning-child-class{margin-top:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.learning-child-trigger{flex:none;white-space:nowrap}

.learning-child-modal-mask{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:44rpx;background:rgba(23,44,70,.4)}.learning-child-modal{box-sizing:border-box;width:100%;max-width:680rpx;padding:32rpx;border-radius:32rpx;background:#fff}.learning-child-modal-head{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:700;color:#193349}.learning-child-modal-head>view{padding:0 10rpx;color:#8393a1;font-size:46rpx;font-weight:400}.learning-child-modal .learning-child-menu{margin-top:24rpx;max-height:45vh;overflow:auto;box-shadow:none;border:1rpx solid #f2e8e3;background:#fffaf7}.learning-child-modal-cancel{margin-top:24rpx;padding:20rpx;border-radius:18rpx;background:#fff4ef;color:#dc6a4d;text-align:center;font-size:26rpx}


.learning-inline-periods{display:flex;gap:8rpx;padding:8rpx;border-radius:22rpx;background:#fff4ef}.learning-inline-periods button{flex:1;min-width:0;margin:0;padding:16rpx 8rpx;border:0;border-radius:16rpx;background:transparent;color:#657789;font-size:24rpx;line-height:1.5}.learning-inline-periods button::after{border:0}.learning-inline-periods button.active{background:#fff;color:#dc6a4d;font-weight:700}

/* 报告中的说明与记录信息使用统一的可读辅助层级。 */
.learning-muted,.learning-date,.learning-section-note,.learning-tail,.learning-footnote{color:#647789;font-size:24rpx;font-weight:500;line-height:1.5}
