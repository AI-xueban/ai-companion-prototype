<view class="page">
  <view class="page-head"><view class="page-title">孩子学习</view><view class="page-desc">仅展示已通过绑定审核的学生信息与学习数据。</view></view>
  <view wx:if="{{children.length > 1}}" class="guardian-child-switch"><view class="section-label">切换孩子</view><view class="guardian-child-options"><view wx:for="{{children}}" wx:key="id" class="guardian-child-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeChild">{{item.name}}</view></view></view>
  <view class="section-label">已绑定学生</view>
  <view class="cell-list"><view class="cell"><view class="cell-main"><view class="cell-title">{{studentName}}</view><view class="cell-desc">{{schoolName}} · {{className}}</view></view></view></view>
  <view class="section-label">学习关注</view>
  <view class="cell-list">
    <view class="cell" bindtap="openHomework"><view class="cell-main"><view class="cell-title">作业与打卡</view><view class="cell-desc">{{homeworkOpenCount}} 项任务待完成 · 按要求逐项提交</view></view><view class="cell-arrow">›</view></view>
    <view class="cell" bindtap="openLearning"><view class="cell-main"><view class="cell-title">学习报告</view><view class="cell-desc">近 7 天学习 {{learnedDays}} 天 · {{learningMinutes}} 分钟</view></view><view class="cell-arrow">›</view></view>
  </view>
</view>
