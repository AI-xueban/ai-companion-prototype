<view class="parent-hw-page">
  <view class="parent-hw-head {{mode === 'list' ? 'parent-hw-head-compact' : ''}}"><view class="parent-hw-child-line"><view class="parent-hw-eyebrow">{{studentLabel}}</view><view wx:if="{{children.length > 1}}" class="parent-hw-child-trigger" bindtap="toggleChildPicker">切换孩子 ⌄</view></view><view wx:if="{{childPickerOpen}}" class="parent-hw-child-menu"><view wx:for="{{children}}" wx:key="id" class="parent-hw-child-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeChild">{{item.name}} · {{item.className}}{{item.selected ? ' ✓' : ''}}</view></view><view wx:if="{{mode !== 'list'}}" class="parent-hw-title">{{task.title}}</view></view>
  <view wx:if="{{mode === 'list'}}">
    <view class="parent-hw-section">待完成 · {{pendingTasks.length}}</view>
    <view wx:if="{{!tasks.length}}" class="parent-hw-empty">当前没有收到作业或打卡任务。</view>
    <view wx:elif="{{!pendingTasks.length}}" class="parent-hw-empty">当前没有待完成任务，可在下方回看已交记录。</view>
    <view wx:for="{{pendingTasks}}" wx:key="id" class="parent-hw-card parent-hw-{{item.statusTone}}" data-id="{{item.id}}" bindtap="openTask"><view class="parent-hw-row"><view class="parent-hw-name">{{item.title}}</view><view class="parent-hw-badge {{item.statusTone}}">{{item.status}}</view></view><view class="parent-hw-muted">{{item.kindLabel}} · 截止 {{item.deadline}}</view><view class="parent-hw-row parent-hw-progress"><view>已完成 {{item.progress}}</view><view class="todo">继续完成 ›</view></view></view>
    <view wx:if="{{completedTasks.length}}" class="parent-hw-completed-head" bindtap="toggleCompleted">已完成 · {{completedTasks.length}} 项 <text>{{completedOpen ? '收起' : '展开查看'}} ›</text></view>
    <view wx:if="{{completedOpen}}"><view wx:for="{{completedTasks}}" wx:key="id" class="parent-hw-card parent-hw-done-card" data-id="{{item.id}}" bindtap="openTask"><view class="parent-hw-row"><view class="parent-hw-name">{{item.title}}</view><view class="parent-hw-badge done">已完成</view></view><view class="parent-hw-muted">{{item.kindLabel}} · 截止 {{item.deadline}}</view><view class="parent-hw-row parent-hw-progress"><view>已完成 {{item.progress}}</view><view class="done">查看记录 ›</view></view></view></view>
  </view>
  <view wx:else><view class="parent-hw-back" bindtap="backToList">‹ 返回作业</view><view class="parent-hw-card"><view class="parent-hw-row"><view class="parent-hw-name">已完成 {{progressLabel}}</view><view class="{{completed ? 'done' : 'todo'}}">{{completed ? '全部完成' : submissionClosed ? '仅供查看' : '待继续'}}</view></view><view wx:if="{{task.description}}" class="parent-hw-summary">{{task.description}}</view><image wx:if="{{task.materialPhoto}}" class="parent-hw-material" src="{{task.materialPhoto}}" mode="widthFix" /><view class="parent-hw-muted">原截止 {{task.deadline}} · 补交至 {{task.submitDeadline}}</view><view class="parent-hw-deadline-note">{{deadlineNotice}}</view></view>
    <view class="parent-hw-private-note">仅关联该学生的家长与有权限教师可查看提交内容。</view><view wx:if="{{uploadError}}" class="parent-hw-error"><view class="parent-hw-name">本次没有提交成功</view><view class="parent-hw-muted">{{uploadError}}</view><view class="parent-hw-error-action" bindtap="clearUploadError">知道了，重新选择</view></view><view class="parent-hw-demo-entry" bindtap="toggleDemoExceptions">演示提交异常 {{demoExceptionOpen ? '收起' : '展开'}} ›</view><view wx:if="{{demoExceptionOpen}}" class="parent-hw-demo-grid"><view data-type="format" bindtap="simulateUploadException">格式不支持</view><view data-type="size" bindtap="simulateUploadException">文件过大</view><view data-type="duration" bindtap="simulateUploadException">视频超时</view><view data-type="network" bindtap="simulateUploadException">网络中断</view></view>
    <view class="parent-hw-section">完成项目</view>
    <view wx:for="{{items}}" wx:key="id" class="parent-hw-card"><view class="parent-hw-row"><view class="parent-hw-name">{{index + 1}}. {{item.title}}</view><view class="parent-hw-badge">{{item.submitted ? '已完成' : item.submitLabel}}</view></view><view wx:if="{{item.instruction}}" class="parent-hw-summary">{{item.instruction}}</view><view wx:if="{{item.submitted}}" class="parent-hw-submitted">✓ {{item.submittedAt}} · 第 {{item.version}} 版 · {{item.late ? '补交 · ' : ''}}{{item.mediaLabel}}</view><image wx:if="{{item.submitted && item.submitType === 'photo' && item.mediaPath}}" class="parent-hw-material" src="{{item.mediaPath}}" mode="widthFix" /><video wx:if="{{item.submitted && item.submitType === 'video' && item.mediaPath}}" class="parent-hw-material" src="{{item.mediaPath}}" controls /><audio wx:if="{{item.submitted && item.submitType === 'audio' && item.mediaPath}}" src="{{item.mediaPath}}" controls />
      <view wx:if="{{item.questions.length}}" class="parent-hw-summary">模拟批改结果</view><view wx:for="{{item.questions}}" wx:for-item="question" wx:key="id" class="parent-hw-muted"><view>{{question.label}} · {{question.result}}</view><view>学生作答 {{question.studentAnswer}} · 标准答案 {{question.answer}}</view></view>
      <view wx:if="{{item.history.length > 1}}" class="parent-hw-summary">提交记录</view><view wx:for="{{item.history}}" wx:for-item="history" wx:key="version" class="parent-hw-muted">第 {{history.version}} 版 · {{history.submittedAt}} · {{history.late ? '补交 · ' : ''}}{{history.mediaLabel}}</view>
      <view wx:if="{{submissionClosed && !item.submitted}}" class="parent-hw-muted">补交期限已结束，当前项目不可再提交。</view>
      <view wx:elif="{{pendingUpload && pendingUpload.itemId === item.id}}" class="parent-hw-pending"><view class="parent-hw-name">请核对要提交的{{item.submitLabel}}</view><view class="parent-hw-muted">{{pendingUpload.name}}</view><view wx:if="{{item.submitted}}" class="parent-hw-replace-note">重新提交后，新文件将成为当前展示版本；此前版本仍可在提交记录中查看。</view><image wx:if="{{item.submitType === 'photo'}}" class="parent-hw-material" src="{{pendingUpload.path}}" mode="widthFix" /><video wx:if="{{item.submitType === 'video'}}" class="parent-hw-material" src="{{pendingUpload.path}}" controls /><audio wx:if="{{item.submitType === 'audio'}}" src="{{pendingUpload.path}}" controls /><button class="parent-hw-button" disabled="{{uploadState === 'saving'}}" bindtap="confirmUpload">{{uploadState === 'saving' ? '正在提交…' : item.submitted ? '确认重新提交' : '确认提交本项'}}</button><view class="parent-hw-cancel" bindtap="cancelUpload">取消选择</view></view>
      <button wx:elif="{{!submissionClosed && (item.submitType === 'photo' || item.submitType === 'video')}}" class="parent-hw-button" data-id="{{item.id}}" bindtap="chooseSubmissionMedia">{{item.submitted ? '重新提交' : item.submitLabel}}</button><button wx:elif="{{!submissionClosed && item.submitType === 'audio'}}" class="parent-hw-button" data-id="{{item.id}}" bindtap="chooseAudio">{{item.submitted ? '重新提交' : '上传录音'}}</button><button wx:elif="{{!submissionClosed && !item.submitted}}" class="parent-hw-button" data-id="{{item.id}}" bindtap="submitItem">确认已完成</button>
    </view>
  </view>
  <view wx:if="{{mode === 'list'}}" class="parent-hw-business-nav"><view bindtap="openLearning">学习报告</view><view class="active">作业</view></view>
</view>
