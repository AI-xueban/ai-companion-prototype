<view class="parent-hw-page {{mode === 'detail' ? 'parent-hw-detail-page' : ''}}">
  <view class="parent-hw-navigation"><view style="height:{{statusBarHeight}}px"></view><view class="parent-hw-nav-row" style="height:{{navBarHeight}}px"><view class="parent-hw-nav-back" bindtap="navigationBack" aria-label="返回">‹</view><view wx:if="{{mode === 'detail'}}" class="parent-hw-nav-home" bindtap="detailHome" aria-label="家长首页">⌂</view><view class="parent-hw-nav-title" style="left:{{capsuleSafeInset}}px;right:{{capsuleSafeInset}}px">作业</view></view></view>
  <view wx:if="{{mode === 'list'}}" class="parent-hw-head parent-hw-head-compact"><view class="parent-hw-child-line"><view class="parent-hw-child-identity"><view>{{studentName}}</view><view class="parent-hw-child-class">· {{className}}</view></view><view wx:if="{{children.length > 1}}" class="parent-hw-child-trigger" bindtap="toggleChildPicker">切换孩子 ⌄</view></view></view>

  <view wx:if="{{mode === 'list'}}" class="parent-hw-list">
    <view class="parent-hw-tabs"><view class="{{taskTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="changeTaskTab">待完成 <text>{{pendingTasks.length}}</text></view><view class="{{taskTab === 'completed' ? 'active' : ''}}" data-tab="completed" bindtap="changeTaskTab">已完成 <text>{{completedTasks.length}}</text></view><view class="{{taskTab === 'ended' ? 'active' : ''}}" data-tab="ended" bindtap="changeTaskTab">已结束 <text>{{endedTasks.length}}</text></view></view>
    <view class="parent-hw-task-panel" bindtouchstart="startTaskSwipe" bindtouchend="endTaskSwipe" bindtouchcancel="cancelTaskSwipe">
    <view wx:if="{{!visibleTasks.length}}" class="parent-hw-empty">暂无{{taskTab === 'pending' ? '待完成' : taskTab === 'completed' ? '已完成' : '已结束'}}任务。</view>
    <view wx:for="{{visibleTasks}}" wx:key="id" class="parent-hw-card parent-hw-{{item.statusTone}}" data-id="{{item.id}}" bindtap="openTask"><view class="parent-hw-row"><view class="parent-hw-task-title"><view class="parent-hw-tags"><text class="parent-hw-subject">{{item.subject}}</text><text class="parent-hw-kind {{item.kindLabel === '打卡' ? 'checkin' : 'homework'}}">{{item.kindLabel}}</text></view><view class="parent-hw-name">{{item.title}}</view></view><view class="parent-hw-badge {{item.statusTone}}">{{item.status}}</view></view><view class="parent-hw-muted">{{item.deadlineLabel}} {{item.deadline}}</view><view wx:if="{{item.itemTypes}}" class="parent-hw-item-types">{{item.itemTypes}}</view><view class="parent-hw-row parent-hw-progress"><view>已完成 {{item.progress}}</view><view class="todo">{{item.actionLabel}} ›</view></view></view>
    </view>
  </view>
  <view wx:else><view class="parent-hw-record-overview"><view class="parent-hw-record-overview-title"><text>{{task.title}}</text><text>{{task.subject || '综合'}}</text></view><view class="parent-hw-record-person"><text>{{studentName}}</text><text>{{className}}</text></view><view wx:if="{{submissionMetrics}}" class="parent-hw-record-metrics"><view><text>{{submissionMetrics.total}}</text><text>总题数</text></view><view><text>{{submissionMetrics.correct}}</text><text>答对</text></view><view><text>{{submissionMetrics.wrong}}</text><text>答错</text></view><view><text>{{submissionMetrics.unavailable}}</text><text>待处理</text></view></view></view><view class="parent-hw-task-details" bindtap="toggleDescription">作业要求与截止时间 {{descriptionExpanded ? '⌃' : '⌄'}}</view><view wx:if="{{descriptionExpanded}}" class="parent-hw-card"><view>正常截止 {{task.deadline}}</view><view>补交至 {{task.submitDeadline}}</view><view wx:if="{{deadlineNotice}}">{{deadlineNotice}}</view><view>{{task.description}}</view></view>
    <view wx:if="{{task.changes.length}}" class="parent-hw-card"><view>老师已更新任务</view><view wx:for="{{changeRows}}" wx:key="at"><view>{{item.at}} · {{item.label}} · {{item.reason}}</view><view class="parent-hw-muted">变更前 {{item.beforeText}}</view><view class="parent-hw-muted">变更后 {{item.afterText}}</view></view></view>
    <view wx:if="{{task.attachments && task.attachments.length}}" class="parent-hw-card parent-hw-detail-attachments"><view class="parent-hw-name">附件 · {{task.attachments.length}}</view><task-attachments items="{{task.attachments}}" /></view><image wx:if="{{task.materialPhoto && (!task.attachments || !task.attachments.length)}}" class="parent-hw-material" src="{{task.materialPhoto}}" mode="widthFix" />
    <view wx:if="{{uploadError}}" class="parent-hw-error"><view class="parent-hw-name">本次没有提交成功</view><view class="parent-hw-muted">{{uploadError}}</view><view class="parent-hw-error-action" bindtap="clearUploadError">知道了，重新选择</view></view>

    <view wx:for="{{items}}" wx:key="id" class="parent-hw-card parent-hw-item-card"><view class="parent-hw-item-head"><text class="parent-hw-item-number">{{item.displayIndex}}</text><view class="parent-hw-item-title">{{item.title}}</view><view class="parent-hw-item-badges"><text class="parent-hw-badge {{item.statusLabel === '已提交' || item.statusLabel === '已批改' ? 'done' : 'pending'}}">{{item.statusLabel}}</text><text class="parent-hw-badge">{{item.submitType === 'none' ? '家长确认' : item.submitType === 'photo' ? '照片' : item.submitType === 'file' ? '文件' : item.submitType === 'video' ? '视频' : '录音'}}</text></view></view><view wx:if="{{item.instruction && item.instruction !== '拍摄清晰完整的答题页' && item.instruction !== '按上述要求完成' && item.instruction !== '按要求完成' && item.instruction !== '按任务要求完成'}}" class="parent-hw-item-instruction">{{item.instruction}}</view><view wx:if="{{item.submitted && item.submitType !== 'file'}}" class="parent-hw-submitted">{{item.submitType === 'none' ? '已确认' : '已提交'}} · {{item.submittedAt}}{{item.late ? ' · 补交' : ''}}</view><block wx:if="{{item.submitted && item.submitType === 'photo'}}"><view wx:if="{{item.displayPhotos.length}}" class="parent-hw-record-photo-tools"><text>共 {{item.displayPhotos.length}} 张</text><view wx:if="{{item.hasGradedImages}}" class="parent-hw-record-image-tabs"><button class="{{!item.viewOriginal ? 'active' : ''}}" data-item="{{item.id}}" data-view="graded" catchtap="switchSubmissionImage">批改图</button><button class="{{item.viewOriginal ? 'active' : ''}}" data-item="{{item.id}}" data-view="original" catchtap="switchSubmissionImage">原图</button></view></view><view wx:for="{{item.displayPhotos}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="page"><image class="parent-hw-material" wx:if="{{photo.path}}" src="{{photo.path}}" mode="widthFix" data-item="{{item.id}}" data-page="{{photoIndex}}" binderror="submissionImageError" bindtap="previewSubmissionPhoto" /><view class="parent-hw-record-caption" data-item="{{item.id}}" data-page="{{photoIndex}}" bindtap="previewSubmissionPhoto">{{photoIndex+1}} / {{item.displayPhotos.length}} · 点击放大查看</view><view wx:if="{{photo.imageError}}" class="parent-hw-image-error">{{photo.imageError}}</view><view wx:if="{{item.hasGradedImages && !item.viewOriginal && !photo.gradedPath}}" class="parent-hw-muted">此照片暂无批改图，显示原图</view></view><view wx:if="{{item.noGradedImage}}" class="parent-hw-muted">暂无可展示的批改图，当前为原图</view></block><view wx:if="{{item.gradeStatus && item.statusLabel !== '已批改'}}" class="parent-hw-grade-status">{{item.gradeStatus}}</view><video wx:if="{{item.submitted && item.submitType === 'video' && item.mediaPath}}" class="parent-hw-material" src="{{item.mediaPath}}" controls /><audio wx:if="{{item.submitted && item.submitType === 'audio' && item.mediaPath}}" src="{{item.mediaPath}}" controls /><view wx:if="{{item.submitted && item.submitType === 'file' && item.mediaPath}}" class="parent-hw-file" data-path="{{item.mediaPath}}" bindtap="openSubmittedFile"><view class="parent-hw-file-icon {{item.fileIconKind}}"><view class="parent-hw-file-icon-mark">{{item.fileIconMark}}</view></view><view class="parent-hw-file-info"><view class="parent-hw-file-name">{{item.mediaLabel}}</view><view class="parent-hw-file-meta">已提交 · {{item.submittedAt}}</view></view><text class="parent-hw-file-action">查看文件 ›</text></view>

      <view wx:if="{{item.history.length > 1}}" class="parent-hw-history"><button class="parent-hw-history-toggle" data-id="{{item.id}}" bindtap="toggleSubmissionHistory">提交记录 · {{item.history.length}} 次 {{item.historyOpen ? '⌃' : '⌄'}}</button><view wx:if="{{item.historyOpen}}"><view wx:for="{{item.history}}" wx:for-item="history" wx:key="version" class="parent-hw-history-row"><view>第 {{history.version}} 次提交</view><view>{{history.submittedAt}}</view><view>提交人：{{history.operator}}</view></view></view></view>
      <button wx:if="{{item.canRetryGrading}}" data-id="{{item.id}}" bindtap="retryGrading">重试批改</button><view class="parent-hw-muted">{{item.formatHint}}</view><view wx:if="{{submissionClosed && !item.submitted}}" class="parent-hw-muted">补交期限已结束，当前项目不可再提交。</view>
      <button wx:elif="{{item.hasPending && (!pendingUpload || pendingUpload.itemId !== item.id)}}" data-id="{{item.id}}" bindtap="resumePending">继续尚未提交的内容</button><view wx:elif="{{pendingUpload && pendingUpload.itemId === item.id && pendingUpload.photos}}" class="parent-hw-pending parent-hw-photo-selection parent-hw-compact-photos"><view class="parent-hw-photo-selection-head"><view class="parent-hw-photo-caption">待提交 · {{pendingUpload.photos.length}} 张</view><button wx:if="{{pendingUpload.photos.length < 9}}" class="parent-hw-photo-add" data-id="{{item.id}}" disabled="{{photoSaving || uploadState === 'saving'}}" bindtap="chooseSubmissionMedia"><text>＋</text>添加照片</button></view><view class="parent-hw-photo-grid"><view wx:for="{{pendingUpload.photos}}" wx:for-item="photo" wx:key="path" class="parent-hw-photo-cell"><view class="parent-hw-photo-thumb"><image src="{{photo.path}}" mode="aspectFit" data-path="{{photo.path}}" bindtap="previewPendingPhoto" /><button class="parent-hw-photo-delete" aria-label="移除第 {{index+1}} 张照片" disabled="{{photoSaving || uploadState === 'saving'}}" data-index="{{index}}" bindtap="removePendingPhoto">×</button><text wx:if="{{pendingUpload.photos.length > 1}}" class="parent-hw-photo-index">{{index+1}}</text></view><view wx:if="{{photo.error}}" class="parent-hw-photo-failure">{{photo.error}}<button disabled="{{photoSaving || uploadState === 'saving'}}" data-index="{{index}}" bindtap="retryPendingPhoto">重试本张</button></view></view></view><view wx:if="{{item.submitted}}">提交后更新当前版本，历史记录保留。</view><view class="parent-hw-photo-submit-actions"><button class="parent-hw-button" disabled="{{photoSaving || uploadState === 'saving' || !pendingUpload.photos.length}}" bindtap="confirmUpload">{{photoSaving ? '正在暂存…' : uploadState === 'saving' ? '正在提交…' : '提交'}}</button></view><button wx:if="{{versionConflict}}" data-mode="merge" bindtap="resolveVersionConflict">查看并合并最新照片</button><button wx:if="{{versionConflict}}" data-mode="replace" bindtap="resolveVersionConflict">核对后替换最新版本</button></view>

      <view wx:elif="{{pendingUpload && pendingUpload.itemId === item.id}}" class="parent-hw-pending parent-hw-single-selection"><view class="parent-hw-name">待提交</view><view class="parent-hw-muted">{{pendingUpload.name}}</view><view wx:if="{{item.submitted}}" class="parent-hw-replace-note">重新提交后，新文件将成为当前展示版本；此前版本仍可在提交记录中查看。</view><image wx:if="{{item.submitType === 'photo'}}" class="parent-hw-material" src="{{pendingUpload.path}}" mode="widthFix" /><video wx:if="{{item.submitType === 'video'}}" class="parent-hw-material" src="{{pendingUpload.path}}" controls /><audio wx:if="{{item.submitType === 'audio'}}" src="{{pendingUpload.path}}" controls /><view class="parent-hw-single-submit-actions"><button class="parent-hw-single-reselect" disabled="{{uploadState === 'saving'}}" data-id="{{item.id}}" bindtap="reselectPendingUpload">重新选择</button><button wx:if="{{versionConflict}}" class="parent-hw-button" data-mode="replace" bindtap="resolveVersionConflict">使用当前文件</button><button wx:else class="parent-hw-button" disabled="{{uploadState === 'saving'}}" bindtap="confirmUpload">{{uploadState === 'saving' ? '正在提交…' : item.submitted ? '确认重新提交' : '提交本项'}}</button></view></view>
      <view wx:elif="{{!submissionClosed && (item.submitType === 'photo' || item.submitType === 'video')}}"><button class="parent-hw-button {{item.submitted ? 'parent-hw-resubmit' : ''}}" data-id="{{item.id}}" bindtap="chooseSubmissionMedia">{{item.submitted ? item.submitType === 'photo' ? '重新提交整项' : '重新提交' : item.submitLabel}}</button><button wx:if="{{item.submitted && item.submitType === 'photo'}}" class="parent-hw-button parent-hw-resubmit" data-id="{{item.id}}" bindtap="appendPhotos">补充照片</button><button wx:if="{{item.demoAnswerPath}}" class="parent-hw-button parent-hw-resubmit" data-id="{{item.id}}" bindtap="useWorksheetDemoAnswer">填入对应学生已作答页</button></view><button wx:elif="{{!submissionClosed && item.submitType === 'file'}}" class="parent-hw-button {{item.submitted ? 'parent-hw-resubmit' : ''}}" data-id="{{item.id}}" bindtap="chooseSubmissionFile">{{item.submitted ? '重新提交' : '上传文件'}}</button><button wx:elif="{{!submissionClosed && item.submitType === 'audio'}}" class="parent-hw-button {{item.submitted ? 'parent-hw-resubmit' : ''}}" data-id="{{item.id}}" bindtap="chooseAudio">{{item.submitted ? '重新提交' : '上传录音'}}</button><button wx:elif="{{!submissionClosed && !item.submitted}}" class="parent-hw-button" data-id="{{item.id}}" bindtap="submitItem">确认已完成</button>
    </view>
  </view>
  <view wx:if="{{mode === 'list'}}" class="parent-hw-business-nav"><view bindtap="openLearning">学习报告</view><view class="active">作业</view></view>

  <view wx:if="{{childPickerOpen}}" class="parent-hw-child-modal-mask" bindtap="closeChildPicker"><view class="parent-hw-child-modal" catchtap="stopChildDialogTap"><view class="parent-hw-child-modal-head"><text>切换孩子</text><view bindtap="closeChildPicker">×</view></view><view class="parent-hw-child-menu"><view wx:for="{{children}}" wx:key="id" class="parent-hw-child-option {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeChild"><text class="parent-hw-option-name">{{item.name}}</text><view class="parent-hw-option-meta"><text>{{item.className}}</text><text class="parent-hw-option-check">{{item.selected ? '✓' : ''}}</text></view></view></view><view class="parent-hw-child-modal-cancel" bindtap="closeChildPicker">取消</view></view></view>

</view>

<view wx:if="{{submissionPreviewOpen}}" class="parent-hw-result-preview"><view class="parent-hw-result-preview-head"><text>{{submissionPreviewPages[submissionPreviewIndex].showOriginal ? '原图' : '批改图'}}</text><button wx:if="{{submissionPreviewPages[submissionPreviewIndex].gradedPath}}" bindtap="toggleSubmissionPreview">{{submissionPreviewPages[submissionPreviewIndex].showOriginal ? '查看批改图' : '查看原图'}}</button><button bindtap="closeSubmissionPreview">关闭 ×</button></view><swiper current="{{submissionPreviewIndex}}" bindchange="changeSubmissionPreview" class="parent-hw-result-preview-swiper"><swiper-item wx:for="{{submissionPreviewPages}}" wx:key="page"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFit" data-page="{{index}}" binderror="submissionPreviewError" bindtap="zoomSubmissionPreview" /><view wx:if="{{item.imageError}}" class="parent-hw-image-error" role="status">{{item.imageError}}</view></swiper-item></swiper><view class="parent-hw-result-preview-footer">{{submissionPreviewIndex+1}} / {{submissionPreviewPages.length}}<button bindtap="zoomSubmissionPreview">放大查看</button></view></view>
