.cl-learning{color:#23455d}.cl-card{background:#fff;border:1px solid #dce8f1;border-radius:15px;padding:14px;margin:0 0 12px}.cl-head{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:22px;margin-bottom:8px}.cl-title{font-size:14px;font-weight:700;border-left:3px solid #169ce8;padding-left:9px}.cl-head button{background:none;color:#0786c5;border:0;padding:0;margin:0;font-size:11px;line-height:24px}.cl-summary{display:flex;align-items:center;justify-content:space-between;gap:3px;width:100%;padding:0;min-height:42px;background:none;border:0;color:#67879c;font-size:11px;text-align:left;white-space:nowrap;margin:0}.cl-summary>view{display:flex;align-items:baseline;gap:2px}.cl-num{font-size:16px;font-weight:700;color:#0787c8}.cl-period{display:flex;align-items:center;justify-content:space-between;gap:5px;font-size:11px;color:#7f97aa;margin:12px 0}.cl-period-controls{display:flex;background:#eaf2f8;border-radius:8px;padding:3px}.cl-period button{margin:0;padding:4px 7px;font-size:11px;line-height:20px;color:#829bb0;background:none;border:0;border-radius:6px}.cl-period button.active{background:#fff;color:#0785c6;font-weight:700}.cl-snapshot{font-size:10px;color:#89a0b0;margin:0 0 12px}.cl-row{display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;width:100%;box-sizing:border-box;background:none;border:0;border-top:1px solid #e6eef4;padding:16px 0;margin:0;font-size:12px;line-height:1.7;color:#284d68}.cl-row-title{font-size:13px;font-weight:650}.cl-row-detail{display:block;color:#8299ab;font-size:11px;margin-top:5px;white-space:pre-wrap}.cl-value{font-size:11px;color:#2389c2;flex-shrink:0;max-width:48%;text-align:right}.cl-text{font-size:13px;line-height:1.9;white-space:pre-wrap;margin:8px 0}.cl-muted{font-size:11px;line-height:1.8;white-space:pre-wrap;color:#8aa0b0;margin:8px 0 0}.cl-footer .cl-row{font-size:11px;border:0;color:#7896ab}.cl-footer .cl-row-title{font-size:11px;font-weight:400}.cl-states{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.cl-state{width:calc(50% - 4px);box-sizing:border-box;padding:11px;background:#f1f6fa;border:1px solid transparent;border-radius:9px;margin:0;text-align:left;font-size:11px;color:#7d95a6}.cl-state-num{display:block;font-size:24px;color:#487b9d;font-weight:700}.cl-state.active{border-color:#6ab4df}.cl-state.follow{background:#fff6e7}.cl-state.fixed{background:#edf8f3}.cl-state.pending{background:#eff6ff}.cl-filters{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}.cl-filters button{font-size:11px;padding:5px 8px;margin:0;border:1px solid #dbe8f1;border-radius:6px;line-height:20px;background:#fff;color:#7a93a6}.cl-filters .active{color:#0785c6;border-color:#77bce2;background:#eff8fd}.cl-search{box-sizing:border-box;width:100%;padding:10px 11px;height:40px;background:#fff;border:1px solid #dbe7f0;border-radius:8px;font-size:12px;margin:10px 0}.cl-value.follow{color:#ac813f}.cl-value.fixed{color:#349875}.cl-class-tabs{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:10px 0}.cl-class-tabs button{margin:0 10px 0 0;padding:8px 0;font-size:12px;background:none;border-radius:0;border-bottom:2px solid transparent;line-height:22px;color:#274b68}.cl-class-tabs button.active{border-color:#0b94d8;color:#0784c4}.cl-class-options{display:flex;overflow:auto}.cl-class-tabs picker{font-size:12px;color:#0784c4;background:#eaf6fd;padding:9px;border-radius:8px}.cl-head button::after,.cl-summary::after,.cl-row::after,.cl-period button::after,.cl-state::after,.cl-filters button::after,.cl-class-tabs button::after{border:0}

/* A2-A5: compact dates, peer entries, complete-week navigation. Teacher learning only. */
.cl-learning .cl-period{gap:8px;flex-wrap:wrap}.cl-learning .cl-period>span,.cl-learning .cl-period>text{white-space:nowrap}.cl-learning .cl-period>div:empty,.cl-learning .cl-period-controls:empty{display:none}.cl-learning .cl-period button{white-space:nowrap}
.cl-learning .cl-entries{display:flex;gap:12px;padding:0;border:0;background:none}.cl-learning .cl-entries>.cl-row{width:calc(50% - 6px);padding:14px 12px;background:#fff;border:1px solid #dce8f1;border-radius:14px;align-items:flex-start}.cl-learning .cl-entries .cl-row-title,.cl-learning .cl-entries strong{font-size:13px;font-weight:700}.cl-learning .cl-entries small,.cl-learning .cl-entries .cl-row-detail{font-size:10px}
.cl-week{display:flex;align-items:center;justify-content:space-between;background:#edf6fc;border:1px solid #dbeaf5;border-radius:12px;padding:10px;margin:12px 0}.cl-week button{background:none;color:#0788ca;border:0;font-size:24px;padding:0 14px;margin:0;line-height:32px}.cl-week button:disabled,.cl-week button[disabled]{opacity:.3}.cl-week button::after{border:0}.cl-week strong,.cl-week>text{font-size:14px;font-weight:700}.cl-learning .cl-row>view:first-child{min-width:0}
