# Google Gemini（部分功能如每日计划仍使用 mock / Gemini）
GEMINI_API_KEY=your_gemini_key

# 阿里云百炼 / DashScope 千问（前端通过 Vite 开发代理调用，密钥不会暴露到浏览器）
# 获取方式：https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 可选：自定义网关（默认与 ~/.bailian/config.json 中 base_url 一致）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_MODEL=qwen-plus

# 演示跳转控制器仅建议在开发环境使用；生产构建默认关闭
VITE_ENABLE_DEMO_CONTROLS=false
